<header
  class="h-16 bg-white border-b border-gray-200 flex items-center justify-between px-5 lg:px-8 sticky top-0 z-30"
>
  <div>
    <button
      type="button"
      @click="mobileMenuOpen = true"
      class="lg:hidden text-gray-500"
    >
      <i data-lucide="menu"></i>
    </button>

    <div class="hidden lg:block">
      <h1 class="text-lg font-semibold text-gray-900">Administration</h1>

      <p class="text-xs text-gray-500">First Credit Merchant</p>
    </div>
  </div>

  <div class="flex items-center space-x-4">
    <!-- Customer Search -->
    <div class="hidden md:block relative">
      <i
        data-lucide="search"
        class="h-4 w-4 text-gray-400 absolute left-3 top-1/2 -translate-y-1/2"
      ></i>

      <input
        type="search"
        placeholder="Search customers..."
        class="w-64 pl-9 pr-4 py-2 text-sm bg-gray-50 border border-gray-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500"
      />
    </div>

    <!-- Notifications -->
    <button
      type="button"
      class="relative p-2 text-gray-500 hover:bg-gray-100 rounded-lg"
    >
      <i data-lucide="bell" class="h-5 w-5"></i>

      <span
        class="absolute top-1 right-1 h-2 w-2 bg-red-500 rounded-full"
      ></span>
    </button>

    <!-- Admin -->
    <div class="flex items-center">
      <div
        class="h-9 w-9 rounded-full bg-primary-100 flex items-center justify-center"
      >
        <i data-lucide="shield" class="h-4 w-4 text-primary-700"></i>
      </div>

      <div class="hidden sm:block ml-3">
        <p class="text-sm font-medium text-gray-900">Administrator</p>

        <p class="text-xs text-gray-500">Full Access</p>
      </div>
    </div>
  </div>
</header>
