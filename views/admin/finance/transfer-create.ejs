<%
    const customerRecords =
        typeof customers !== "undefined" &&
        Array.isArray(customers)
            ? customers
            : [];

    const selectedId =
        typeof selectedCustomerId !== "undefined"
            ? selectedCustomerId
            : null;
%>

<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head") %>
</head>

<body class="bg-gray-50">

    <div
        x-data="{ mobileMenuOpen: false, transferType: '' }"
        class="flex h-screen overflow-hidden"
    >

        <%- include("../partials/sidebar") %>

        <div class="flex flex-col flex-1 overflow-hidden">

            <%- include("../partials/topbar") %>
            <%- include("../partials/mobile-menu") %>

            <main class="flex-1 overflow-y-auto">

                <div class="py-6">

                    <div
                        class="max-w-5xl mx-auto
                               px-4 sm:px-6 lg:px-8"
                    >

                        <a
                            href="/admin/transfers"
                            class="inline-flex items-center
                                   text-sm text-gray-500 mb-6"
                        >
                            <i
                                data-lucide="arrow-left"
                                class="h-4 w-4 mr-2"
                            ></i>

                            Back to Transfers
                        </a>


                        <div class="mb-6">
                            <h1 class="text-2xl font-bold text-gray-900">
                                Create Transfer
                            </h1>
                        </div>


                        <div
                            class="bg-white border border-gray-100
                                   rounded-xl shadow-sm overflow-hidden"
                        >

                            <form class="p-6">

                                <div
                                    class="grid grid-cols-1
                                           md:grid-cols-2 gap-5"
                                >

                                    <div>
                                        <label class="admin-label">
                                            Customer
                                        </label>

                                        <select class="admin-input">
                                            <option value="">
                                                Select customer
                                            </option>

                                            <% customerRecords.forEach(
                                                function(customer) {
                                            %>
                                                <% if (customer.id) { %>
                                                    <option
                                                        value="<%= customer.id %>"
                                                        <%= String(customer.id) === String(selectedId)
                                                            ? "selected"
                                                            : ""
                                                        %>
                                                    >
                                                        <%= customer.fullName || customer.customerId || customer.id %>
                                                    </option>
                                                <% } %>
                                            <% }); %>
                                        </select>
                                    </div>


                                    <div>
                                        <label class="admin-label">
                                            Transfer Type
                                        </label>

                                        <select
                                            x-model="transferType"
                                            class="admin-input"
                                        >
                                            <option value="">
                                                Select transfer type
                                            </option>
                                            <option value="Local">
                                                Local
                                            </option>
                                            <option value="International">
                                                International
                                            </option>
                                        </select>
                                    </div>


                                    <div>
                                        <label class="admin-label">
                                            Recipient Name
                                        </label>

                                        <input
                                            type="text"
                                            class="admin-input"
                                        >
                                    </div>


                                    <div>
                                        <label class="admin-label">
                                            Recipient Account
                                        </label>

                                        <input
                                            type="text"
                                            class="admin-input"
                                        >
                                    </div>


                                    <div>
                                        <label class="admin-label">
                                            Recipient Bank
                                        </label>

                                        <input
                                            type="text"
                                            class="admin-input"
                                        >
                                    </div>


                                    <div
                                        x-show="transferType === 'Local'"
                                        x-cloak
                                    >
                                        <label class="admin-label">
                                            Routing Number
                                        </label>

                                        <input
                                            type="text"
                                            class="admin-input"
                                        >
                                    </div>


                                    <div
                                        x-show="
                                            transferType ===
                                                'International'
                                        "
                                        x-cloak
                                    >
                                        <label class="admin-label">
                                            SWIFT / BIC
                                        </label>

                                        <input
                                            type="text"
                                            class="admin-input"
                                        >
                                    </div>


                                    <div>
                                        <label class="admin-label">
                                            Amount
                                        </label>

                                        <input
                                            type="number"
                                            min="0"
                                            step="0.01"
                                            class="admin-input"
                                        >
                                    </div>


                                    <div>
                                        <label class="admin-label">
                                            Currency
                                        </label>

                                        <select class="admin-input">
                                            <option value="">
                                                Select currency
                                            </option>
                                            <option>USD</option>
                                            <option>GBP</option>
                                            <option>EUR</option>
                                        </select>
                                    </div>


                                    <div>
                                        <label class="admin-label">
                                            Status
                                        </label>

                                        <select class="admin-input">
                                            <option value="">
                                                Select status
                                            </option>
                                            <option>Pending</option>
                                            <option>Processing</option>
                                            <option>Completed</option>
                                            <option>Failed</option>
                                            <option>Rejected</option>
                                            <option>Cancelled</option>
                                        </select>
                                    </div>

                                </div>


                                <div class="mt-6">
                                    <label class="admin-label">
                                        Description
                                    </label>

                                    <textarea
                                        rows="4"
                                        class="admin-input resize-none"
                                    ></textarea>
                                </div>


                                <div class="flex justify-end gap-3 mt-7">
                                    <a
                                        href="/admin/transfers"
                                        class="inline-flex
                                               px-5 py-3
                                               border border-gray-200
                                               rounded-lg"
                                    >
                                        Cancel
                                    </a>

                                    <button
                                        type="button"
                                        disabled
                                        class="inline-flex
                                               px-6 py-3
                                               bg-primary-600
                                               text-white rounded-lg
                                               opacity-50
                                               cursor-not-allowed"
                                    >
                                        Create Transfer
                                    </button>
                                </div>

                            </form>

                        </div>

                    </div>

                </div>

            </main>

        </div>

    </div>

    <%- include("../partials/scripts") %>

</body>

</html>