<%
    const ticketRecord =
        typeof ticket !== "undefined"
            ? ticket
            : null;

    const messages =
        ticketRecord &&
        Array.isArray(ticketRecord.messages)
            ? ticketRecord.messages
            : [];

    const ticketCustomer =
        typeof customer !== "undefined" &&
        customer
            ? customer
            : (
                ticketRecord &&
                ticketRecord.customer
                    ? ticketRecord.customer
                    : null
            );

    const ticketAccount =
        typeof account !== "undefined"
            ? account
            : null;
%>

<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head") %>
</head>

<body class="bg-gray-50">

    <%- include("../partials/loader") %>

    <div
        x-data="{ mobileMenuOpen: false }"
        class="admin-app-shell flex h-screen overflow-hidden"
    >

        <%- include("../partials/sidebar") %>

        <div class="admin-main-column flex flex-col flex-1 overflow-hidden">

            <%- include("../partials/topbar") %>
            <%- include("../partials/mobile-menu") %>

            <main class="admin-main-content">

                <div class="py-6">

                    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">

                        <a
                            href="/admin/support"
                            class="inline-flex items-center
                                   text-sm text-gray-500 mb-6"
                        >
                            <i data-lucide="arrow-left" class="h-4 w-4 mr-2"></i>
                            Back to Support
                        </a>

                        <% if (
                            typeof replied !== "undefined" &&
                            replied
                        ) { %>

                            <div
                                class="mb-6 p-4
                                       bg-green-50 border
                                       border-green-200 rounded-lg"
                            >
                                <p class="text-sm text-green-800">
                                    Reply sent successfully.
                                </p>
                            </div>

                        <% } %>

                        <% if (
                            typeof updated !== "undefined" &&
                            updated
                        ) { %>

                            <div
                                class="mb-6 p-4
                                       bg-green-50 border
                                       border-green-200 rounded-lg"
                            >
                                <p class="text-sm text-green-800">
                                    Ticket status updated successfully.
                                </p>
                            </div>

                        <% } %>

                        <% if (!ticketRecord) { %>

                            <section class="admin-panel">
                                <div class="py-16 text-center">
                                    <h1 class="text-xl font-semibold">
                                        Support ticket unavailable
                                    </h1>
                                </div>
                            </section>

                        <% } else { %>

                            <div
                                class="flex flex-col sm:flex-row
                                       sm:items-start sm:justify-between
                                       gap-4 mb-6"
                            >

                                <div>

                                    <h1 class="text-2xl font-bold text-gray-900">
                                        <%= ticketRecord.subject || "Support Ticket" %>
                                    </h1>

                                    <p class="text-sm text-gray-500 mt-1">
                                        <%= ticketRecord.reference || "" %>
                                    </p>

                                </div>

                                <span
                                    class="admin-badge
                                           <%= ticketRecord.status === "Open"
                                               ? "bg-blue-50 text-blue-700"
                                               : ticketRecord.status === "In Progress"
                                               ? "bg-yellow-50 text-yellow-700"
                                               : ticketRecord.status === "Resolved"
                                               ? "bg-green-50 text-green-700"
                                               : "bg-gray-100 text-gray-700"
                                           %>"
                                >
                                    <%= ticketRecord.status || "" %>
                                </span>

                            </div>

                            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                                <section class="admin-panel lg:col-span-2">

                                    <div class="admin-panel-header">
                                        <h2>Conversation</h2>
                                    </div>

                                    <div class="p-6">

                                        <% if (!messages.length) { %>

                                            <div class="py-10 text-center text-sm text-gray-500">
                                                No messages available
                                            </div>

                                        <% } else { %>

                                            <div class="space-y-4 mb-6">

                                                <% messages.forEach(function(message) {
                                                    const fromAdmin =
                                                        message.senderType ===
                                                        "Admin";
                                                %>

                                                    <div
                                                        class="flex
                                                               <%= fromAdmin
                                                                   ? "justify-end"
                                                                   : "justify-start"
                                                               %>"
                                                    >

                                                        <div
                                                            class="max-w-[88%]
                                                                   p-4 rounded-xl
                                                                   <%= fromAdmin
                                                                       ? "bg-primary-50 border border-primary-100"
                                                                       : "bg-gray-50 border border-gray-100"
                                                                   %>"
                                                        >

                                                            <p class="text-xs font-semibold text-gray-700">
                                                                <%= message.authorLabel ||
                                                                    (
                                                                        fromAdmin
                                                                            ? "Support Team"
                                                                            : "Customer"
                                                                    )
                                                                %>
                                                            </p>

                                                            <p
                                                                class="text-sm text-gray-700
                                                                       mt-2 whitespace-pre-line"
                                                            >
                                                                <%= message.body || "" %>
                                                            </p>

                                                            <% if (message.createdAt) { %>
                                                                <p class="text-xs text-gray-400 mt-2">
                                                                    <%= new Date(
                                                                        message.createdAt
                                                                    ).toLocaleString() %>
                                                                </p>
                                                            <% } %>

                                                        </div>

                                                    </div>

                                                <% }); %>

                                            </div>

                                        <% } %>

                                        <% if (
                                            ticketRecord.status !== "Closed"
                                        ) { %>

                                            <form
                                                action="/admin/support/<%= ticketRecord._id || ticketRecord.id %>/reply"
                                                method="POST"
                                                class="border-t border-gray-100 pt-5"
                                            >

                                                <label
                                                    for="adminSupportReply"
                                                    class="admin-label"
                                                >
                                                    Reply
                                                </label>

                                                <textarea
                                                    id="adminSupportReply"
                                                    name="body"
                                                    rows="5"
                                                    maxlength="5000"
                                                    class="admin-input resize-none"
                                                    placeholder="Write a reply to the customer"
                                                    required
                                                ></textarea>

                                                <div class="flex justify-end mt-4">

                                                    <button
                                                        type="submit"
                                                        class="admin-primary-button"
                                                    >
                                                        <i
                                                            data-lucide="send"
                                                            class="h-4 w-4"
                                                        ></i>

                                                        Send Reply
                                                    </button>

                                                </div>

                                            </form>

                                        <% } else { %>

                                            <div
                                                class="border-t border-gray-100
                                                       pt-5"
                                            >
                                                <p class="text-sm text-gray-500">
                                                    Closed tickets cannot receive
                                                    additional replies.
                                                </p>
                                            </div>

                                        <% } %>

                                    </div>

                                </section>

                                <aside class="space-y-6">

                                    <section class="admin-panel">

                                        <div class="admin-panel-header">
                                            <h3>Customer</h3>
                                        </div>

                                        <div class="p-6">

                                            <% if (ticketCustomer) { %>

                                                <p class="text-sm font-semibold text-gray-900">
                                                    <%= [
                                                        ticketCustomer.firstName,
                                                        ticketCustomer.middleName,
                                                        ticketCustomer.lastName
                                                    ]
                                                        .filter(Boolean)
                                                        .join(" ")
                                                    %>
                                                </p>

                                                <% if (ticketCustomer.email) { %>
                                                    <p class="text-sm text-gray-500 mt-1">
                                                        <%= ticketCustomer.email %>
                                                    </p>
                                                <% } %>

                                                <% if (
                                                    ticketAccount &&
                                                    ticketAccount.accountNumber
                                                ) { %>
                                                    <div
                                                        class="mt-4 pt-4
                                                               border-t border-gray-100"
                                                    >
                                                        <p class="text-xs text-gray-400">
                                                            Account Number
                                                        </p>

                                                        <p
                                                            class="text-sm font-semibold
                                                                   text-gray-800 mt-1"
                                                        >
                                                            <%= ticketAccount.accountNumber %>
                                                        </p>
                                                    </div>
                                                <% } %>

                                            <% } %>

                                        </div>

                                    </section>

                                    <section class="admin-panel">

                                        <div class="admin-panel-header">
                                            <h3>Ticket Information</h3>
                                        </div>

                                        <div class="p-6 space-y-4">

                                            <div class="admin-detail">
                                                <span>Category</span>
                                                <strong>
                                                    <%= ticketRecord.category || "" %>
                                                </strong>
                                            </div>

                                            <div class="admin-detail">
                                                <span>Priority</span>
                                                <strong>
                                                    <%= ticketRecord.priority || "" %>
                                                </strong>
                                            </div>

                                            <div class="admin-detail">
                                                <span>Status</span>
                                                <strong>
                                                    <%= ticketRecord.status || "" %>
                                                </strong>
                                            </div>

                                            <% if (ticketRecord.createdAt) { %>
                                                <div class="admin-detail">
                                                    <span>Created</span>
                                                    <strong>
                                                        <%= new Date(
                                                            ticketRecord.createdAt
                                                        ).toLocaleString() %>
                                                    </strong>
                                                </div>
                                            <% } %>

                                            <% if (
                                                ticketRecord.assignedTo
                                            ) { %>
                                                <div class="admin-detail">
                                                    <span>Assigned</span>
                                                    <strong>
                                                        <%= [
                                                            ticketRecord.assignedTo.firstName,
                                                            ticketRecord.assignedTo.middleName,
                                                            ticketRecord.assignedTo.lastName
                                                        ]
                                                            .filter(Boolean)
                                                            .join(" ")
                                                        %>
                                                    </strong>
                                                </div>
                                            <% } %>

                                        </div>

                                    </section>

                                    <section class="admin-panel">

                                        <div class="admin-panel-header">
                                            <h3>Status Management</h3>
                                        </div>

                                        <div class="p-6">

                                            <% if (
                                                ticketRecord.status !== "Closed"
                                            ) { %>

                                                <form
                                                    action="/admin/support/<%= ticketRecord._id || ticketRecord.id %>/status"
                                                    method="POST"
                                                >

                                                    <label
                                                        for="ticketStatus"
                                                        class="admin-label"
                                                    >
                                                        Status
                                                    </label>

                                                    <select
                                                        id="ticketStatus"
                                                        name="status"
                                                        class="admin-input"
                                                        required
                                                    >

                                                        <% [
                                                            "Open",
                                                            "In Progress",
                                                            "Resolved",
                                                            "Closed"
                                                        ].forEach(function(status) { %>

                                                            <option
                                                                value="<%= status %>"
                                                                <%= ticketRecord.status === status
                                                                    ? "selected"
                                                                    : ""
                                                                %>
                                                            >
                                                                <%= status %>
                                                            </option>

                                                        <% }); %>

                                                    </select>

                                                    <label
                                                        for="resolutionNote"
                                                        class="admin-label mt-4"
                                                    >
                                                        Resolution Note
                                                    </label>

                                                    <textarea
                                                        id="resolutionNote"
                                                        name="resolutionNote"
                                                        rows="4"
                                                        class="admin-input resize-none"
                                                        placeholder="Required when resolving or closing"
                                                    ><%= ticketRecord.resolutionNote || "" %></textarea>

                                                    <button
                                                        type="submit"
                                                        class="admin-primary-button
                                                               w-full mt-4"
                                                    >
                                                        <i
                                                            data-lucide="save"
                                                            class="h-4 w-4"
                                                        ></i>

                                                        Update Status
                                                    </button>

                                                </form>

                                            <% } else { %>

                                                <div
                                                    class="p-4 bg-gray-50
                                                           border border-gray-200
                                                           rounded-lg"
                                                >
                                                    <p class="text-sm font-semibold text-gray-800">
                                                        Ticket Closed
                                                    </p>

                                                    <% if (
                                                        ticketRecord.resolutionNote
                                                    ) { %>
                                                        <p
                                                            class="text-xs text-gray-600
                                                                   mt-2 whitespace-pre-line"
                                                        >
                                                            <%= ticketRecord.resolutionNote %>
                                                        </p>
                                                    <% } %>
                                                </div>

                                            <% } %>

                                        </div>

                                    </section>

                                </aside>

                            </div>

                        <% } %>

                    </div>

                </div>

            </main>

        </div>

    </div>

    <%- include("../partials/scripts") %>

</body>

</html>