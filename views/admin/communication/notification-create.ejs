<%
    const customerRecords =
        typeof customers !== "undefined" &&
        Array.isArray(customers)
            ? customers
            : [];

    const oldForm =
        typeof formData !== "undefined" &&
        formData
            ? formData
            : {};

    const selectedId =
        oldForm.customerId ||
        (
            typeof selectedCustomerId !== "undefined"
                ? selectedCustomerId
                : ""
        );
%>


<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head") %>
</head>


<body class="bg-gray-50">

    <%- include("../partials/loader") %>


    <div
        x-data="{ mobileMenuOpen: false }"
        class="admin-app-shell
               flex h-screen
               overflow-hidden"
    >

        <%- include("../partials/sidebar") %>


        <div
            class="admin-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("../partials/topbar") %>

            <%- include("../partials/mobile-menu") %>


            <main class="admin-main-content">

                <div class="py-6">

                    <div
                        class="max-w-5xl
                               mx-auto
                               px-4
                               sm:px-6
                               lg:px-8"
                    >

                        <a
                            href="/admin/notifications"
                            class="inline-flex
                                   items-center
                                   text-sm
                                   text-gray-500
                                   hover:text-gray-700
                                   mb-6"
                        >

                            <i
                                data-lucide="arrow-left"
                                class="h-4 w-4 mr-2"
                            ></i>

                            Back to Notifications

                        </a>


                        <div class="mb-6">

                            <h1
                                class="text-2xl
                                       font-bold
                                       text-gray-900"
                            >
                                Create Notification
                            </h1>


                            <p
                                class="text-sm
                                       text-gray-500
                                       mt-1"
                            >
                                Send a notification to a customer's
                                dashboard account.
                            </p>

                        </div>


                        <% if (
                            typeof error !== "undefined" &&
                            error
                        ) { %>

                            <div
                                class="mb-6
                                       p-4
                                       bg-red-50
                                       border
                                       border-red-200
                                       rounded-xl"
                            >

                                <div class="flex items-start">

                                    <i
                                        data-lucide="circle-alert"
                                        class="h-5 w-5
                                               text-red-600
                                               mr-3
                                               mt-0.5"
                                    ></i>


                                    <p
                                        class="text-sm
                                               text-red-800"
                                    >
                                        <%= error %>
                                    </p>

                                </div>

                            </div>

                        <% } %>


                        <section class="admin-panel">

                            <div class="admin-panel-header">

                                <div>

                                    <h3>
                                        Notification Information
                                    </h3>


                                    <p
                                        class="text-xs
                                               text-gray-500
                                               mt-1"
                                    >
                                        The notification will initially
                                        appear as unread.
                                    </p>

                                </div>

                            </div>


                            <form
                                action="/admin/notifications/create"
                                method="POST"
                                class="p-6"
                            >

                                <div
                                    class="grid
                                           grid-cols-1
                                           md:grid-cols-2
                                           gap-5"
                                >

                                    <!-- Customer -->

                                    <div class="md:col-span-2">

                                        <label
                                            for="customerId"
                                            class="admin-label"
                                        >
                                            Customer
                                        </label>


                                        <select
                                            id="customerId"
                                            name="customerId"
                                            class="admin-input"
                                            required
                                        >

                                            <option value="">
                                                Select customer
                                            </option>


                                            <% customerRecords.forEach(
                                                function(customer) {

                                                    const customerId =
                                                        customer.id ||
                                                        customer._id;

                                                    const label = [
                                                        customer.fullName,
                                                        customer.customerId
                                                    ]
                                                        .filter(Boolean)
                                                        .join(" · ");
                                            %>

                                                <option
                                                    value="<%= customerId %>"
                                                    <%= String(
                                                        customerId
                                                    ) === String(
                                                        selectedId
                                                    )
                                                        ? "selected"
                                                        : ""
                                                    %>
                                                >
                                                    <%= label || customerId %>
                                                </option>

                                            <% }); %>

                                        </select>

                                    </div>


                                    <!-- Type -->

                                    <div>

                                        <label
                                            for="notificationType"
                                            class="admin-label"
                                        >
                                            Type
                                        </label>


                                        <select
                                            id="notificationType"
                                            name="type"
                                            class="admin-input"
                                            required
                                        >

                                            <option value="">
                                                Select type
                                            </option>


                                            <% [
                                                "General",
                                                "Account",
                                                "Deposit",
                                                "Transfer",
                                                "Card",
                                                "Loan",
                                                "Investment",
                                                "KYC",
                                                "Security",
                                                "Support"
                                            ].forEach(
                                                function(type) {
                                            %>

                                                <option
                                                    value="<%= type %>"
                                                    <%= oldForm.type === type
                                                        ? "selected"
                                                        : ""
                                                    %>
                                                >
                                                    <%= type %>
                                                </option>

                                            <% }); %>

                                        </select>

                                    </div>


                                    <!-- Priority -->

                                    <div>

                                        <label
                                            for="notificationPriority"
                                            class="admin-label"
                                        >
                                            Priority
                                        </label>


                                        <select
                                            id="notificationPriority"
                                            name="priority"
                                            class="admin-input"
                                            required
                                        >

                                            <% [
                                                "Normal",
                                                "Important",
                                                "Urgent"
                                            ].forEach(
                                                function(priority) {
                                            %>

                                                <option
                                                    value="<%= priority %>"
                                                    <%= (
                                                        oldForm.priority ||
                                                        "Normal"
                                                    ) === priority
                                                        ? "selected"
                                                        : ""
                                                    %>
                                                >
                                                    <%= priority %>
                                                </option>

                                            <% }); %>

                                        </select>

                                    </div>


                                    <!-- Title -->

                                    <div class="md:col-span-2">

                                        <label
                                            for="notificationTitle"
                                            class="admin-label"
                                        >
                                            Title
                                        </label>


                                        <input
                                            id="notificationTitle"
                                            type="text"
                                            name="title"
                                            maxlength="160"
                                            value="<%= oldForm.title || "" %>"
                                            class="admin-input"
                                            placeholder="Notification title"
                                            required
                                        >

                                    </div>


                                    <!-- Message -->

                                    <div class="md:col-span-2">

                                        <label
                                            for="notificationMessage"
                                            class="admin-label"
                                        >
                                            Message
                                        </label>


                                        <textarea
                                            id="notificationMessage"
                                            name="message"
                                            rows="6"
                                            maxlength="5000"
                                            class="admin-input
                                                   resize-none"
                                            placeholder="Enter the notification message"
                                            required
                                        ><%= oldForm.message || "" %></textarea>

                                    </div>


                                    <!-- Action URL -->

                                    <div>

                                        <label
                                            for="actionUrl"
                                            class="admin-label"
                                        >
                                            Action URL
                                        </label>


                                        <input
                                            id="actionUrl"
                                            type="text"
                                            name="actionUrl"
                                            value="<%= oldForm.actionUrl || "" %>"
                                            class="admin-input"
                                            placeholder="/dashboard/loans/..."
                                        >


                                        <p
                                            class="text-xs
                                                   text-gray-500
                                                   mt-1"
                                        >
                                            Optional. Must begin with
                                            /dashboard/.
                                        </p>

                                    </div>


                                    <!-- Action label -->

                                    <div>

                                        <label
                                            for="actionLabel"
                                            class="admin-label"
                                        >
                                            Action Label
                                        </label>


                                        <input
                                            id="actionLabel"
                                            type="text"
                                            name="actionLabel"
                                            value="<%= oldForm.actionLabel || "" %>"
                                            class="admin-input"
                                            placeholder="View Details"
                                        >

                                    </div>

                                </div>


                                <div
                                    class="mt-6
                                           p-4
                                           bg-blue-50
                                           border
                                           border-blue-100
                                           rounded-lg"
                                >

                                    <div class="flex items-start">

                                        <i
                                            data-lucide="info"
                                            class="h-5 w-5
                                                   text-blue-600
                                                   mr-3
                                                   mt-0.5"
                                        ></i>


                                        <p
                                            class="text-sm
                                                   text-blue-800"
                                        >
                                            The customer will see this
                                            notification immediately on
                                            the Notifications page.
                                        </p>

                                    </div>

                                </div>


                                <div
                                    class="flex
                                           flex-col-reverse
                                           sm:flex-row
                                           sm:justify-end
                                           gap-3
                                           mt-7"
                                >

                                    <a
                                        href="/admin/notifications"
                                        class="admin-secondary-button"
                                    >
                                        Cancel
                                    </a>


                                    <button
                                        type="submit"
                                        class="admin-primary-button"
                                    >

                                        <i
                                            data-lucide="send"
                                            class="h-4 w-4"
                                        ></i>

                                        Create Notification

                                    </button>

                                </div>

                            </form>

                        </section>

                    </div>

                </div>

            </main>

        </div>

    </div>


    <%- include("../partials/scripts") %>

</body>

</html>