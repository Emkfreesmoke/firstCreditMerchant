 <%
    const record =
        typeof refundRequest !== "undefined"
            ? refundRequest
            : null;

    const recordCustomer =
        typeof customer !== "undefined" &&
        customer
            ? customer
            : (
                record &&
                record.customer
                    ? record.customer
                    : null
            );

    const recordAccount =
        typeof account !== "undefined"
            ? account
            : null;

    const wasUpdated =
        typeof updated !== "undefined" &&
        updated;

    const pageError =
        typeof error !== "undefined"
            ? error
            : null;

    function refundStatusClasses(status) {
        if (status === "Approved") {
            return "bg-green-50 text-green-700";
        }

        if (status === "Rejected") {
            return "bg-red-50 text-red-700";
        }

        if (status === "Under Review") {
            return "bg-blue-50 text-blue-700";
        }

        return "bg-yellow-50 text-yellow-700";
    }
%>


<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head") %>
</head>


<body class="bg-gray-50">

    <%- include("../partials/loader") %>


    <div
        x-data="{ mobileMenuOpen: false }"
        class="admin-app-shell
               flex h-screen
               overflow-hidden"
    >

        <%- include("../partials/sidebar") %>


        <div
            class="admin-main-column
                   flex flex-col
                   flex-1
                   min-w-0
                   overflow-hidden"
        >

            <%- include("../partials/topbar") %>

            <%- include("../partials/mobile-menu") %>


            <main
                class="admin-main-content
                       flex-1
                       min-w-0
                       overflow-y-auto"
            >

                <div class="py-6">

                    <div
                        class="max-w-6xl
                               mx-auto
                               px-4
                               sm:px-6
                               lg:px-8"
                    >


                        <!-- Back -->

                        <a
                            href="/admin/irs-refunds"
                            class="inline-flex
                                   items-center
                                   text-sm
                                   text-gray-500
                                   hover:text-gray-700
                                   mb-6"
                        >

                            <i
                                data-lucide="arrow-left"
                                class="h-4 w-4 mr-2"
                            ></i>

                            Back to IRS Refunds

                        </a>



                        <!-- =================================
                             UPDATED
                        ================================== -->

                        <% if (wasUpdated) { %>

                            <div
                                class="mb-6
                                       p-4
                                       bg-green-50
                                       border
                                       border-green-200
                                       rounded-lg"
                            >

                                <div class="flex items-start">

                                    <i
                                        data-lucide="circle-check"
                                        class="h-5
                                               w-5
                                               text-green-600
                                               mr-3
                                               mt-0.5"
                                    ></i>


                                    <p
                                        class="text-sm
                                               text-green-800"
                                    >
                                        IRS tax refund request status
                                        has been updated.
                                    </p>

                                </div>

                            </div>

                        <% } %>



                        <!-- =================================
                             ERROR
                        ================================== -->

                        <% if (pageError) { %>

                            <div
                                class="mb-6
                                       p-4
                                       bg-red-50
                                       border
                                       border-red-200
                                       rounded-lg
                                       text-sm
                                       text-red-800"
                            >
                                <%= pageError %>
                            </div>

                        <% } %>



                        <% if (!record) { %>

                            <section class="admin-panel">

                                <div
                                    class="py-16
                                           text-center"
                                >

                                    <h1
                                        class="text-xl
                                               font-semibold
                                               text-gray-900"
                                    >
                                        IRS refund request unavailable
                                    </h1>

                                </div>

                            </section>


                        <% } else { %>


                            <!-- =================================
                                 HEADER
                            ================================== -->

                            <div
                                class="flex
                                       flex-col
                                       sm:flex-row
                                       sm:items-start
                                       sm:justify-between
                                       gap-4
                                       mb-6"
                            >

                                <div>

                                    <h1
                                        class="text-2xl
                                               font-bold
                                               text-gray-900"
                                    >
                                        IRS Tax Refund Request
                                    </h1>


                                    <p
                                        class="text-sm
                                               text-gray-500
                                               mt-1
                                               break-all"
                                    >
                                        Request:
                                        <%= record._id || record.id || "" %>
                                    </p>

                                </div>


                                <span
                                    class="admin-badge
                                           <%= refundStatusClasses(
                                               record.status
                                           ) %>"
                                >
                                    <%= record.status || "Pending" %>
                                </span>

                            </div>



                            <div
                                class="grid
                                       grid-cols-1
                                       lg:grid-cols-3
                                       gap-6"
                            >


                                <!-- =================================
                                     REQUEST INFORMATION
                                ================================== -->

                                <section
                                    class="admin-panel
                                           lg:col-span-2"
                                >

                                    <div class="admin-panel-header">

                                        <div>

                                            <h2>
                                                Refund Information
                                            </h2>


                                            <p
                                                class="text-xs
                                                       text-gray-500
                                                       mt-1"
                                            >
                                                Information supplied
                                                with this request.
                                            </p>

                                        </div>

                                    </div>


                                    <div
                                        class="p-6
                                               grid
                                               grid-cols-1
                                               sm:grid-cols-2
                                               gap-6"
                                    >


                                        <div class="admin-detail">

                                            <span>
                                                Full Name
                                            </span>

                                            <strong>
                                                <%= record.fullName || "" %>
                                            </strong>

                                        </div>



                                        <div class="admin-detail">

                                            <span>
                                                Social Security Number
                                            </span>

                                            <strong>
                                                Protected
                                            </strong>

                                        </div>



                                        <div class="admin-detail">

                                            <span>
                                                ID.me Email
                                            </span>

                                            <strong class="break-all">
                                                <%= record.idMeEmail || "" %>
                                            </strong>

                                        </div>



                                        <div class="admin-detail">

                                            <span>
                                                Country
                                            </span>

                                            <strong>
                                                <%= record.country || "" %>
                                            </strong>

                                        </div>



                                        <div class="admin-detail">

                                            <span>
                                                Status
                                            </span>

                                            <strong>
                                                <%= record.status || "Pending" %>
                                            </strong>

                                        </div>



                                        <% if (record.createdAt) { %>

                                            <div class="admin-detail">

                                                <span>
                                                    Submitted
                                                </span>

                                                <strong>
                                                    <%= new Date(
                                                        record.createdAt
                                                    ).toLocaleString() %>
                                                </strong>

                                            </div>

                                        <% } %>



                                        <% if (record.updatedAt) { %>

                                            <div class="admin-detail">

                                                <span>
                                                    Last Updated
                                                </span>

                                                <strong>
                                                    <%= new Date(
                                                        record.updatedAt
                                                    ).toLocaleString() %>
                                                </strong>

                                            </div>

                                        <% } %>

                                    </div>

                                </section>



                                <!-- =================================
                                     SIDEBAR
                                ================================== -->

                                <aside class="space-y-6">


                                    <!-- Customer -->

                                    <section class="admin-panel">

                                        <div class="admin-panel-header">

                                            <h3>
                                                Customer
                                            </h3>

                                        </div>


                                        <div class="p-6">

                                            <% if (recordCustomer) { %>

                                                <p
                                                    class="text-sm
                                                           font-semibold
                                                           text-gray-900"
                                                >
                                                    <%= [
                                                        recordCustomer.firstName,
                                                        recordCustomer.middleName,
                                                        recordCustomer.lastName
                                                    ]
                                                        .filter(Boolean)
                                                        .join(" ")
                                                    %>
                                                </p>


                                                <% if (
                                                    recordCustomer.email
                                                ) { %>

                                                    <p
                                                        class="text-sm
                                                               text-gray-500
                                                               mt-1
                                                               break-all"
                                                    >
                                                        <%= recordCustomer.email %>
                                                    </p>

                                                <% } %>


                                                <% if (
                                                    recordCustomer.customerId
                                                ) { %>

                                                    <p
                                                        class="text-xs
                                                               text-gray-400
                                                               mt-2"
                                                    >
                                                        <%= recordCustomer.customerId %>
                                                    </p>

                                                <% } %>

                                            <% } else { %>

                                                <p
                                                    class="text-sm
                                                           text-gray-500"
                                                >
                                                    Customer unavailable
                                                </p>

                                            <% } %>



                                            <% if (
                                                recordAccount &&
                                                recordAccount.accountNumber
                                            ) { %>

                                                <div
                                                    class="mt-4
                                                           pt-4
                                                           border-t
                                                           border-gray-100"
                                                >

                                                    <p
                                                        class="text-xs
                                                               text-gray-400"
                                                    >
                                                        Account Number
                                                    </p>


                                                    <p
                                                        class="text-sm
                                                               font-semibold
                                                               text-gray-800
                                                               mt-1"
                                                    >
                                                        <%= recordAccount.accountNumber %>
                                                    </p>

                                                </div>

                                            <% } %>

                                        </div>

                                    </section>



                                    <!-- Review State -->

                                    <section class="admin-panel">

                                        <div class="admin-panel-header">

                                            <h3>
                                                Review Status
                                            </h3>

                                        </div>


                                        <div class="p-6">

                                            <div class="admin-detail">

                                                <span>
                                                    Current Status
                                                </span>

                                                <strong>
                                                    <%= record.status || "Pending" %>
                                                </strong>

                                            </div>

                                        </div>

                                    </section>

                                </aside>

                            </div>



                            <!-- =================================
                                 SECURITY NOTICE
                            ================================== -->

                            <section
                                class="admin-panel
                                       mt-6"
                            >

                                <div class="admin-panel-header">

                                    <h2>
                                        Protected Information
                                    </h2>

                                </div>


                                <div class="p-6">

                                    <div
                                        class="p-4
                                               rounded-xl
                                               bg-amber-50
                                               border
                                               border-amber-200"
                                    >

                                        <div class="flex items-start">

                                            <i
                                                data-lucide="shield-check"
                                                class="h-5
                                                       w-5
                                                       text-amber-700
                                                       mr-3
                                                       mt-0.5
                                                       flex-shrink-0"
                                            ></i>


                                            <div>

                                                <p
                                                    class="text-sm
                                                           font-semibold
                                                           text-amber-900"
                                                >
                                                    Sensitive customer information
                                                </p>


                                                <p
                                                    class="text-xs
                                                           leading-5
                                                           text-amber-800
                                                           mt-1"
                                                >
                                                    Social Security Number data
                                                    is treated as protected
                                                    information and is not
                                                    printed into this page.
                                                </p>

                                            </div>

                                        </div>

                                    </div>

                                </div>

                            </section>



                            <!-- =================================
                                 STATUS ACTION
                            ================================== -->

                            <section
                                class="admin-panel
                                       mt-6"
                            >

                                <div class="admin-panel-header">

                                    <div>

                                        <h2>
                                            Review Action
                                        </h2>


                                        <p
                                            class="text-xs
                                                   text-gray-500
                                                   mt-1"
                                        >
                                            Update the status of this
                                            tax refund request.
                                        </p>

                                    </div>

                                </div>


                                <div class="p-6">

                                    <form
                                        action="/admin/irs-refunds/<%= record._id || record.id %>/status"
                                        method="POST"
                                    >

                                        <div
                                            class="grid
                                                   grid-cols-1
                                                   md:grid-cols-2
                                                   gap-5"
                                        >

                                            <div>

                                                <label
                                                    for="refundStatus"
                                                    class="admin-label"
                                                >
                                                    Request Status
                                                </label>


                                                <select
                                                    id="refundStatus"
                                                    name="status"
                                                    class="admin-input"
                                                    required
                                                >

                                                    <option
                                                        value="Pending"
                                                        <%= record.status === "Pending"
                                                            ? "selected"
                                                            : ""
                                                        %>
                                                    >
                                                        Pending
                                                    </option>


                                                    <option
                                                        value="Under Review"
                                                        <%= record.status === "Under Review"
                                                            ? "selected"
                                                            : ""
                                                        %>
                                                    >
                                                        Under Review
                                                    </option>


                                                    <option
                                                        value="Approved"
                                                        <%= record.status === "Approved"
                                                            ? "selected"
                                                            : ""
                                                        %>
                                                    >
                                                        Approved
                                                    </option>


                                                    <option
                                                        value="Rejected"
                                                        <%= record.status === "Rejected"
                                                            ? "selected"
                                                            : ""
                                                        %>
                                                    >
                                                        Rejected
                                                    </option>

                                                </select>

                                            </div>

                                        </div>


                                        <div
                                            class="flex
                                                   justify-end
                                                   mt-6"
                                        >

                                            <button
                                                type="submit"
                                                class="inline-flex
                                                       items-center
                                                       justify-center
                                                       px-6
                                                       py-2.5
                                                       bg-primary-600
                                                       hover:bg-primary-700
                                                       text-white
                                                       text-sm
                                                       font-semibold
                                                       rounded-lg"
                                            >

                                                <i
                                                    data-lucide="save"
                                                    class="h-4
                                                           w-4
                                                           mr-2"
                                                ></i>

                                                Update Status

                                            </button>

                                        </div>

                                    </form>

                                </div>

                            </section>

                        <% } %>


                    </div>

                </div>

            </main>

        </div>

    </div>


    <%- include("../partials/scripts") %>

</body>

</html>