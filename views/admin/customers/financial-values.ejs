<%
    const customerRecord =
        typeof customer !== "undefined"
            ? customer
            : null;

    const accountRecord =
        typeof account !== "undefined"
            ? account
            : null;

    const values =
        typeof dashboardValues !== "undefined"
            ? dashboardValues
            : null;

    const oldForm =
        typeof formData !== "undefined" &&
        formData
            ? formData
            : {};

    const wasUpdated =
        typeof updated !== "undefined" &&
        updated === true;

    const pageError =
        typeof error !== "undefined"
            ? error
            : null;

    const valueCurrency =
        accountRecord &&
        accountRecord.currency
            ? accountRecord.currency
            : values &&
              values.currency
            ? values.currency
            : "";

    const initialDisplayedBalance =
        oldForm.displayedBalance !== undefined &&
        oldForm.displayedBalance !== null
            ? oldForm.displayedBalance
            : values &&
              values.displayedBalance !== undefined &&
              values.displayedBalance !== null
            ? values.displayedBalance
            : 0;

    const initialMonthlyIncome =
        oldForm.monthlyIncome !== undefined &&
        oldForm.monthlyIncome !== null
            ? oldForm.monthlyIncome
            : values &&
              values.monthlyIncome !== undefined &&
              values.monthlyIncome !== null
            ? values.monthlyIncome
            : 0;

    const initialMonthlyOutgoing =
        oldForm.monthlyOutgoing !== undefined &&
        oldForm.monthlyOutgoing !== null
            ? oldForm.monthlyOutgoing
            : values &&
              values.monthlyOutgoing !== undefined &&
              values.monthlyOutgoing !== null
            ? values.monthlyOutgoing
            : 0;

    const initialTransactionLimit =
        oldForm.transactionLimit !== undefined &&
        oldForm.transactionLimit !== null
            ? oldForm.transactionLimit
            : values &&
              values.transactionLimit !== undefined &&
              values.transactionLimit !== null
            ? values.transactionLimit
            : 0;

    const initialPendingTransactions =
        oldForm.pendingTransactions !== undefined &&
        oldForm.pendingTransactions !== null
            ? oldForm.pendingTransactions
            : values &&
              values.pendingTransactions !== undefined &&
              values.pendingTransactions !== null
            ? values.pendingTransactions
            : 0;

    const initialTransactionVolume =
        oldForm.transactionVolume !== undefined &&
        oldForm.transactionVolume !== null
            ? oldForm.transactionVolume
            : values &&
              values.transactionVolume !== undefined &&
              values.transactionVolume !== null
            ? values.transactionVolume
            : 0;

    const initialAdminNote =
        oldForm.adminNote !== undefined &&
        oldForm.adminNote !== null
            ? oldForm.adminNote
            : "";
%>

<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head") %>
</head>

<body class="bg-gray-50">

    <div
        x-data='{
            mobileMenuOpen: false,

            displayedBalance:
                <%- JSON.stringify(
                    initialDisplayedBalance
                ) %>,

            monthlyIncome:
                <%- JSON.stringify(
                    initialMonthlyIncome
                ) %>,

            monthlyOutgoing:
                <%- JSON.stringify(
                    initialMonthlyOutgoing
                ) %>,

            transactionLimit:
                <%- JSON.stringify(
                    initialTransactionLimit
                ) %>,

            pendingTransactions:
                <%- JSON.stringify(
                    initialPendingTransactions
                ) %>,

            transactionVolume:
                <%- JSON.stringify(
                    initialTransactionVolume
                ) %>,

            currency:
                <%- JSON.stringify(
                    valueCurrency
                ) %>,

            money(value) {
                const number =
                    Number(value || 0);

                if (
                    !Number.isFinite(number)
                ) {
                    return "0.00";
                }

                return number.toLocaleString(
                    undefined,
                    {
                        minimumFractionDigits: 2,
                        maximumFractionDigits: 2
                    }
                );
            }
        }'
        class="admin-app-shell"
    >

        <!-- =========================================
             SIDEBAR
        ========================================== -->

        <%- include("../partials/sidebar") %>


        <!-- =========================================
             MAIN ADMIN COLUMN
        ========================================== -->

        <div class="admin-main-column">

            <%- include("../partials/topbar") %>
            <%- include("../partials/mobile-menu") %>


            <!-- =====================================
                 PAGE CONTENT
            ====================================== -->

            <main class="admin-main-content">

                <div class="w-full py-6">

                    <div
                        class="w-full
                               max-w-5xl
                               mx-auto
                               px-4
                               sm:px-6
                               lg:px-8"
                    >

                        <!-- =================================
                             BACK
                        ================================== -->

                        <div class="mb-6">

                            <a
                                href="<%= customerRecord &&
                                    customerRecord.id
                                        ? '/admin/customers/' +
                                          customerRecord.id
                                        : '/admin/balances'
                                %>"
                                class="inline-flex
                                       items-center
                                       text-sm
                                       font-medium
                                       text-gray-500
                                       hover:text-gray-700"
                            >

                                <i
                                    data-lucide="arrow-left"
                                    class="h-4 w-4 mr-2"
                                ></i>

                                Back

                            </a>

                        </div>


                        <!-- =================================
                             SUCCESS
                        ================================== -->

                        <% if (wasUpdated) { %>

                            <div
                                class="mb-6
                                       px-4
                                       py-4
                                       bg-green-50
                                       border
                                       border-green-200
                                       rounded-xl"
                            >

                                <div
                                    class="flex
                                           items-start"
                                >

                                    <i
                                        data-lucide="circle-check"
                                        class="h-5
                                               w-5
                                               text-green-600
                                               mr-3
                                               mt-0.5
                                               flex-shrink-0"
                                    ></i>

                                    <div>

                                        <p
                                            class="text-sm
                                                   font-semibold
                                                   text-green-800"
                                        >
                                            Financial values updated
                                        </p>

                                        <p
                                            class="text-sm
                                                   text-green-700
                                                   mt-1"
                                        >
                                            The customer's dashboard
                                            financial values have been saved.
                                        </p>

                                    </div>

                                </div>

                            </div>

                        <% } %>


                        <!-- =================================
                             ERROR
                        ================================== -->

                        <% if (pageError) { %>

                            <div
                                class="mb-6
                                       px-4
                                       py-4
                                       bg-red-50
                                       border
                                       border-red-200
                                       rounded-xl"
                            >

                                <div
                                    class="flex
                                           items-start"
                                >

                                    <i
                                        data-lucide="circle-alert"
                                        class="h-5
                                               w-5
                                               text-red-600
                                               mr-3
                                               mt-0.5
                                               flex-shrink-0"
                                    ></i>

                                    <p
                                        class="text-sm
                                               text-red-800"
                                    >
                                        <%= pageError %>
                                    </p>

                                </div>

                            </div>

                        <% } %>


                        <% if (!customerRecord) { %>

                            <!-- =================================
                                 CUSTOMER UNAVAILABLE
                            ================================== -->

                            <section
                                class="admin-panel
                                       w-full"
                            >

                                <div class="admin-empty-state">

                                    <div
                                        class="h-14
                                               w-14
                                               rounded-full
                                               bg-gray-100
                                               flex
                                               items-center
                                               justify-center
                                               mb-4"
                                    >

                                        <i
                                            data-lucide="user-x"
                                            class="h-7
                                                   w-7
                                                   text-gray-400"
                                        ></i>

                                    </div>

                                    <h1
                                        class="text-xl
                                               font-semibold
                                               text-gray-900
                                               mb-2"
                                    >
                                        Customer unavailable
                                    </h1>

                                    <p>
                                        The requested customer record
                                        could not be loaded.
                                    </p>

                                </div>

                            </section>

                        <% } else { %>


                            <!-- =================================
                                 PAGE HEADER
                            ================================== -->

                            <div
                                class="flex
                                       flex-col
                                       sm:flex-row
                                       sm:items-start
                                       sm:justify-between
                                       gap-4
                                       mb-6"
                            >

                                <div class="min-w-0">

                                    <h1
                                        class="text-2xl
                                               font-bold
                                               text-gray-900"
                                    >
                                        Financial Values
                                    </h1>


                                    <% if (
                                        customerRecord.fullName
                                    ) { %>

                                        <p
                                            class="text-sm
                                                   text-gray-500
                                                   mt-1
                                                   break-words"
                                        >
                                            <%= customerRecord.fullName %>
                                        </p>

                                    <% } %>


                                    <% if (
                                        customerRecord.customerId
                                    ) { %>

                                        <p
                                            class="text-xs
                                                   text-gray-400
                                                   mt-1"
                                        >
                                            Customer ID:
                                            <%= customerRecord.customerId %>
                                        </p>

                                    <% } %>

                                </div>


                                <% if (accountRecord) { %>

                                    <div
                                        class="inline-flex
                                               self-start
                                               items-center
                                               px-3
                                               py-1.5
                                               bg-gray-100
                                               rounded-full
                                               text-xs
                                               font-medium
                                               text-gray-700"
                                    >

                                        <i
                                            data-lucide="wallet"
                                            class="h-3.5
                                                   w-3.5
                                                   mr-1.5"
                                        ></i>

                                        <%= accountRecord.accountNumber || "" %>

                                    </div>

                                <% } %>

                            </div>


                            <!-- =================================
                                 INFORMATION
                            ================================== -->

                            <div
                                class="bg-primary-50
                                       border
                                       border-primary-100
                                       rounded-xl
                                       p-5
                                       mb-6"
                            >

                                <div class="flex items-start">

                                    <i
                                        data-lucide="info"
                                        class="h-5
                                               w-5
                                               text-primary-600
                                               mr-3
                                               mt-0.5
                                               flex-shrink-0"
                                    ></i>


                                    <div>

                                        <h2
                                            class="text-sm
                                                   font-semibold
                                                   text-gray-900"
                                        >
                                            Customer Dashboard Values
                                        </h2>


                                        <p
                                            class="text-sm
                                                   text-gray-600
                                                   mt-1"
                                        >
                                            These values control the
                                            financial summaries displayed
                                            on this customer's dashboard.
                                            Changing the displayed balance
                                            creates an administrative
                                            adjustment transaction.
                                        </p>

                                    </div>

                                </div>

                            </div>


                            <!-- =================================
                                 FINANCIAL VALUES
                            ================================== -->

                            <section
                                class="admin-panel
                                       w-full
                                       mb-8"
                            >

                                <div class="admin-panel-header">

                                    <h3>
                                        Dashboard Financial Values
                                    </h3>

                                </div>


                                <form
                                    method="POST"
                                    action="/admin/customers/<%= customerRecord.id %>/financial-values"
                                >

                                    <div
                                        class="p-5
                                               sm:p-6"
                                    >

                                        <div
                                            class="grid
                                                   grid-cols-1
                                                   md:grid-cols-2
                                                   gap-5"
                                        >

                                            <!-- =================
                                                 CURRENCY
                                            ================== -->

                                            <div>

                                                <label
                                                    for="currency"
                                                    class="admin-label"
                                                >
                                                    Currency
                                                </label>


                                                <input
                                                    id="currency"
                                                    type="text"
                                                    name="currency"
                                                    x-model="currency"
                                                    class="admin-input
                                                           bg-gray-50"
                                                    readonly
                                                >


                                                <p
                                                    class="text-xs
                                                           text-gray-500
                                                           mt-2"
                                                >
                                                    Currency is controlled
                                                    by the customer's account.
                                                </p>

                                            </div>


                                            <!-- =================
                                                 DISPLAYED BALANCE
                                            ================== -->

                                            <div>

                                                <label
                                                    for="displayedBalance"
                                                    class="admin-label"
                                                >
                                                    Displayed Balance
                                                </label>


                                                <input
                                                    id="displayedBalance"
                                                    type="number"
                                                    min="0"
                                                    step="0.01"
                                                    name="displayedBalance"
                                                    x-model="displayedBalance"
                                                    class="admin-input"
                                                    required
                                                >

                                            </div>


                                            <!-- =================
                                                 MONTHLY INCOME
                                            ================== -->

                                            <div>

                                                <label
                                                    for="monthlyIncome"
                                                    class="admin-label"
                                                >
                                                    Monthly Income
                                                </label>


                                                <input
                                                    id="monthlyIncome"
                                                    type="number"
                                                    min="0"
                                                    step="0.01"
                                                    name="monthlyIncome"
                                                    x-model="monthlyIncome"
                                                    class="admin-input"
                                                    required
                                                >

                                            </div>


                                            <!-- =================
                                                 MONTHLY OUTGOING
                                            ================== -->

                                            <div>

                                                <label
                                                    for="monthlyOutgoing"
                                                    class="admin-label"
                                                >
                                                    Monthly Outgoing
                                                </label>


                                                <input
                                                    id="monthlyOutgoing"
                                                    type="number"
                                                    min="0"
                                                    step="0.01"
                                                    name="monthlyOutgoing"
                                                    x-model="monthlyOutgoing"
                                                    class="admin-input"
                                                    required
                                                >

                                            </div>


                                            <!-- =================
                                                 TRANSACTION LIMIT
                                            ================== -->

                                            <div>

                                                <label
                                                    for="transactionLimit"
                                                    class="admin-label"
                                                >
                                                    Transaction Limit
                                                </label>


                                                <input
                                                    id="transactionLimit"
                                                    type="number"
                                                    min="0"
                                                    step="0.01"
                                                    name="transactionLimit"
                                                    x-model="transactionLimit"
                                                    class="admin-input"
                                                    required
                                                >

                                            </div>


                                            <!-- =================
                                                 PENDING
                                            ================== -->

                                            <div>

                                                <label
                                                    for="pendingTransactions"
                                                    class="admin-label"
                                                >
                                                    Pending Transaction Amount
                                                </label>


                                                <input
                                                    id="pendingTransactions"
                                                    type="number"
                                                    min="0"
                                                    step="0.01"
                                                    name="pendingTransactions"
                                                    x-model="pendingTransactions"
                                                    class="admin-input"
                                                    required
                                                >

                                            </div>


                                            <!-- =================
                                                 TRANSACTION VOLUME
                                            ================== -->

                                            <div>

                                                <label
                                                    for="transactionVolume"
                                                    class="admin-label"
                                                >
                                                    Transaction Volume
                                                </label>


                                                <input
                                                    id="transactionVolume"
                                                    type="number"
                                                    min="0"
                                                    step="0.01"
                                                    name="transactionVolume"
                                                    x-model="transactionVolume"
                                                    class="admin-input"
                                                    required
                                                >

                                            </div>


                                            <!-- =================
                                                 ADMIN NOTE
                                            ================== -->

                                            <div
                                                class="md:col-span-2"
                                            >

                                                <label
                                                    for="adminNote"
                                                    class="admin-label"
                                                >
                                                    Adjustment Note
                                                </label>


                                                <textarea
                                                    id="adminNote"
                                                    name="adminNote"
                                                    rows="3"
                                                    class="admin-input"
                                                    placeholder="Explain why the financial values are being changed"
                                                ><%= initialAdminNote %></textarea>


                                                <p
                                                    class="text-xs
                                                           text-gray-500
                                                           mt-2"
                                                >
                                                    If the displayed balance
                                                    changes, this note will be
                                                    used on the generated
                                                    adjustment transaction.
                                                </p>

                                            </div>

                                        </div>


                                        <!-- =================================
                                             PREVIEW
                                        ================================== -->

                                        <div
                                            class="border-t
                                                   border-gray-100
                                                   pt-6
                                                   mt-7"
                                        >

                                            <h3
                                                class="text-sm
                                                       font-semibold
                                                       text-gray-900
                                                       mb-4"
                                            >
                                                Preview
                                            </h3>


                                            <div
                                                class="grid
                                                       grid-cols-1
                                                       sm:grid-cols-2
                                                       xl:grid-cols-4
                                                       gap-4"
                                            >

                                                <!-- Balance -->

                                                <div
                                                    class="p-4
                                                           rounded-lg
                                                           bg-gray-50"
                                                >

                                                    <p
                                                        class="text-xs
                                                               text-gray-500"
                                                    >
                                                        Displayed Balance
                                                    </p>

                                                    <p
                                                        class="text-sm
                                                               font-semibold
                                                               text-gray-900
                                                               mt-2"
                                                    >

                                                        <span
                                                            x-text="currency"
                                                        ></span>

                                                        <span
                                                            x-text="
                                                                money(
                                                                    displayedBalance
                                                                )
                                                            "
                                                        ></span>

                                                    </p>

                                                </div>


                                                <!-- Income -->

                                                <div
                                                    class="p-4
                                                           rounded-lg
                                                           bg-gray-50"
                                                >

                                                    <p
                                                        class="text-xs
                                                               text-gray-500"
                                                    >
                                                        Monthly Income
                                                    </p>

                                                    <p
                                                        class="text-sm
                                                               font-semibold
                                                               text-gray-900
                                                               mt-2"
                                                    >

                                                        <span
                                                            x-text="currency"
                                                        ></span>

                                                        <span
                                                            x-text="
                                                                money(
                                                                    monthlyIncome
                                                                )
                                                            "
                                                        ></span>

                                                    </p>

                                                </div>


                                                <!-- Outgoing -->

                                                <div
                                                    class="p-4
                                                           rounded-lg
                                                           bg-gray-50"
                                                >

                                                    <p
                                                        class="text-xs
                                                               text-gray-500"
                                                    >
                                                        Monthly Outgoing
                                                    </p>

                                                    <p
                                                        class="text-sm
                                                               font-semibold
                                                               text-gray-900
                                                               mt-2"
                                                    >

                                                        <span
                                                            x-text="currency"
                                                        ></span>

                                                        <span
                                                            x-text="
                                                                money(
                                                                    monthlyOutgoing
                                                                )
                                                            "
                                                        ></span>

                                                    </p>

                                                </div>


                                                <!-- Limit -->

                                                <div
                                                    class="p-4
                                                           rounded-lg
                                                           bg-gray-50"
                                                >

                                                    <p
                                                        class="text-xs
                                                               text-gray-500"
                                                    >
                                                        Transaction Limit
                                                    </p>

                                                    <p
                                                        class="text-sm
                                                               font-semibold
                                                               text-gray-900
                                                               mt-2"
                                                    >

                                                        <span
                                                            x-text="currency"
                                                        ></span>

                                                        <span
                                                            x-text="
                                                                money(
                                                                    transactionLimit
                                                                )
                                                            "
                                                        ></span>

                                                    </p>

                                                </div>

                                            </div>

                                        </div>


                                        <!-- =================================
                                             ACTIONS
                                        ================================== -->

                                        <div
                                            class="flex
                                                   flex-col-reverse
                                                   sm:flex-row
                                                   sm:items-center
                                                   sm:justify-end
                                                   gap-3
                                                   mt-7
                                                   pt-5
                                                   border-t
                                                   border-gray-100"
                                        >

                                            <a
                                                href="/admin/customers/<%= customerRecord.id %>"
                                                class="admin-secondary-button"
                                            >
                                                Cancel
                                            </a>


                                            <button
                                                type="submit"
                                                class="admin-primary-button"
                                            >

                                                <i
                                                    data-lucide="save"
                                                    class="h-4 w-4"
                                                ></i>

                                                Save Financial Values

                                            </button>

                                        </div>

                                    </div>

                                </form>

                            </section>

                        <% } %>

                    </div>

                </div>

            </main>

        </div>

    </div>


    <%- include("../partials/scripts") %>

</body>

</html>