<%
    const customerRecords =
        typeof customers !== "undefined" &&
        Array.isArray(customers)
            ? customers
            : [];

    const activeCustomers =
        customerRecords.filter(
            customer =>
                customer &&
                customer.status === "Active"
        );

    const pendingCustomers =
        customerRecords.filter(
            customer =>
                customer &&
                (
                    customer.status === "Pending" ||
                    customer.status === "Under Review"
                )
        );

    const suspendedCustomers =
        customerRecords.filter(
            customer =>
                customer &&
                customer.status === "Suspended"
        );
%>


<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head") %>
</head>


<body class="font-sans bg-gray-50">

    <!-- <%- include("../partials/loader") %> -->


    <div
        x-data="{
            mobileMenuOpen: false,
            customerFilter: 'all',
            search: ''
        }"
        class="admin-app-shell
               flex h-screen
               overflow-hidden"
    >

        <!-- =====================================
             SIDEBAR
        ====================================== -->

        <%- include("../partials/sidebar") %>


        <!-- =====================================
             MAIN AREA
        ====================================== -->

        <div
            class="admin-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("../partials/topbar") %>

            <%- include("../partials/mobile-menu") %>


            <main class="admin-main-content">

                <div class="py-6">

                    <div
                        class="max-w-7xl
                               mx-auto
                               px-4
                               sm:px-6
                               lg:px-8"
                    >

                        <!-- =================================
                             HEADER
                        ================================== -->

                        <div
                            class="flex
                                   flex-col
                                   md:flex-row
                                   md:items-center
                                   md:justify-between
                                   gap-4
                                   mb-7"
                        >

                            <div>

                                <h1
                                    class="text-2xl
                                           font-bold
                                           text-gray-900"
                                >
                                    Customers
                                </h1>


                                <p
                                    class="text-sm
                                           text-gray-500
                                           mt-1"
                                >
                                    Manage customer accounts
                                    and dashboard information.
                                </p>

                            </div>


                            <a
                                href="/admin/registrations"
                                class="admin-primary-button"
                            >

                                <i
                                    data-lucide="user-plus"
                                    class="h-4 w-4"
                                ></i>

                                Registrations

                            </a>

                        </div>


                        <!-- =================================
                             CUSTOMER COUNTS
                        ================================== -->

                        <div
                            class="grid
                                   grid-cols-1
                                   sm:grid-cols-2
                                   xl:grid-cols-4
                                   gap-4
                                   mb-6"
                        >

                            <!-- Total -->

                            <div class="admin-stat-card">

                                <div>

                                    <p class="admin-stat-label">
                                        Total Customers
                                    </p>


                                    <p class="admin-stat-value">
                                        <%= customerRecords.length %>
                                    </p>

                                </div>


                                <div
                                    class="admin-stat-icon
                                           bg-blue-50
                                           text-blue-700"
                                >

                                    <i data-lucide="users"></i>

                                </div>

                            </div>


                            <!-- Active -->

                            <div class="admin-stat-card">

                                <div>

                                    <p class="admin-stat-label">
                                        Active
                                    </p>


                                    <p
                                        class="admin-stat-value
                                               text-green-700"
                                    >
                                        <%= activeCustomers.length %>
                                    </p>

                                </div>


                                <div
                                    class="admin-stat-icon
                                           bg-green-50
                                           text-green-700"
                                >

                                    <i
                                        data-lucide="user-check"
                                    ></i>

                                </div>

                            </div>


                            <!-- Pending -->

                            <div class="admin-stat-card">

                                <div>

                                    <p class="admin-stat-label">
                                        Pending
                                    </p>


                                    <p
                                        class="admin-stat-value
                                               text-yellow-700"
                                    >
                                        <%= pendingCustomers.length %>
                                    </p>

                                </div>


                                <div
                                    class="admin-stat-icon
                                           bg-yellow-50
                                           text-yellow-700"
                                >

                                    <i data-lucide="clock"></i>

                                </div>

                            </div>


                            <!-- Suspended -->

                            <div class="admin-stat-card">

                                <div>

                                    <p class="admin-stat-label">
                                        Suspended
                                    </p>


                                    <p
                                        class="admin-stat-value
                                               text-red-700"
                                    >
                                        <%= suspendedCustomers.length %>
                                    </p>

                                </div>


                                <div
                                    class="admin-stat-icon
                                           bg-red-50
                                           text-red-700"
                                >

                                    <i data-lucide="user-x"></i>

                                </div>

                            </div>

                        </div>


                        <!-- =================================
                             SEARCH / FILTERS
                        ================================== -->

                        <div
                            class="admin-panel
                                   p-4
                                   mb-6"
                        >

                            <div
                                class="flex
                                       flex-col
                                       lg:flex-row
                                       lg:items-center
                                       gap-4"
                            >

                                <!-- Search -->

                                <div
                                    class="relative
                                           flex-1"
                                >

                                    <i
                                        data-lucide="search"
                                        class="absolute
                                               left-3
                                               top-1/2
                                               -translate-y-1/2
                                               h-5 w-5
                                               text-gray-400
                                               pointer-events-none"
                                    ></i>


                                    <input
                                        type="search"
                                        x-model="search"
                                        placeholder="Search name, email, username or customer ID..."
                                        class="admin-input
                                               pl-10"
                                    >

                                </div>


                                <!-- Status -->

                                <div
                                    class="flex
                                           flex-wrap
                                           gap-2"
                                >

                                    <button
                                        type="button"
                                        @click="
                                            customerFilter =
                                                'all'
                                        "
                                        :class="
                                            customerFilter ===
                                                'all'
                                                ? 'bg-primary-600 text-white'
                                                : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                                        "
                                        class="px-4 py-2
                                               rounded-lg
                                               text-sm
                                               font-medium
                                               transition-colors"
                                    >
                                        All
                                    </button>


                                    <button
                                        type="button"
                                        @click="
                                            customerFilter =
                                                'active'
                                        "
                                        :class="
                                            customerFilter ===
                                                'active'
                                                ? 'bg-primary-600 text-white'
                                                : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                                        "
                                        class="px-4 py-2
                                               rounded-lg
                                               text-sm
                                               font-medium
                                               transition-colors"
                                    >
                                        Active
                                    </button>


                                    <button
                                        type="button"
                                        @click="
                                            customerFilter =
                                                'pending'
                                        "
                                        :class="
                                            customerFilter ===
                                                'pending'
                                                ? 'bg-primary-600 text-white'
                                                : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                                        "
                                        class="px-4 py-2
                                               rounded-lg
                                               text-sm
                                               font-medium
                                               transition-colors"
                                    >
                                        Pending
                                    </button>


                                    <button
                                        type="button"
                                        @click="
                                            customerFilter =
                                                'suspended'
                                        "
                                        :class="
                                            customerFilter ===
                                                'suspended'
                                                ? 'bg-primary-600 text-white'
                                                : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                                        "
                                        class="px-4 py-2
                                               rounded-lg
                                               text-sm
                                               font-medium
                                               transition-colors"
                                    >
                                        Suspended
                                    </button>

                                </div>

                            </div>

                        </div>


                        <!-- =================================
                             CUSTOMER TABLE
                        ================================== -->

                        <section class="admin-panel">

                            <div class="admin-panel-header">

                                <div>

                                    <h3>
                                        Customer Accounts
                                    </h3>


                                    <p
                                        class="text-xs
                                               text-gray-500
                                               mt-1"
                                    >
                                        Approved and registered
                                        customer accounts appear here.
                                    </p>

                                </div>

                            </div>


                            <% if (
                                customerRecords.length === 0
                            ) { %>

                                <!-- Empty State -->

                                <div class="admin-empty-state">

                                    <div
                                        class="h-14 w-14
                                               rounded-full
                                               bg-gray-100
                                               flex
                                               items-center
                                               justify-center
                                               mb-4"
                                    >

                                        <i
                                            data-lucide="users"
                                            class="h-7 w-7
                                                   text-gray-400"
                                        ></i>

                                    </div>


                                    <h3
                                        class="text-base
                                               font-semibold
                                               text-gray-900"
                                    >
                                        No customer accounts
                                    </h3>


                                    <p
                                        class="text-sm
                                               text-gray-500
                                               mt-2"
                                    >
                                        Approved customer accounts
                                        will appear here.
                                    </p>

                                </div>


                            <% } else { %>

                                <div class="overflow-x-auto">

                                    <table
                                        class="min-w-full
                                               divide-y
                                               divide-gray-200"
                                    >

                                        <thead class="bg-gray-50">

                                            <tr>

                                                <th class="admin-table-heading">
                                                    Customer
                                                </th>

                                                <th class="admin-table-heading">
                                                    Customer ID
                                                </th>

                                                <th class="admin-table-heading">
                                                    Account
                                                </th>

                                                <th class="admin-table-heading">
                                                    Displayed Balance
                                                </th>

                                                <th class="admin-table-heading">
                                                    KYC
                                                </th>

                                                <th class="admin-table-heading">
                                                    Status
                                                </th>

                                                <th
                                                    class="admin-table-heading
                                                           text-right"
                                                >
                                                    Actions
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody
                                            class="bg-white
                                                   divide-y
                                                   divide-gray-100"
                                        >

                                            <% customerRecords.forEach(
                                                function(customer) {

                                                    const account =
                                                        customer.account ||
                                                        null;

                                                    const values =
                                                        customer.dashboardValues ||
                                                        null;

                                                    const balance =
                                                        values &&
                                                        values.displayedBalance !==
                                                            undefined &&
                                                        values.displayedBalance !==
                                                            null
                                                            ? Number(
                                                                values.displayedBalance
                                                              )
                                                            : 0;

                                                    const balanceCurrency =
                                                        customer.currency ||
                                                        (
                                                            account &&
                                                            account.currency
                                                                ? account.currency
                                                                : ""
                                                        );

                                                    const kycStatus =
                                                        customer.kyc &&
                                                        customer.kyc.status
                                                            ? customer.kyc.status
                                                            : "Not Submitted";
                                            %>

                                                <tr
                                                    x-show="
                                                        (
                                                            customerFilter ===
                                                                'all' ||

                                                            (
                                                                customerFilter ===
                                                                    'active' &&
                                                                '<%= customer.status || "" %>' ===
                                                                    'Active'
                                                            ) ||

                                                            (
                                                                customerFilter ===
                                                                    'pending' &&
                                                                (
                                                                    '<%= customer.status || "" %>' ===
                                                                        'Pending' ||

                                                                    '<%= customer.status || "" %>' ===
                                                                        'Under Review'
                                                                )
                                                            ) ||

                                                            (
                                                                customerFilter ===
                                                                    'suspended' &&
                                                                '<%= customer.status || "" %>' ===
                                                                    'Suspended'
                                                            )
                                                        ) &&

                                                        (
                                                            !search ||

                                                            '<%= [
                                                                customer.fullName,
                                                                customer.email,
                                                                customer.username,
                                                                customer.customerId
                                                            ]
                                                                .filter(Boolean)
                                                                .join(" ")
                                                                .replace(/'/g, "\\'")
                                                                .toLowerCase()
                                                            %>'.includes(
                                                                search.toLowerCase()
                                                            )
                                                        )
                                                    "
                                                >

                                                    <!-- Customer -->

                                                    <td
                                                        class="px-6
                                                               py-4"
                                                    >

                                                        <div
                                                            class="flex
                                                                   items-center"
                                                        >

                                                            <div
                                                                class="h-10 w-10
                                                                       rounded-full
                                                                       bg-gray-100
                                                                       flex
                                                                       items-center
                                                                       justify-center
                                                                       mr-3
                                                                       flex-shrink-0"
                                                            >

                                                                <i
                                                                    data-lucide="user"
                                                                    class="h-5 w-5
                                                                           text-gray-500"
                                                                ></i>

                                                            </div>


                                                            <div class="min-w-0">

                                                                <p
                                                                    class="text-sm
                                                                           font-medium
                                                                           text-gray-900"
                                                                >
                                                                    <%= customer.fullName || "" %>
                                                                </p>


                                                                <% if (
                                                                    customer.email
                                                                ) { %>

                                                                    <p
                                                                        class="text-xs
                                                                               text-gray-500
                                                                               mt-1"
                                                                    >
                                                                        <%= customer.email %>
                                                                    </p>

                                                                <% } %>


                                                                <% if (
                                                                    customer.username
                                                                ) { %>

                                                                    <p
                                                                        class="text-xs
                                                                               text-gray-400
                                                                               mt-0.5"
                                                                    >
                                                                        @<%= customer.username %>
                                                                    </p>

                                                                <% } %>

                                                            </div>

                                                        </div>

                                                    </td>


                                                    <!-- Customer ID -->

                                                    <td class="admin-table-cell">

                                                        <%= customer.customerId || "" %>

                                                    </td>


                                                    <!-- Account -->

                                                    <td class="admin-table-cell">

                                                        <% if (account) { %>

                                                            <% if (
                                                                account.accountType
                                                            ) { %>

                                                                <p
                                                                    class="font-medium
                                                                           text-gray-700"
                                                                >
                                                                    <%= account.accountType %>
                                                                </p>

                                                            <% } %>


                                                            <% if (
                                                                account.accountNumber &&
                                                                account.accountNumber !==
                                                                    customer.customerId
                                                            ) { %>

                                                                <p
                                                                    class="text-xs
                                                                           text-gray-400
                                                                           mt-1"
                                                                >
                                                                    <%= account.accountNumber %>
                                                                </p>

                                                            <% } %>

                                                        <% } else { %>

                                                            <span
                                                                class="text-gray-400"
                                                            >
                                                                No account
                                                            </span>

                                                        <% } %>

                                                    </td>


                                                    <!-- Balance -->

                                                    <td
                                                        class="admin-table-cell
                                                               font-semibold
                                                               text-gray-900"
                                                    >

                                                        <%= balanceCurrency %>

                                                        <%= balance.toLocaleString(
                                                            undefined,
                                                            {
                                                                minimumFractionDigits: 2,
                                                                maximumFractionDigits: 2
                                                            }
                                                        ) %>

                                                    </td>


                                                    <!-- KYC -->

                                                    <td class="px-6 py-4">

                                                        <span
                                                            class="admin-badge
                                                                   <%= kycStatus === "Verified"
                                                                       ? "bg-green-50 text-green-700"
                                                                       : kycStatus === "Rejected"
                                                                       ? "bg-red-50 text-red-700"
                                                                       : kycStatus === "Pending"
                                                                       ? "bg-yellow-50 text-yellow-700"
                                                                       : "bg-gray-100 text-gray-600"
                                                                   %>"
                                                        >
                                                            <%= kycStatus %>
                                                        </span>

                                                    </td>


                                                    <!-- Status -->

                                                    <td class="px-6 py-4">

                                                        <span
                                                            class="admin-badge
                                                                   <%= customer.status === "Active"
                                                                       ? "bg-green-50 text-green-700"
                                                                       : customer.status === "Suspended"
                                                                       ? "bg-red-50 text-red-700"
                                                                       : customer.status === "Pending"
                                                                       ? "bg-yellow-50 text-yellow-700"
                                                                       : "bg-gray-100 text-gray-600"
                                                                   %>"
                                                        >
                                                            <%= customer.status || "" %>
                                                        </span>

                                                    </td>


                                                    <!-- Actions -->

                                                    <td
                                                        class="px-6 py-4
                                                               text-right"
                                                    >

                                                        <% if (
                                                            customer.id
                                                        ) { %>

                                                            <a
                                                                href="/admin/customers/<%= customer.id %>"
                                                                class="admin-small-button"
                                                            >

                                                                Manage

                                                                <i
                                                                    data-lucide="arrow-right"
                                                                    class="h-3.5 w-3.5"
                                                                ></i>

                                                            </a>

                                                        <% } %>

                                                    </td>

                                                </tr>

                                            <% }); %>

                                        </tbody>

                                    </table>

                                </div>

                            <% } %>

                        </section>

                    </div>

                </div>

            </main>

        </div>

    </div>


    <%- include("../partials/scripts") %>

</body>

</html>