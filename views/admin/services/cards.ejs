<%
    const cardRecords =
        typeof cards !== "undefined" &&
        Array.isArray(cards)
            ? cards
            : [];

    const activeCards =
        cardRecords.filter(
            card =>
                card &&
                card.status === "Active"
        );

    const pendingCards =
        cardRecords.filter(
            card =>
                card &&
                card.status === "Pending"
        );

    const frozenCards =
        cardRecords.filter(
            card =>
                card &&
                card.status === "Frozen"
        );
%>


<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head") %>
</head>


<body class="bg-gray-50">

    <%- include("../partials/loader") %>


    <div
        x-data="{
            mobileMenuOpen: false,
            cardFilter: 'all',
            search: ''
        }"
        class="admin-app-shell
               flex h-screen
               overflow-hidden"
    >

        <%- include("../partials/sidebar") %>


        <div
            class="admin-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("../partials/topbar") %>

            <%- include("../partials/mobile-menu") %>


            <main class="admin-main-content">

                <div class="py-6">

                    <div
                        class="max-w-7xl
                               mx-auto
                               px-4
                               sm:px-6
                               lg:px-8"
                    >

                        <!-- =================================
                             HEADER
                        ================================== -->

                        <div
                            class="flex
                                   flex-col
                                   sm:flex-row
                                   sm:items-center
                                   sm:justify-between
                                   gap-4
                                   mb-6"
                        >

                            <div>

                                <h1
                                    class="text-2xl
                                           font-bold
                                           text-gray-900"
                                >
                                    Cards
                                </h1>


                                <p
                                    class="text-sm
                                           text-gray-500
                                           mt-1"
                                >
                                    Create and manage customer cards.
                                </p>

                            </div>


                            <a
                                href="/admin/cards/create"
                                class="admin-primary-button"
                            >

                                <i
                                    data-lucide="plus"
                                    class="h-4 w-4"
                                ></i>

                                Create Card

                            </a>

                        </div>


                        <!-- =================================
                             SUMMARY
                        ================================== -->

                        <div
                            class="grid
                                   grid-cols-1
                                   sm:grid-cols-2
                                   xl:grid-cols-4
                                   gap-4
                                   mb-6"
                        >

                            <div class="admin-stat-card">

                                <div>

                                    <p class="admin-stat-label">
                                        Total Cards
                                    </p>

                                    <p class="admin-stat-value">
                                        <%= cardRecords.length %>
                                    </p>

                                </div>


                                <div
                                    class="admin-stat-icon
                                           bg-blue-50
                                           text-blue-700"
                                >
                                    <i data-lucide="credit-card"></i>
                                </div>

                            </div>


                            <div class="admin-stat-card">

                                <div>

                                    <p class="admin-stat-label">
                                        Active
                                    </p>

                                    <p
                                        class="admin-stat-value
                                               text-green-700"
                                    >
                                        <%= activeCards.length %>
                                    </p>

                                </div>


                                <div
                                    class="admin-stat-icon
                                           bg-green-50
                                           text-green-700"
                                >
                                    <i data-lucide="circle-check"></i>
                                </div>

                            </div>


                            <div class="admin-stat-card">

                                <div>

                                    <p class="admin-stat-label">
                                        Pending
                                    </p>

                                    <p
                                        class="admin-stat-value
                                               text-yellow-700"
                                    >
                                        <%= pendingCards.length %>
                                    </p>

                                </div>


                                <div
                                    class="admin-stat-icon
                                           bg-yellow-50
                                           text-yellow-700"
                                >
                                    <i data-lucide="clock"></i>
                                </div>

                            </div>


                            <div class="admin-stat-card">

                                <div>

                                    <p class="admin-stat-label">
                                        Frozen
                                    </p>

                                    <p
                                        class="admin-stat-value
                                               text-blue-700"
                                    >
                                        <%= frozenCards.length %>
                                    </p>

                                </div>


                                <div
                                    class="admin-stat-icon
                                           bg-blue-50
                                           text-blue-700"
                                >
                                    <i data-lucide="snowflake"></i>
                                </div>

                            </div>

                        </div>


                        <!-- =================================
                             FILTERS
                        ================================== -->

                        <div
                            class="admin-panel
                                   p-4
                                   mb-6"
                        >

                            <div
                                class="flex
                                       flex-col
                                       lg:flex-row
                                       lg:items-center
                                       gap-4"
                            >

                                <div
                                    class="relative
                                           flex-1"
                                >

                                    <i
                                        data-lucide="search"
                                        class="absolute
                                               left-3
                                               top-1/2
                                               -translate-y-1/2
                                               h-4 w-4
                                               text-gray-400
                                               pointer-events-none"
                                    ></i>


                                    <input
                                        type="search"
                                        x-model="search"
                                        class="admin-input pl-9"
                                        placeholder="Search customer, card name or last four..."
                                    >

                                </div>


                                <div
                                    class="flex
                                           flex-wrap
                                           gap-2"
                                >

                                    <button
                                        type="button"
                                        @click="cardFilter = 'all'"
                                        :class="
                                            cardFilter === 'all'
                                                ? 'bg-primary-600 text-white'
                                                : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                                        "
                                        class="px-4 py-2
                                               rounded-lg
                                               text-sm
                                               font-medium"
                                    >
                                        All
                                    </button>


                                    <button
                                        type="button"
                                        @click="cardFilter = 'active'"
                                        :class="
                                            cardFilter === 'active'
                                                ? 'bg-primary-600 text-white'
                                                : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                                        "
                                        class="px-4 py-2
                                               rounded-lg
                                               text-sm
                                               font-medium"
                                    >
                                        Active
                                    </button>


                                    <button
                                        type="button"
                                        @click="cardFilter = 'pending'"
                                        :class="
                                            cardFilter === 'pending'
                                                ? 'bg-primary-600 text-white'
                                                : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                                        "
                                        class="px-4 py-2
                                               rounded-lg
                                               text-sm
                                               font-medium"
                                    >
                                        Pending
                                    </button>


                                    <button
                                        type="button"
                                        @click="cardFilter = 'frozen'"
                                        :class="
                                            cardFilter === 'frozen'
                                                ? 'bg-primary-600 text-white'
                                                : 'bg-gray-100 text-gray-600 hover:bg-gray-200'
                                        "
                                        class="px-4 py-2
                                               rounded-lg
                                               text-sm
                                               font-medium"
                                    >
                                        Frozen
                                    </button>

                                </div>

                            </div>

                        </div>


                        <!-- =================================
                             CARD RECORDS
                        ================================== -->

                        <section class="admin-panel">

                            <div class="admin-panel-header">

                                <div>

                                    <h3>
                                        Customer Cards
                                    </h3>


                                    <p
                                        class="text-xs
                                               text-gray-500
                                               mt-1"
                                    >
                                        Cards assigned to customer accounts.
                                    </p>

                                </div>

                            </div>


                            <% if (
                                cardRecords.length === 0
                            ) { %>

                                <div class="admin-empty-state">

                                    <div
                                        class="h-14 w-14
                                               rounded-full
                                               bg-gray-100
                                               flex
                                               items-center
                                               justify-center
                                               mb-4"
                                    >
                                        <i
                                            data-lucide="credit-card"
                                            class="h-7 w-7
                                                   text-gray-400"
                                        ></i>
                                    </div>


                                    <h3
                                        class="text-base
                                               font-semibold
                                               text-gray-900"
                                    >
                                        No card records
                                    </h3>


                                    <p
                                        class="text-sm
                                               text-gray-500
                                               mt-2"
                                    >
                                        Create a card and assign it
                                        to an active customer.
                                    </p>


                                    <a
                                        href="/admin/cards/create"
                                        class="admin-primary-button
                                               mt-5"
                                    >
                                        Create Card
                                    </a>

                                </div>


                            <% } else { %>

                                <div class="overflow-x-auto">

                                    <table
                                        class="min-w-full
                                               divide-y
                                               divide-gray-200"
                                    >

                                        <thead class="bg-gray-50">

                                            <tr>

                                                <th class="admin-table-heading">
                                                    Customer
                                                </th>

                                                <th class="admin-table-heading">
                                                    Card
                                                </th>

                                                <th class="admin-table-heading">
                                                    Type
                                                </th>

                                                <th class="admin-table-heading">
                                                    Currency
                                                </th>

                                                <th class="admin-table-heading">
                                                    Limit
                                                </th>

                                                <th class="admin-table-heading">
                                                    Status
                                                </th>

                                                <th class="admin-table-heading">
                                                    Action
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody
                                            class="bg-white
                                                   divide-y
                                                   divide-gray-100"
                                        >

                                            <% cardRecords.forEach(
                                                function(record) {

                                                    const recordCustomer =
                                                        record.customer ||
                                                        null;

                                                    const customerName =
                                                        recordCustomer
                                                            ? [
                                                                recordCustomer.firstName,
                                                                recordCustomer.middleName,
                                                                recordCustomer.lastName
                                                              ]
                                                                .filter(Boolean)
                                                                .join(" ")
                                                            : "";

                                                    const searchableText = [
                                                        customerName,
                                                        recordCustomer
                                                            ? recordCustomer.email
                                                            : "",
                                                        record.displayName,
                                                        record.lastFour,
                                                        record.type
                                                    ]
                                                        .filter(Boolean)
                                                        .join(" ")
                                                        .replace(/'/g, "\\'")
                                                        .toLowerCase();
                                            %>

                                                <tr
                                                    x-show="
                                                        (
                                                            cardFilter === 'all' ||

                                                            (
                                                                cardFilter === 'active' &&
                                                                '<%= record.status || "" %>' ===
                                                                    'Active'
                                                            ) ||

                                                            (
                                                                cardFilter === 'pending' &&
                                                                '<%= record.status || "" %>' ===
                                                                    'Pending'
                                                            ) ||

                                                            (
                                                                cardFilter === 'frozen' &&
                                                                '<%= record.status || "" %>' ===
                                                                    'Frozen'
                                                            )
                                                        ) &&

                                                        (
                                                            !search ||

                                                            '<%= searchableText %>'.includes(
                                                                search.toLowerCase()
                                                            )
                                                        )
                                                    "
                                                >

                                                    <!-- Customer -->

                                                    <td class="px-6 py-4">

                                                        <% if (
                                                            recordCustomer
                                                        ) { %>

                                                            <div
                                                                class="flex
                                                                       items-center"
                                                            >

                                                                <div
                                                                    class="h-10 w-10
                                                                           rounded-full
                                                                           bg-gray-100
                                                                           flex
                                                                           items-center
                                                                           justify-center
                                                                           mr-3
                                                                           flex-shrink-0"
                                                                >
                                                                    <i
                                                                        data-lucide="user"
                                                                        class="h-5 w-5
                                                                               text-gray-500"
                                                                    ></i>
                                                                </div>


                                                                <div class="min-w-0">

                                                                    <p
                                                                        class="text-sm
                                                                               font-medium
                                                                               text-gray-900"
                                                                    >
                                                                        <%= customerName %>
                                                                    </p>


                                                                    <% if (
                                                                        recordCustomer.email
                                                                    ) { %>

                                                                        <p
                                                                            class="text-xs
                                                                                   text-gray-500
                                                                                   mt-1"
                                                                        >
                                                                            <%= recordCustomer.email %>
                                                                        </p>

                                                                    <% } %>

                                                                </div>

                                                            </div>

                                                        <% } else { %>

                                                            <span
                                                                class="text-sm
                                                                       text-gray-400"
                                                            >
                                                                Customer unavailable
                                                            </span>

                                                        <% } %>

                                                    </td>


                                                    <!-- Card -->

                                                    <td class="admin-table-cell">

                                                        <p
                                                            class="font-medium
                                                                   text-gray-800"
                                                        >
                                                            <%= record.displayName || record.type || "" %>
                                                        </p>


                                                        <p
                                                            class="text-xs
                                                                   text-gray-400
                                                                   mt-1"
                                                        >
                                                            •••• <%= record.lastFour || "" %>
                                                            <% if (record.expiry) { %>
                                                                · <%= record.expiry %>
                                                            <% } %>
                                                        </p>

                                                    </td>


                                                    <!-- Type -->

                                                    <td class="admin-table-cell">
                                                        <%= record.type || "" %>
                                                    </td>


                                                    <!-- Currency -->

                                                    <td class="admin-table-cell">
                                                        <%= record.currency || "" %>
                                                    </td>


                                                    <!-- Limit -->

                                                    <td
                                                        class="admin-table-cell
                                                               font-semibold"
                                                    >
                                                        <%= record.currency || "" %>

                                                        <%= Number(
                                                            record.spendingLimit ||
                                                            0
                                                        ).toLocaleString(
                                                            undefined,
                                                            {
                                                                minimumFractionDigits: 2,
                                                                maximumFractionDigits: 2
                                                            }
                                                        ) %>
                                                    </td>


                                                    <!-- Status -->

                                                    <td class="px-6 py-4">

                                                        <span
                                                            class="admin-badge
                                                                   <%= record.status === "Active"
                                                                       ? "bg-green-50 text-green-700"
                                                                       : record.status === "Frozen"
                                                                       ? "bg-blue-50 text-blue-700"
                                                                       : record.status === "Pending"
                                                                       ? "bg-yellow-50 text-yellow-700"
                                                                       : record.status === "Expired"
                                                                       ? "bg-red-50 text-red-700"
                                                                       : "bg-gray-100 text-gray-600"
                                                                   %>"
                                                        >
                                                            <%= record.status || "" %>
                                                        </span>

                                                    </td>


                                                    <!-- Action -->

                                                    <td class="px-6 py-4">

                                                        <% if (
                                                            record._id ||
                                                            record.id
                                                        ) { %>

                                                            <a
                                                                href="/admin/cards/<%= record._id || record.id %>"
                                                                class="admin-small-button"
                                                            >
                                                                Manage

                                                                <i
                                                                    data-lucide="arrow-right"
                                                                    class="h-3.5 w-3.5"
                                                                ></i>
                                                            </a>

                                                        <% } %>

                                                    </td>

                                                </tr>

                                            <% }); %>

                                        </tbody>

                                    </table>

                                </div>

                            <% } %>

                        </section>

                    </div>

                </div>

            </main>

        </div>

    </div>


    <%- include("../partials/scripts") %>

</body>

</html>