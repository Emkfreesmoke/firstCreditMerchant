<%
    const customerRecords =
        typeof customers !== "undefined" &&
        Array.isArray(customers)
            ? customers
            : [];

    const oldForm =
        typeof formData !== "undefined" &&
        formData
            ? formData
            : {};

    const selectedId =
        oldForm.customerId ||
        (
            typeof selectedCustomerId !== "undefined"
                ? selectedCustomerId
                : ""
        );
%>

<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("../partials/head") %>
</head>

<body class="bg-gray-50">

    <%- include("../partials/loader") %>

    <div
        x-data="{ mobileMenuOpen: false }"
        class="admin-app-shell
               flex h-screen
               overflow-hidden"
    >

        <%- include("../partials/sidebar") %>

        <div
            class="admin-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("../partials/topbar") %>

            <%- include("../partials/mobile-menu") %>

            <main class="admin-main-content">

                <div class="py-6">

                    <div
                        class="max-w-5xl
                               mx-auto
                               px-4
                               sm:px-6
                               lg:px-8"
                    >

                        <a
                            href="/admin/loans"
                            class="inline-flex
                                   items-center
                                   text-sm
                                   text-gray-500
                                   hover:text-gray-700
                                   mb-6"
                        >
                            <i
                                data-lucide="arrow-left"
                                class="h-4 w-4 mr-2"
                            ></i>

                            Back to Loans
                        </a>


                        <div class="mb-6">

                            <h1
                                class="text-2xl
                                       font-bold
                                       text-gray-900"
                            >
                                Create Loan
                            </h1>

                            <p
                                class="text-sm
                                       text-gray-500
                                       mt-1"
                            >
                                Create a loan record for an
                                active customer.
                            </p>

                        </div>


                        <% if (
                            typeof error !== "undefined" &&
                            error
                        ) { %>

                            <div
                                class="mb-6
                                       px-4 py-4
                                       bg-red-50
                                       border
                                       border-red-200
                                       rounded-xl"
                            >

                                <div class="flex items-start">

                                    <i
                                        data-lucide="circle-alert"
                                        class="h-5 w-5
                                               text-red-600
                                               mr-3
                                               mt-0.5"
                                    ></i>

                                    <p
                                        class="text-sm
                                               text-red-800"
                                    >
                                        <%= error %>
                                    </p>

                                </div>

                            </div>

                        <% } %>


                        <section class="admin-panel">

                            <div class="admin-panel-header">

                                <div>

                                    <h3>
                                        Loan Information
                                    </h3>

                                    <p
                                        class="text-xs
                                               text-gray-500
                                               mt-1"
                                    >
                                        Create an application or
                                        approved loan for a customer.
                                    </p>

                                </div>

                            </div>


                            <form
                                action="/admin/loans/create"
                                method="POST"
                                class="p-6"
                            >

                                <div
                                    class="grid
                                           grid-cols-1
                                           md:grid-cols-2
                                           gap-5"
                                >

                                    <!-- Customer -->

                                    <div class="md:col-span-2">

                                        <label
                                            for="customerId"
                                            class="admin-label"
                                        >
                                            Customer
                                        </label>

                                        <select
                                            id="customerId"
                                            name="customerId"
                                            class="admin-input"
                                            required
                                        >

                                            <option value="">
                                                Select customer
                                            </option>

                                            <% customerRecords.forEach(
                                                function(customer) {

                                                    const customerId =
                                                        customer.id ||
                                                        customer._id;

                                                    const label = [
                                                        customer.fullName,
                                                        customer.customerId
                                                    ]
                                                        .filter(Boolean)
                                                        .join(" · ");
                                            %>

                                                <option
                                                    value="<%= customerId %>"
                                                    <%= String(
                                                        customerId
                                                    ) === String(
                                                        selectedId
                                                    )
                                                        ? "selected"
                                                        : ""
                                                    %>
                                                >
                                                    <%= label || customerId %>
                                                </option>

                                            <% }); %>

                                        </select>

                                    </div>


                                    <!-- Type -->

                                    <div>

                                        <label
                                            for="loanType"
                                            class="admin-label"
                                        >
                                            Loan Type
                                        </label>

                                        <select
                                            id="loanType"
                                            name="type"
                                            class="admin-input"
                                            required
                                        >

                                            <option value="">
                                                Select loan type
                                            </option>

                                            <% [
                                                "Personal Loan",
                                                "Business Loan",
                                                "Education Loan",
                                                "Auto Loan",
                                                "Emergency Loan",
                                                "Other Loan"
                                            ].forEach(
                                                function(type) {
                                            %>

                                                <option
                                                    value="<%= type %>"
                                                    <%= oldForm.type === type
                                                        ? "selected"
                                                        : ""
                                                    %>
                                                >
                                                    <%= type %>
                                                </option>

                                            <% }); %>

                                        </select>

                                    </div>


                                    <!-- Requested Amount -->

                                    <div>

                                        <label
                                            for="requestedAmount"
                                            class="admin-label"
                                        >
                                            Requested Amount
                                        </label>

                                        <input
                                            id="requestedAmount"
                                            type="number"
                                            name="requestedAmount"
                                            min="0.01"
                                            step="0.01"
                                            value="<%= oldForm.requestedAmount || "" %>"
                                            class="admin-input"
                                            required
                                        >

                                    </div>


                                    <!-- Approved Amount -->

                                    <div>

                                        <label
                                            for="approvedAmount"
                                            class="admin-label"
                                        >
                                            Approved Amount
                                        </label>

                                        <input
                                            id="approvedAmount"
                                            type="number"
                                            name="approvedAmount"
                                            min="0"
                                            step="0.01"
                                            value="<%= oldForm.approvedAmount || "" %>"
                                            class="admin-input"
                                        >

                                    </div>


                                    <!-- Outstanding -->

                                    <div>

                                        <label
                                            for="outstandingAmount"
                                            class="admin-label"
                                        >
                                            Outstanding Amount
                                        </label>

                                        <input
                                            id="outstandingAmount"
                                            type="number"
                                            name="outstandingAmount"
                                            min="0"
                                            step="0.01"
                                            value="<%= oldForm.outstandingAmount || "" %>"
                                            class="admin-input"
                                        >

                                    </div>


                                    <!-- Monthly Payment -->

                                    <div>

                                        <label
                                            for="monthlyPayment"
                                            class="admin-label"
                                        >
                                            Monthly Payment
                                        </label>

                                        <input
                                            id="monthlyPayment"
                                            type="number"
                                            name="monthlyPayment"
                                            min="0"
                                            step="0.01"
                                            value="<%= oldForm.monthlyPayment || "" %>"
                                            class="admin-input"
                                        >

                                    </div>


                                    <!-- Interest -->

                                    <div>

                                        <label
                                            for="interestRate"
                                            class="admin-label"
                                        >
                                            Interest Rate (%)
                                        </label>

                                        <input
                                            id="interestRate"
                                            type="number"
                                            name="interestRate"
                                            min="0"
                                            step="0.01"
                                            value="<%= oldForm.interestRate || "" %>"
                                            class="admin-input"
                                        >

                                    </div>


                                    <!-- Term -->

                                    <div>

                                        <label
                                            for="loanTerm"
                                            class="admin-label"
                                        >
                                            Term
                                        </label>

                                        <select
                                            id="loanTerm"
                                            name="term"
                                            class="admin-input"
                                        >

                                            <option value="">
                                                Select term
                                            </option>

                                            <% [
                                                "3 Months",
                                                "6 Months",
                                                "12 Months",
                                                "24 Months",
                                                "36 Months",
                                                "60 Months"
                                            ].forEach(
                                                function(term) {
                                            %>

                                                <option
                                                    value="<%= term %>"
                                                    <%= oldForm.term === term
                                                        ? "selected"
                                                        : ""
                                                    %>
                                                >
                                                    <%= term %>
                                                </option>

                                            <% }); %>

                                        </select>

                                    </div>


                                    <!-- Initial Status -->

                                    <div>

                                        <label
                                            for="loanStatus"
                                            class="admin-label"
                                        >
                                            Initial Status
                                        </label>

                                        <select
                                            id="loanStatus"
                                            name="status"
                                            class="admin-input"
                                            required
                                        >

                                            <% [
                                                "Pending",
                                                "Under Review",
                                                "Approved",
                                                "Rejected"
                                            ].forEach(
                                                function(status) {
                                            %>

                                                <option
                                                    value="<%= status %>"
                                                    <%= (
                                                        oldForm.status ||
                                                        "Pending"
                                                    ) === status
                                                        ? "selected"
                                                        : ""
                                                    %>
                                                >
                                                    <%= status %>
                                                </option>

                                            <% }); %>

                                        </select>

                                    </div>


                                    <!-- Dates -->

                                    <div>

                                        <label
                                            for="startDate"
                                            class="admin-label"
                                        >
                                            Start Date
                                        </label>

                                        <input
                                            id="startDate"
                                            type="date"
                                            name="startDate"
                                            value="<%= oldForm.startDate || "" %>"
                                            class="admin-input"
                                        >

                                    </div>


                                    <div>

                                        <label
                                            for="endDate"
                                            class="admin-label"
                                        >
                                            End Date
                                        </label>

                                        <input
                                            id="endDate"
                                            type="date"
                                            name="endDate"
                                            value="<%= oldForm.endDate || "" %>"
                                            class="admin-input"
                                        >

                                    </div>


                                    <div>

                                        <label
                                            for="nextPaymentDate"
                                            class="admin-label"
                                        >
                                            Next Payment Date
                                        </label>

                                        <input
                                            id="nextPaymentDate"
                                            type="date"
                                            name="nextPaymentDate"
                                            value="<%= oldForm.nextPaymentDate || "" %>"
                                            class="admin-input"
                                        >

                                    </div>


                                    <!-- Purpose -->

                                    <div class="md:col-span-2">

                                        <label
                                            for="loanPurpose"
                                            class="admin-label"
                                        >
                                            Purpose
                                        </label>

                                        <textarea
                                            id="loanPurpose"
                                            name="purpose"
                                            rows="4"
                                            class="admin-input"
                                            placeholder="Purpose of the loan"
                                        ><%= oldForm.purpose || "" %></textarea>

                                    </div>


                                    <!-- Note -->

                                    <div class="md:col-span-2">

                                        <label
                                            for="adminNote"
                                            class="admin-label"
                                        >
                                            Admin Note
                                        </label>

                                        <textarea
                                            id="adminNote"
                                            name="adminNote"
                                            rows="4"
                                            class="admin-input"
                                            placeholder="Optional internal note"
                                        ><%= oldForm.adminNote || "" %></textarea>

                                    </div>

                                </div>


                                <div
                                    class="mt-6
                                           p-4
                                           bg-blue-50
                                           border
                                           border-blue-100
                                           rounded-lg"
                                >

                                    <div class="flex items-start">

                                        <i
                                            data-lucide="info"
                                            class="h-5 w-5
                                                   text-blue-600
                                                   mr-3
                                                   mt-0.5"
                                        ></i>

                                        <p
                                            class="text-sm
                                                   text-blue-800"
                                        >
                                            Creating an Approved loan
                                            does not credit the customer
                                            balance yet. Funding occurs
                                            only when the loan is activated.
                                        </p>

                                    </div>

                                </div>


                                <div
                                    class="flex
                                           flex-col-reverse
                                           sm:flex-row
                                           sm:justify-end
                                           gap-3
                                           mt-7"
                                >

                                    <a
                                        href="/admin/loans"
                                        class="admin-secondary-button"
                                    >
                                        Cancel
                                    </a>

                                    <button
                                        type="submit"
                                        class="admin-primary-button"
                                    >

                                        <i
                                            data-lucide="landmark"
                                            class="h-4 w-4"
                                        ></i>

                                        Create Loan

                                    </button>

                                </div>

                            </form>

                        </section>

                    </div>

                </div>

            </main>

        </div>

    </div>


    <%- include("../partials/scripts") %>

</body>

</html>