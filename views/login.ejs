<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta
      name="description"
      content="Swift and Secure Money Transfer to any bank account with First Credit Merchant."
    />

    <title><%= title || "Account Login - First Credit Merchant" %></title>

    <!-- Favicon -->

    <link
      rel="shortcut icon"
      type="image/png"
      href="https://i.postimg.cc/6qdzfgQL/favicon.png"
    />

    <!-- Google Font -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />

    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link href="https://fonts.googleapis.com" rel="stylesheet" />

    <!-- Tailwind -->

    <script defer src="https://cdn.tailwindcss.com"></script>

    <!-- Tailwind Configuration -->

    <!--
  <script src="/js/register-config.js"></script>
  -->

    <!-- Shared Authentication CSS -->

    <!--
  <link
    rel="stylesheet"
    href="/css/register.css"
  />
  -->

    <!-- Login CSS -->

    <link rel="stylesheet" href="/css/login.css?v=12" />

    <!-- Alpine -->

    <script
      defer
      src="https://cdn.jsdelivr.net/npm/alpinejs@3.x.x/dist/cdn.min.js"
    ></script>

    <!-- Lucide -->

    <script defer src="https://unpkg.com/lucide@latest"></script>
  </head>

  <body class="font-sans bg-gray-50 text-gray-900 flex min-h-screen">
    <!-- =====================================================
       LOGIN PAGE LOADER
  ====================================================== -->

    <%- include("sections/login/loader") %>

    <!-- =====================================================
       LOGIN PAGE
  ====================================================== -->

    <div class="w-full">
      <div class="flex flex-col lg:flex-row min-h-screen">
        <!-- Left Branding Panel -->

        <%- include("sections/login/branding") %>

        <!-- Login Form -->

        <%- include("sections/login/form") %>
      </div>
    </div>

    <!-- =====================================================
       LOGIN JAVASCRIPT
  ====================================================== -->

    <script src="/js/login.js?v=12"></script>

    <!-- =====================================================
       LOADER EMERGENCY FALLBACK
  ====================================================== -->

    <script>
      (function () {
        function forceRemoveLoginLoader() {
          var loader = document.querySelector(".page-loading");

          if (!loader) {
            return;
          }

          loader.classList.remove("active");

          loader.style.opacity = "0";

          loader.style.visibility = "hidden";

          loader.style.pointerEvents = "none";

          setTimeout(function () {
            if (loader && loader.parentNode) {
              loader.parentNode.removeChild(loader);
            }
          }, 450);
        }

        /*
         * Last-resort fallback.
         */

        setTimeout(forceRemoveLoginLoader, 2500);
      })();
    </script>
  </body>
</html>
