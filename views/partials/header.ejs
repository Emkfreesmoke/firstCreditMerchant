<!DOCTYPE html>
<html lang="en">
  <head>
    <!-- Meta -->

    <meta charset="UTF-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <meta
      name="description"
      content="First Credit Merchant - Your New Favorite Bank; credit cards, mortgages, commercial banking, auto loans, investing & retirement planning, checking and business banking."
    />

    <meta name="keywords" content="First Credit Merchant" />
    <meta name="author" content="inittheme" />

    <!-- Open Graph -->

    <meta property="og:type" content="website" />

    <meta
      property="og:title"
      content="First Credit Merchant - Your New Favorite Bank"
    />

    <meta
      property="og:image"
      content="https://i.postimg.cc/6qdzfgQL/favicon.png"
    />

    <meta
      property="og:site_name"
      content="First Credit Merchant - Your New Favorite Bank"
    />

    <meta property="og:url" content="/" />

    <meta
      property="og:description"
      content="First Credit Merchant - Your New Favorite Bank; credit cards, mortgages, commercial banking, auto loans, investing & retirement planning, checking and business banking."
    />

    <!-- Twitter -->

    <meta
      name="twitter:title"
      content="First Credit Merchant - Your New Favorite Bank"
    />

    <meta
      name="twitter:description"
      content="First Credit Merchant - Your New Favorite Bank; credit cards, mortgages, commercial banking, auto loans, investing & retirement planning, checking and business banking."
    />

    <meta name="twitter:card" content="summary" />

    <!-- Verification -->

    <meta name="google-site-verification" content="..." />
    <meta name="facebook-domain-verification" content="..." />

    <meta name="csrf-token" content="..." />
    <meta name="currency" content="$" />

    <!-- Title -->

    <title>
      <%= title || "First Credit Merchant - Your New Favorite Bank" %>
    </title>

    <!-- Favicon -->

    <link
      rel="shortcut icon"
      type="image/png"
      href="https://i.postimg.cc/6qdzfgQL/favicon.png"
    />

    <!-- Google Fonts -->

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=Onest:wght@100..900&display=swap"
      rel="stylesheet"
    />

    <!-- Bootstrap -->

    <link rel="stylesheet" href="/vendor/bootstrap/bootstrap.min.css" />

    <!-- SlickNav -->

    <link rel="stylesheet" href="/vendor/slicknav/slicknav.min.css" />

    <!-- Swiper -->

    <link rel="stylesheet" href="/vendor/swiper/swiper-bundle.min.css" />

    <!-- Font Awesome -->

    <link rel="stylesheet" href="/vendor/fontawesome/all.css" />

    <!-- Animate -->

    <link rel="stylesheet" href="/vendor/animate/animate.css" />

    <!-- Magnific Popup -->

    <link rel="stylesheet" href="/vendor/magnific-popup/magnific-popup.css" />

    <!-- Magic Cursor -->

    <link rel="stylesheet" href="/vendor/magiccursor/mousecursor.css" />

    <!-- Main stylesheet - keep this last -->

    <link rel="stylesheet" href="/css/style.css" />

    <!-- Yandex Translator (enable when needed) -->

    <!--
    <script src="/translate/js/yatranslate.js"></script>
    <link rel="stylesheet" href="/translate/css/yatranslate.css" />
    -->
  </head>

  <body>
    <!-- Preloader Start -->

    <div class="preloader">
      <div class="loading-container">
        <div class="loading"></div>

        <div id="loading-icon">
          <img src="/images/logo.png" alt="First Credit Merchant Logo" />
        </div>
      </div>
    </div>

    <!-- Preloader End -->
  </body>
</html>
