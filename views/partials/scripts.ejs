<!-- =====================================================
     PRELOADER FALLBACK
====================================================== -->

<script>
  window.addEventListener("load", function () {
    const preloader = document.querySelector(".preloader");

    if (preloader) {
      preloader.style.opacity = "0";
      preloader.style.visibility = "hidden";

      setTimeout(function () {
        preloader.remove();
      }, 400);
    }
  });

  // Prevent the preloader from trapping the page.
  setTimeout(function () {
    const preloader = document.querySelector(".preloader");

    if (preloader) {
      preloader.remove();
    }
  }, 3000);
</script>


<!-- =====================================================
     GLOBAL VIDEO AUTOPLAY AND LOOP CONFIGURATION
====================================================== -->

<script>
  (function () {
    "use strict";

    function initializeVideos() {
      const videos = document.querySelectorAll("video");

      videos.forEach(function (video) {

        // Configure video for mobile and desktop playback.
        video.setAttribute("autoplay", "");
        video.setAttribute("muted", "");
        video.setAttribute("loop", "");
        video.setAttribute("playsinline", "");
        video.setAttribute("webkit-playsinline", "");
        video.setAttribute("preload", "auto");

        video.muted = true;
        video.defaultMuted = true;
        video.autoplay = true;
        video.loop = true;
        video.playsInline = true;

        // Attempt playback when the video is ready.
        function startVideo() {
          if (video.error) {
            console.error(
              "Video loading error:",
              video.currentSrc,
              video.error
            );
            return;
          }

          if (!video.paused && !video.ended) {
            return;
          }

          const playback = video.play();

          if (playback && typeof playback.catch === "function") {
            playback.catch(function (error) {
              console.warn(
                "Video playback was prevented:",
                video.currentSrc,
                error.name,
                error.message
              );
            });
          }
        }

        // Start as soon as enough video data is available.
        video.addEventListener("loadeddata", startVideo);
        video.addEventListener("canplay", startVideo);

        // Handle videos that are already loaded.
        if (video.readyState >= 2) {
          startVideo();
        }

        // Report media loading errors.
        video.addEventListener("error", function () {
          console.error(
            "Unable to load video:",
            video.currentSrc,
            video.error
          );
        });
      });

      console.log(
        "Global video configuration initialized:",
        videos.length,
        "videos found."
      );
    }

    // Run after the page markup is available.
    if (document.readyState === "loading") {
      document.addEventListener(
        "DOMContentLoaded",
        initializeVideos
      );
    } else {
      initializeVideos();
    }

  })();
</script>


