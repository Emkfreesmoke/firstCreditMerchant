<!-- =====================================================
     CONTACT FORM START
====================================================== -->

<div class="contact-us-form">
  <div class="container">
    <!-- =========================================
             FORM HEADER
        ========================================== -->

    <div class="row section-row align-items-center">
      <div class="col-lg-8 col-md-9">
        <div class="section-title">
          <h3 class="wow fadeInUp">Contact Us</h3>

          <h2 class="text-anime-style-3" data-cursor="-opaque">
            Get in Touch With Our Financial Experts
          </h2>

          <p class="wow fadeInUp" data-wow-delay="0.2s">
            Have a question about your banking needs or our services? Send us a
            message and our team can assist you.
          </p>
        </div>
      </div>
    </div>

    <!-- =========================================
             FORM AREA
        ========================================== -->

    <div class="row align-items-center justify-content-center">
      <div class="col-lg-8">
        <div class="contact-form">
          <div class="contact-form-title wow fadeInUp">
            <h2>Have Any Questions?</h2>
          </div>

          <form
            action="/contact"
            method="POST"
            id="contactForm"
            class="wow fadeInUp"
            data-wow-delay="0.25s"
          >
            <div class="row">
              <!-- =========================
                                 FIRST NAME
                            ========================== -->

              <div class="form-group col-md-6 mb-4">
                <label for="fname" class="form-label"> First Name </label>

                <input
                  type="text"
                  name="fname"
                  class="form-control"
                  id="fname"
                  placeholder="First Name"
                  autocomplete="given-name"
                  required
                />
              </div>

              <!-- =========================
                                 LAST NAME
                            ========================== -->

              <div class="form-group col-md-6 mb-4">
                <label for="lname" class="form-label"> Last Name </label>

                <input
                  type="text"
                  name="lname"
                  class="form-control"
                  id="lname"
                  placeholder="Last Name"
                  autocomplete="family-name"
                  required
                />
              </div>

              <!-- =========================
                                 EMAIL
                            ========================== -->

              <div class="form-group col-md-6 mb-4">
                <label for="contact-email" class="form-label">
                  Email Address
                </label>

                <input
                  type="email"
                  name="email"
                  class="form-control"
                  id="contact-email"
                  placeholder="Email Address"
                  autocomplete="email"
                  required
                />
              </div>

              <!-- =========================
                                 PHONE
                            ========================== -->

              <div class="form-group col-md-6 mb-4">
                <label for="contact-phone" class="form-label">
                  Phone Number
                </label>

                <input
                  type="tel"
                  name="phone"
                  class="form-control"
                  id="contact-phone"
                  placeholder="Phone Number"
                  autocomplete="tel"
                  required
                />
              </div>

              <!-- =========================
                                 MESSAGE
                            ========================== -->

              <div class="form-group col-md-12 mb-4">
                <label for="contact-message" class="form-label">
                  Message
                </label>

                <textarea
                  name="message"
                  class="form-control"
                  id="contact-message"
                  rows="6"
                  placeholder="How can we help you?"
                  required
                ></textarea>
              </div>

              <!-- =========================
                                 SUBMIT
                            ========================== -->

              <div class="col-md-12">
                <button type="submit" class="btn-highlighted">
                  Submit Message
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- =====================================================
     CONTACT FORM END
====================================================== -->
