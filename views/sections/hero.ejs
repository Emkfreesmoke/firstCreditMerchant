<!-- =====================================================
     HERO SECTION START
====================================================== -->

<div class="hero">
  <div class="container">
    <div class="row align-items-center">
      <!-- =========================================
                 HERO CONTENT
            ========================================== -->

      <div class="col-lg-4 col-md-6 order-1">
        <div class="hero-content">
          <!-- Section Title -->

          <div class="section-title">
            <h3 class="wow fadeInUp">
              Welcome to First Credit Merchant International Financial and
              Security Firm
            </h3>

            <h1 class="text-anime-style-3" data-cursor="-opaque">
              Empowering your Day to Day Financing
            </h1>

            <p class="wow fadeInUp" data-wow-delay="0.25s">
              Seamless personal and institutional financial services available
              in person, online, or on your device.
            </p>
          </div>

          <!-- =================================
                         HERO ACTIONS
                    ================================== -->

          <div class="hero-content-form wow fadeInUp" data-wow-delay="0.4s">
            <div class="hero-account-actions">
              <!-- Register -->

              <a href="/register" class="hero-register-btn">
                <i class="fa-solid fa-user-plus" aria-hidden="true"></i>

                <span> Enrol New Account </span>
              </a>

              <!-- Login -->

              <a href="/login" class="hero-login-btn">
                <i class="fa-solid fa-right-to-bracket" aria-hidden="true"></i>

                <span> Login </span>
              </a>
            </div>
          </div>
        </div>
      </div>

      <!-- =========================================
                 HERO IMAGE
            ========================================== -->

      <div class="col-lg-4 order-lg-2 order-3">
        <div class="hero-images">
          <!-- Main Image -->

          <div class="hero-img">
            <figure class="image-anime">
              <img
                src="/images/hero-image.jpg"
                alt="First Credit Merchant banking services"
              />
            </figure>
          </div>

          <!-- Payment Method Overlay -->

          <div class="payment-method-image">
            <img src="/images/payment-method-image.png" alt="Payment method" />
          </div>
        </div>
      </div>

      <!-- =========================================
                 HERO COUNTERS
            ========================================== -->

      <div class="col-lg-4 col-md-6 order-lg-3 order-2">
        <div class="hero-counter-box">
          <!-- Counter 1 -->

          <div class="hero-counter-item">
            <h2><span class="counter"> 13 </span>M+</h2>

            <p class="wow fadeInUp">
              The first credit card ever issued was made of cardboard and was
              introduced by American Express in 1958.
            </p>
          </div>

          <!-- Counter 2 -->

          <div class="hero-counter-item">
            <h2><span class="counter"> 0 </span>%</h2>

            <p class="wow fadeInUp" data-wow-delay="0.25s">
              We believe that you should keep more of what you earn. That's why
              we're excited to offer a 0% commission.
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- =====================================================
     HERO SECTION END
====================================================== -->
