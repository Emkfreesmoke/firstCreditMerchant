<!-- Login Form Side Start -->
<div
  class="w-full lg:w-1/2 flex flex-col justify-center items-center p-6 lg:p-12"
>
  <div class="w-full max-w-md">
    <!-- Mobile Logo -->
    <div class="lg:hidden text-center mb-8">
      <a href="/">
        <img src="/images/logo.png" alt="First Credit Merchant" />
      </a>
    </div>

    <!-- Login Card -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
      <!-- Card Header -->
      <div class="px-8 pt-8 pb-6">
        <h2 class="text-2xl font-bold text-gray-900">
          Sign In to First Credit Merchant
        </h2>

        <p class="mt-2 text-sm text-gray-600">
          Access the First Credit Merchant panel using your username and
          password.
        </p>
      </div>

      <!-- Login Form -->
      <div class="px-8 pb-8">
        <form action="/login" method="POST" id="customer-login-form">
          <% if (typeof error !== "undefined" && error) { %>
            <div
              class="mb-6 px-4 py-3 bg-yellow-50 border border-yellow-200 rounded-lg"
            >
              <div class="flex items-start">
                <i
                  data-lucide="clock"
                  class="h-5 w-5 text-yellow-600 mr-3 mt-0.5 flex-shrink-0"
                ></i>
                <p class="text-sm text-yellow-800">
                  <%= error %>
                </p>
              </div>
            </div>
          <% } %>

          <!-- Username -->
          <div class="mb-6">
            <label
              for="email"
              class="block text-sm font-medium text-gray-700 mb-2"
            >
              Username
            </label>

            <div class="input-wrapper">
              <div style="position: relative; width: 100%;">
                <!-- Properly centered input icon -->
                <div
                  style="position: absolute; top: 50%; left: 14px; transform: translateY(-50%); display: flex; align-items: center; color: #94a3b8; pointer-events: none; z-index: 2;"
                >
                  <i data-lucide="user" style="width: 20px; height: 20px;"></i>
                </div>

                <!-- Input with padding-left to clear the icon -->
                <input
                  id="email"
                  type="text"
                  name="email"
                  style="width: 100%; min-height: 50px; padding-left: 45px; padding-right: 16px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 15px; outline: none;"
                  placeholder="Enter username"
                  required
                  autocomplete="username"
                />
              </div>
            </div>
          </div>

          <!-- Password -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-2">
              <label
                for="password"
                class="block text-sm font-medium text-gray-700"
              >
                Password
              </label>

              <a
                href="/forgot-password"
                class="text-sm font-medium text-primary-600 hover:text-primary-700"
              >
                Forgot password?
              </a>
            </div>

            <div class="input-wrapper">
              <div style="position: relative; width: 100%;">
                <!-- Properly centered lock icon -->
                <div
                  style="position: absolute; top: 50%; left: 14px; transform: translateY(-50%); display: flex; align-items: center; color: #94a3b8; pointer-events: none; z-index: 2;"
                >
                  <i data-lucide="lock" style="width: 20px; height: 20px;"></i>
                </div>

                <!-- Password Input with padding-left and padding-right for toggle button -->
                <input
                  id="password"
                  type="password"
                  name="password"
                  style="width: 100%; min-height: 50px; padding-left: 45px; padding-right: 45px; border: 1px solid #cbd5e1; border-radius: 8px; font-size: 15px; outline: none;"
                  placeholder="••••••••"
                  required
                  autocomplete="current-password"
                />

                <!-- Show / Hide Password Toggle -->
                <button
                  type="button"
                  id="password-toggle"
                  style="position: absolute; top: 0; right: 0; height: 100%; width: 45px; background: transparent; border: none; display: flex; align-items: center; justify-content: center; cursor: pointer; color: #94a3b8;"
                  aria-label="Show or hide password"
                >
                  <i
                    data-lucide="eye"
                    id="show-password"
                    style="width: 20px; height: 20px;"
                  ></i>

                  <i
                    data-lucide="eye-off"
                    id="hide-password"
                    style="width: 20px; height: 20px;"
                    class="hidden"
                  ></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Remember Me -->
          <div class="mb-6">
            <label class="inline-flex items-center">
              <input
                type="checkbox"
                name="remember_me"
                value="1"
                class="rounded border-gray-300 text-primary-600 shadow-sm focus:border-primary-300 focus:ring focus:ring-primary-200 focus:ring-opacity-50"
              />

              <span class="ml-2 text-sm text-gray-600"> Stay signed in </span>
            </label>
          </div>

          <!-- Login Actions -->
          <div class="flex flex-col space-y-4">
            <!-- Sign In Button -->
            <button
              type="submit"
              style="display: flex !important; width: 100% !important; min-height: 50px !important; background-color: #032d3f !important; color: #ffffff !important; padding: 12px 16px !important; border-radius: 8px !important; font-weight: 600 !important; align-items: center !important; justify-content: center !important; border: none !important; cursor: pointer !important; visibility: visible !important; opacity: 1 !important;"
            >
              <i
                data-lucide="log-in"
                style="width: 20px !important; height: 20px !important; margin-right: 8px !important;"
              ></i>

              Sign In
            </button>

            <!-- Create Account Link -->
            <div class="flex items-center justify-center">
              <a
                href="/register"
                class="inline-flex items-center justify-center gap-2 text-sm text-gray-500 hover:text-primary-600 transition-colors"
              >
                <i
                  data-lucide="user-plus"
                  style="width: 20px; height: 20px; flex-shrink: 0;"
                ></i>

                <span>
                  Not enrolled?
                  <span class="font-medium text-primary-600 hover:text-primary-700">
                    Create account
                  </span>
                </span>
              </a>
            </div>
          </div>
        </form>
      </div>
    </div>

    <!-- Terms -->
    <div class="mt-8 text-center">
      <p class="text-sm text-gray-600">
        By signing in, you agree to our

        <a
          href="/terms"
          class="text-primary-600 hover:text-primary-700 font-medium"
          target="_blank"
        >
          Terms of Service
        </a>

        and

        <a
          href="/privacy"
          class="text-primary-600 hover:text-primary-700 font-medium"
          target="_blank"
        >
          Privacy Policy
        </a>
        .
      </p>
    </div>
  </div>
</div>
<!-- Login Form Side End -->