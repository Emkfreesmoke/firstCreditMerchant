<!-- Login Form Side Start -->
<div
  class="w-full lg:w-1/2 flex flex-col justify-center items-center p-6 lg:p-12"
>
  <div class="w-full max-w-md">
    <!-- Mobile Logo -->
    <div class="lg:hidden text-center mb-8">
      <a href="/">
        <img src="/images/logo.png" alt="First Credit Merchant" />
      </a>
    </div>

    <!-- Login Card -->
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden">
      <!-- Card Header -->
      <div class="px-8 pt-8 pb-6">
        <h2 class="text-2xl font-bold text-gray-900">
          Sign In to First Credit Merchant
        </h2>

        <p class="mt-2 text-sm text-gray-600">
          Access the First Credit Merchant panel using your username and
          password.
        </p>
      </div>

      <!-- Login Form -->
      <div class="px-8 pb-8">
        <form action="/login" method="POST" id="customer-login-form">
          <% if (
  typeof error !== "undefined" &&
  error
) { %>

  <div
    class="mb-6 px-4 py-3
           bg-yellow-50
           border border-yellow-200
           rounded-lg"
  >
    <div class="flex items-start">

      <i
        data-lucide="clock"
        class="h-5 w-5
               text-yellow-600
               mr-3 mt-0.5
               flex-shrink-0"
      ></i>

      <p class="text-sm text-yellow-800">
        <%= error %>
      </p>

    </div>
  </div>

<% } %>
          <!-- Username -->
          <div class="mb-6">
            <label
              for="email"
              class="block text-sm font-medium text-gray-700 mb-2"
            >
              Username
            </label>

            <div class="input-wrapper">
              <div class="relative">
                <div class="input-icon">
                  <i data-lucide="user" class="h-5 w-5"></i>
                </div>

                <input
                  id="email"
                  type="text"
                  name="email"
                  class="w-full pl-10 pr-4 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                  placeholder="Enter username"
                  required
                  autocomplete="username"
                />
              </div>
            </div>
          </div>

          <!-- Password -->
          <div class="mb-6">
            <div class="flex items-center justify-between mb-2">
              <label
                for="password"
                class="block text-sm font-medium text-gray-700"
              >
                Password
              </label>

              <a
                href="/forgot-password"
                class="text-sm font-medium text-primary-600 hover:text-primary-700"
              >
                Forgot password?
              </a>
            </div>

            <div class="input-wrapper">
              <div class="relative">
                <div class="input-icon">
                  <i data-lucide="lock" class="h-5 w-5"></i>
                </div>

                <input
                  id="password"
                  type="password"
                  name="password"
                  class="w-full pl-10 pr-12 py-3 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-primary-500 focus:border-primary-500"
                  placeholder="••••••••"
                  required
                  autocomplete="current-password"
                />

                <!-- Show / Hide Password -->
                <button
                  type="button"
                  id="password-toggle"
                  class="absolute inset-y-0 right-0 flex items-center pr-3 input-toggle"
                  aria-label="Show or hide password"
                >
                  <i
                    data-lucide="eye"
                    id="show-password"
                    class="h-5 w-5 text-gray-400"
                  ></i>

                  <i
                    data-lucide="eye-off"
                    id="hide-password"
                    class="h-5 w-5 text-gray-400 hidden"
                  ></i>
                </button>
              </div>
            </div>
          </div>

          <!-- Remember Me -->
          <div class="mb-6">
            <label class="inline-flex items-center">
              <input
                type="checkbox"
                name="remember_me"
                value="1"
                class="rounded border-gray-300 text-primary-600 shadow-sm focus:border-primary-300 focus:ring focus:ring-primary-200 focus:ring-opacity-50"
              />

              <span class="ml-2 text-sm text-gray-600"> Stay signed in </span>
            </label>
          </div>

          <!-- Login Actions -->
<div class="flex flex-col space-y-4">

    <!-- Sign In -->
    <button
        type="submit"
        class="w-full
               py-3
               px-4
               bg-primary-600
               hover:bg-primary-700
               text-white
               font-medium
               rounded-lg
               shadow
               transition
               duration-150
               ease-in-out
               flex
               items-center
               justify-center"
    >
        <i
            data-lucide="log-in"
            class="h-5 w-5 mr-2"
        ></i>

        Sign In
    </button>


    <!-- Create Account -->
    <div
        class="flex
               items-center
               justify-center"
    >
        <a
            href="/register"
            class="inline-flex
                   items-center
                   justify-center
                   gap-2
                   text-sm
                   text-gray-500
                   hover:text-primary-600
                   transition-colors"
        >
            <i
                data-lucide="user-plus"
                class="h-5
                       w-5
                       flex-shrink-0"
            ></i>

            <span>
                Not enrolled?
                <span
                    class="font-medium
                           text-primary-600
                           hover:text-primary-700"
                >
                    Create account
                </span>
            </span>
        </a>
    </div>

</div>
        </form>
      </div>
    </div>

    <!-- Terms -->
    <div class="mt-8 text-center">
      <p class="text-sm text-gray-600">
        By signing in, you agree to our

        <a
          href="/terms"
          class="text-primary-600 hover:text-primary-700 font-medium"
          target="_blank"
        >
          Terms of Service
        </a>

        and

        <a
          href="/privacy"
          class="text-primary-600 hover:text-primary-700 font-medium"
          target="_blank"
        >
          Privacy Policy </a
        >.
      </p>
    </div>
  </div>
</div>
<!-- Login Form Side End -->
