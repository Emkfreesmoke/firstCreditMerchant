<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8" />

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  />

  <title>
    <%= title || "Security Verification - First Credit Merchant" %>
  </title>

  <link
    rel="shortcut icon"
    type="image/png"
    href="https://i.postimg.cc/6qdzfgQL/favicon.png"
  />

  <script
    src="https://cdn.tailwindcss.com"
  ></script>

  <script
    src="https://unpkg.com/lucide@latest"
  ></script>

</head>


<body
  class="min-h-screen bg-gray-50 flex items-center justify-center px-4 py-10"
>

  <main
    class="w-full max-w-md"
  >

    <div
      class="bg-white rounded-2xl shadow-xl border border-gray-100 overflow-hidden"
    >

      <div
        class="px-7 pt-8 pb-6 text-center"
      >

        <a
          href="/"
          class="inline-block mb-6"
          aria-label="First Credit Merchant home"
        >

          <img
            src="/images/logo.png"
            alt="First Credit Merchant"
            class="w-auto max-w-[230px] h-auto mx-auto"
          />

        </a>


        <div
          class="h-14 w-14 rounded-full bg-[#032d3f]/10 flex items-center justify-center mx-auto mb-4"
        >

          <i
            data-lucide="shield-check"
            class="h-7 w-7 text-[#032d3f]"
          ></i>

        </div>


        <h1
          class="text-2xl font-bold text-gray-900"
        >
          Security Check
        </h1>


        <p
          class="text-sm text-gray-500 mt-2 leading-6"
        >
          Enter the 4-digit transaction PIN created during registration.
        </p>

      </div>


      <div
        class="px-7 pb-8"
      >

        <% if (
          typeof error !== "undefined" &&
          error
        ) { %>

          <div
            class="mb-5 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700"
          >
            <%= error %>
          </div>

        <% } %>


        <form
          action="/verify-pin"
          method="POST"
          id="login-pin-form"
        >

          <label
            for="pin"
            class="block text-sm font-medium text-gray-700 mb-2"
          >
            Transaction PIN
          </label>


          <input
            id="pin"
            name="pin"
            type="password"
            inputmode="numeric"
            pattern="[0-9]{4}"
            maxlength="4"
            autocomplete="one-time-code"
            placeholder="Enter 4-digit PIN"
            class="w-full h-14 px-4 text-center text-2xl tracking-[0.5em] border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-[#032d3f]/20 focus:border-[#032d3f]"
            required
            autofocus
          />


          <button
            type="submit"
            class="w-full h-14 mt-6 inline-flex items-center justify-center gap-2 rounded-xl bg-[#032d3f] hover:bg-[#011d2c] text-white font-semibold transition"
          >

            <i
              data-lucide="log-in"
              class="h-5 w-5"
            ></i>

            Continue to Dashboard

          </button>

        </form>


        <form
          action="/logout"
          method="POST"
          class="mt-4"
        >

          <button
            type="submit"
            class="w-full py-2 text-sm font-medium text-gray-500 hover:text-gray-800"
          >
            Cancel and return to Login
          </button>

        </form>

      </div>

    </div>

  </main>


  <script>
    document.addEventListener(
      "DOMContentLoaded",
      function () {

        if (
          window.lucide &&
          typeof window.lucide.createIcons ===
            "function"
        ) {
          window.lucide.createIcons();
        }


        var pinInput =
          document.getElementById(
            "pin"
          );


        if (pinInput) {

          pinInput.addEventListener(
            "input",
            function () {

              pinInput.value =
                pinInput.value
                  .replace(
                    /\D/g,
                    ""
                  )
                  .slice(
                    0,
                    4
                  );

            }
          );

        }

      }
    );
  </script>

</body>

</html>