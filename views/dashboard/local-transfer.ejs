<%
    const sourceAccount =
        typeof account !== "undefined"
            ? account
            : null;

    const values =
        typeof dashboardValues !== "undefined"
            ? dashboardValues
            : null;

    const savedForm =
        typeof formData !== "undefined" &&
        formData
            ? formData
            : {};

    const pageError =
        typeof error !== "undefined"
            ? error
            : null;

    const hasPin =
        typeof pinConfigured !== "undefined"
            ? pinConfigured
            : false;
%>

<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
</head>

<body class="bg-gray-50">

    <%- include("partials/loader") %>

    <div
        x-data='{
            mobileMenuOpen: false,

            step: 1,

            lookupLoading: false,

            lookupError: "",

            amount:
                <%- JSON.stringify(
                    savedForm.amount || ""
                ) %>,

            recipientName:
                <%- JSON.stringify(
                    savedForm.recipientName || ""
                ) %>,

            recipientBank:
                <%- JSON.stringify(
                    savedForm.recipientBank || ""
                ) %>,

            recipientAccount:
                <%- JSON.stringify(
                    savedForm.recipientAccount || ""
                ) %>,

            routingNumber:
                <%- JSON.stringify(
                    savedForm.routingNumber || ""
                ) %>,

            purpose:
                <%- JSON.stringify(
                    savedForm.purpose || ""
                ) %>,

            description:
                <%- JSON.stringify(
                    savedForm.description || ""
                ) %>,

            transactionPin: "",

            async lookupRecipient() {

                this.lookupError = "";

                this.recipientName = "";

                this.recipientBank = "";

                if (
                    !/^\d{10}$/.test(
                        this.recipientAccount
                    )
                ) {
                    this.lookupError =
                        "Enter a valid 10-digit account number.";

                    return;
                }

                this.lookupLoading = true;

                try {

                    const response =
                        await fetch(
                            "/dashboard/transfers/lookup/" +
                            encodeURIComponent(
                                this.recipientAccount
                            ),
                            {
                                headers: {
                                    Accept:
                                        "application/json"
                                }
                            }
                        );

                    const result =
                        await response.json();

                    if (
                        !response.ok ||
                        !result.success
                    ) {
                        this.lookupError =
                            result.message ||
                            "The account could not be verified.";

                        return;
                    }

                    this.recipientName =
                        result.account.accountName;

                    this.recipientBank =
                        "First Credit Merchant";

                } catch (lookupRequestError) {

                    this.lookupError =
                        "The recipient account could not be verified.";

                } finally {

                    this.lookupLoading =
                        false;
                }
            },

            nextStep() {

                this.lookupError = "";

                if (
                    !this.recipientAccount
                ) {
                    this.lookupError =
                        "Enter the recipient account number.";

                    return;
                }

                if (
                    !this.recipientName ||
                    !this.recipientBank
                ) {
                    this.lookupError =
                        "Verify the recipient account before continuing.";

                    return;
                }

                if (
                    !this.amount ||
                    Number(this.amount) <= 0
                ) {
                    this.lookupError =
                        "Enter a valid transfer amount.";

                    return;
                }

                this.step = 2;
            }
        }'
        class="dashboard-app-shell
               flex
               h-screen
               overflow-hidden"
    >

        <%- include("partials/sidebar") %>

        <div
            class="dashboard-main-column
                   flex
                   flex-col
                   flex-1
                   min-w-0
                   overflow-hidden"
        >

            <%- include("partials/topbar") %>

            <%- include("partials/mobile-menu") %>

            <main
                class="dashboard-main-content
                       flex-1
                       min-w-0
                       overflow-y-auto"
            >

                <div class="py-6">

                    <div
                        class="max-w-5xl
                               mx-auto
                               px-4
                               sm:px-6
                               md:px-8"
                    >

                        <!-- =================================
                             BACK
                        ================================== -->

                        <a
                            href="/dashboard/transfers"
                            class="inline-flex
                                   items-center
                                   text-sm
                                   text-gray-500
                                   hover:text-gray-700
                                   mb-6"
                        >

                            <i
                                data-lucide="arrow-left"
                                class="h-4 w-4 mr-2"
                            ></i>

                            Back to Transfers

                        </a>


                        <!-- =================================
                             HEADER
                        ================================== -->

                        <div class="mb-6">

                            <h1
                                class="text-2xl
                                       font-bold
                                       text-gray-900"
                            >
                                Local Transfer
                            </h1>

                            <p
                                class="text-sm
                                       text-gray-500
                                       mt-1"
                            >
                                Send money to another
                                First Credit Merchant customer.
                            </p>

                        </div>


                        <!-- =================================
                             ERRORS
                        ================================== -->

                        <% if (pageError) { %>

                            <div
                                class="mb-6
                                       rounded-xl
                                       border
                                       border-red-200
                                       bg-red-50
                                       px-4 py-3"
                            >

                                <div class="flex items-start">

                                    <i
                                        data-lucide="circle-alert"
                                        class="h-5 w-5
                                               text-red-600
                                               mr-3
                                               mt-0.5
                                               flex-shrink-0"
                                    ></i>

                                    <p
                                        class="text-sm
                                               text-red-700"
                                    >
                                        <%= pageError %>
                                    </p>

                                </div>

                            </div>

                        <% } %>


                        <!-- =================================
                             PIN NOTICE
                        ================================== -->

                        <% if (!hasPin) { %>

                            <div
                                class="mb-6
                                       rounded-xl
                                       border
                                       border-amber-200
                                       bg-amber-50
                                       px-4 py-3"
                            >

                                <div class="flex items-start">

                                    <i
                                        data-lucide="key-round"
                                        class="h-5 w-5
                                               text-amber-600
                                               mr-3
                                               mt-0.5
                                               flex-shrink-0"
                                    ></i>

                                    <div>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-amber-800"
                                        >
                                            Transaction PIN required
                                        </p>

                                        <p
                                            class="text-xs
                                                   text-amber-700
                                                   mt-1"
                                        >
                                            Set up your transaction PIN
                                            in Settings before submitting
                                            a transfer.
                                        </p>

                                        <a
                                            href="/dashboard/settings?section=security"
                                            class="inline-flex
                                                   items-center
                                                   text-sm
                                                   font-medium
                                                   text-amber-800
                                                   mt-2"
                                        >
                                            Open Security Settings

                                            <i
                                                data-lucide="arrow-right"
                                                class="h-4 w-4 ml-1"
                                            ></i>
                                        </a>

                                    </div>

                                </div>

                            </div>

                        <% } %>


                        <!-- =================================
                             SOURCE ACCOUNT
                        ================================== -->

                        <% if (sourceAccount) { %>

                            <section
                                class="dashboard-card
                                       p-5
                                       mb-6"
                            >

                                <p
                                    class="text-xs
                                           text-gray-500"
                                >
                                    Source Account
                                </p>

                                <div
                                    class="flex
                                           flex-col
                                           sm:flex-row
                                           sm:items-center
                                           sm:justify-between
                                           gap-4
                                           mt-2"
                                >

                                    <div>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-900"
                                        >
                                            <%= sourceAccount.accountType || "" %>
                                        </p>

                                        <p
                                            class="text-xs
                                                   text-gray-500
                                                   mt-1"
                                        >
                                            <%= sourceAccount.accountNumber || "" %>
                                        </p>

                                    </div>


                                    <% if (
                                        values &&
                                        values.displayedBalance !== undefined &&
                                        values.displayedBalance !== null
                                    ) { %>

                                        <div
                                            class="sm:text-right"
                                        >

                                            <p
                                                class="text-xs
                                                       text-gray-500"
                                            >
                                                Available Balance
                                            </p>

                                            <p
                                                class="text-lg
                                                       font-semibold
                                                       text-gray-900
                                                       mt-1"
                                            >

                                                <%= values.currency ||
                                                    sourceAccount.currency ||
                                                    ""
                                                %>

                                                <%= Number(
                                                    values.displayedBalance
                                                ).toLocaleString(
                                                    undefined,
                                                    {
                                                        minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2
                                                    }
                                                ) %>

                                            </p>

                                        </div>

                                    <% } %>

                                </div>

                            </section>

                        <% } %>


                        <!-- =================================
                             TRANSFER FORM
                        ================================== -->

                        <section class="dashboard-card">

                            <form
                                method="POST"
                                action="/dashboard/local-transfer"
                            >

                                <!-- =================================
                                     STEP 1
                                ================================== -->

                                <div
                                    x-show="step === 1"
                                    class="p-6"
                                >

                                    <div
                                        class="mb-6"
                                    >

                                        <h2
                                            class="text-lg
                                                   font-semibold
                                                   text-gray-900"
                                        >
                                            Recipient Information
                                        </h2>

                                        <p
                                            class="text-sm
                                                   text-gray-500
                                                   mt-1"
                                        >
                                            Enter and verify the
                                            recipient's First Credit
                                            Merchant account.
                                        </p>

                                    </div>


                                    <div
                                        class="grid
                                               grid-cols-1
                                               md:grid-cols-2
                                               gap-5"
                                    >

                                        <!-- Recipient Account -->

                                        <div
                                            class="md:col-span-2"
                                        >

                                            <label
                                                for="recipientAccount"
                                                class="dashboard-form-label"
                                            >
                                                Recipient Account
                                            </label>

                                            <div
                                                class="flex
                                                       flex-col
                                                       sm:flex-row
                                                       gap-3"
                                            >

                                                <input
                                                    id="recipientAccount"
                                                    type="text"
                                                    name="recipientAccount"
                                                    inputmode="numeric"
                                                    maxlength="10"
                                                    x-model="recipientAccount"
                                                    @input="
                                                        recipientName = '';
                                                        recipientBank = '';
                                                        lookupError = '';
                                                    "
                                                    class="dashboard-form-input
                                                           flex-1
                                                           min-w-0"
                                                    placeholder="Enter 10-digit account number"
                                                    required
                                                >

                                                <button
                                                    type="button"
                                                    @click="lookupRecipient()"
                                                    :disabled="
                                                        lookupLoading ||
                                                        recipientAccount.length !== 10
                                                    "
                                                    class="inline-flex
                                                           items-center
                                                           justify-center
                                                           px-5 py-2.5
                                                           border
                                                           border-gray-200
                                                           bg-white
                                                           text-gray-700
                                                           text-sm
                                                           font-medium
                                                           rounded-lg
                                                           whitespace-nowrap
                                                           hover:bg-gray-50
                                                           disabled:opacity-50
                                                           disabled:cursor-not-allowed"
                                                >

                                                    <i
                                                        data-lucide="search"
                                                        class="h-4 w-4 mr-2"
                                                    ></i>

                                                    <span
                                                        x-text="
                                                            lookupLoading
                                                                ? 'Checking...'
                                                                : 'Verify Account'
                                                        "
                                                    ></span>

                                                </button>

                                            </div>

                                            <p
                                                x-show="lookupError"
                                                x-cloak
                                                x-text="lookupError"
                                                class="text-xs
                                                       text-red-600
                                                       mt-2"
                                            ></p>

                                        </div>


                                        <!-- Recipient Name -->

                                        <div>

                                            <label
                                                for="recipientName"
                                                class="dashboard-form-label"
                                            >
                                                Recipient Name
                                            </label>

                                            <input
                                                id="recipientName"
                                                type="text"
                                                name="recipientName"
                                                x-model="recipientName"
                                                readonly
                                                placeholder="Verified account name"
                                                class="dashboard-form-input
                                                       bg-gray-50"
                                            >

                                        </div>


                                        <!-- Recipient Bank -->

                                        <div>

                                            <label
                                                for="recipientBank"
                                                class="dashboard-form-label"
                                            >
                                                Recipient Bank
                                            </label>

                                            <input
                                                id="recipientBank"
                                                type="text"
                                                name="recipientBank"
                                                x-model="recipientBank"
                                                readonly
                                                placeholder="Verified bank"
                                                class="dashboard-form-input
                                                       bg-gray-50"
                                            >

                                        </div>


                                        <!-- Routing Number -->

                                        <div>

                                            <label
                                                for="routingNumber"
                                                class="dashboard-form-label"
                                            >
                                                Routing Number
                                            </label>

                                            <input
                                                id="routingNumber"
                                                type="text"
                                                name="routingNumber"
                                                x-model="routingNumber"
                                                class="dashboard-form-input"
                                                placeholder="Optional"
                                            >

                                        </div>


                                        <!-- Amount -->

                                        <div>

                                            <label
                                                for="transferAmount"
                                                class="dashboard-form-label"
                                            >
                                                Amount
                                            </label>

                                            <div class="relative">

                                                <input
                                                    id="transferAmount"
                                                    type="number"
                                                    name="amount"
                                                    step="0.01"
                                                    min="0.01"
                                                    x-model="amount"
                                                    class="dashboard-form-input
                                                           pr-16"
                                                    placeholder="0.00"
                                                    required
                                                >

                                                <span
                                                    class="absolute
                                                           right-3
                                                           top-1/2
                                                           -translate-y-1/2
                                                           text-xs
                                                           font-medium
                                                           text-gray-500"
                                                >
                                                    <%= sourceAccount
                                                        ? sourceAccount.currency
                                                        : ""
                                                    %>
                                                </span>

                                            </div>

                                        </div>


                                        <!-- Purpose -->

                                        <div
                                            class="md:col-span-2"
                                        >

                                            <label
                                                for="transferPurpose"
                                                class="dashboard-form-label"
                                            >
                                                Purpose
                                            </label>

                                            <input
                                                id="transferPurpose"
                                                type="text"
                                                name="purpose"
                                                x-model="purpose"
                                                class="dashboard-form-input"
                                                placeholder="What is this transfer for?"
                                            >

                                        </div>


                                        <!-- Description -->

                                        <div
                                            class="md:col-span-2"
                                        >

                                            <label
                                                for="transferDescription"
                                                class="dashboard-form-label"
                                            >
                                                Description
                                            </label>

                                            <textarea
                                                id="transferDescription"
                                                rows="4"
                                                name="description"
                                                x-model="description"
                                                class="dashboard-form-input
                                                       resize-none"
                                                placeholder="Optional transfer note"
                                            ></textarea>

                                        </div>

                                    </div>


                                    <div
                                        class="flex
                                               justify-end
                                               mt-7"
                                    >

                                        <button
                                            type="button"
                                            @click="nextStep()"
                                            class="inline-flex
                                                   items-center
                                                   justify-center
                                                   px-6 py-3
                                                   bg-primary-600
                                                   hover:bg-primary-700
                                                   text-white
                                                   text-sm
                                                   font-medium
                                                   rounded-lg"
                                        >

                                            Review Transfer

                                            <i
                                                data-lucide="arrow-right"
                                                class="h-4 w-4 ml-2"
                                            ></i>

                                        </button>

                                    </div>

                                </div>


                                <!-- =================================
                                     STEP 2
                                ================================== -->

                                <div
                                    x-show="step === 2"
                                    x-cloak
                                    class="p-6"
                                >

                                    <div class="mb-6">

                                        <h2
                                            class="text-lg
                                                   font-semibold
                                                   text-gray-900"
                                        >
                                            Review Transfer
                                        </h2>

                                        <p
                                            class="text-sm
                                                   text-gray-500
                                                   mt-1"
                                        >
                                            Confirm the transfer details
                                            and authorize with your
                                            transaction PIN.
                                        </p>

                                    </div>


                                    <div
                                        class="divide-y
                                               divide-gray-100
                                               border
                                               border-gray-100
                                               rounded-xl
                                               overflow-hidden"
                                    >

                                        <div class="transfer-review-row">

                                            <span>
                                                Recipient
                                            </span>

                                            <strong
                                                x-text="recipientName"
                                            ></strong>

                                        </div>


                                        <div class="transfer-review-row">

                                            <span>
                                                Bank
                                            </span>

                                            <strong
                                                x-text="recipientBank"
                                            ></strong>

                                        </div>


                                        <div class="transfer-review-row">

                                            <span>
                                                Account
                                            </span>

                                            <strong
                                                x-text="recipientAccount"
                                            ></strong>

                                        </div>


                                        <div class="transfer-review-row">

                                            <span>
                                                Routing
                                            </span>

                                            <strong
                                                x-text="
                                                    routingNumber ||
                                                    'Not provided'
                                                "
                                            ></strong>

                                        </div>


                                        <div class="transfer-review-row">

                                            <span>
                                                Amount
                                            </span>

                                            <strong>

                                                <%= sourceAccount
                                                    ? sourceAccount.currency
                                                    : ""
                                                %>

                                                <span
                                                    x-text="amount"
                                                ></span>

                                            </strong>

                                        </div>


                                        <div class="transfer-review-row">

                                            <span>
                                                Purpose
                                            </span>

                                            <strong
                                                x-text="
                                                    purpose ||
                                                    'Not provided'
                                                "
                                            ></strong>

                                        </div>


                                        <div class="transfer-review-row">

                                            <span>
                                                Description
                                            </span>

                                            <strong
                                                class="text-right
                                                       max-w-sm"
                                                x-text="
                                                    description ||
                                                    'Not provided'
                                                "
                                            ></strong>

                                        </div>

                                    </div>


                                    <!-- Transaction PIN -->

                                    <div
                                        class="mt-6
                                               p-5
                                               bg-gray-50
                                               rounded-xl"
                                    >

                                        <label
                                            for="transactionPin"
                                            class="dashboard-form-label"
                                        >
                                            Transaction PIN
                                        </label>

                                        <input
                                            id="transactionPin"
                                            type="password"
                                            name="transactionPin"
                                            inputmode="numeric"
                                            minlength="4"
                                            maxlength="6"
                                            pattern="[0-9]{4,6}"
                                            autocomplete="off"
                                            x-model="transactionPin"
                                            class="dashboard-form-input"
                                            placeholder="Enter transaction PIN"
                                            required
                                        >

                                        <p
                                            class="text-xs
                                                   text-gray-500
                                                   mt-2"
                                        >
                                            Enter your 4 to 6 digit
                                            transaction PIN to authorize
                                            this transfer.
                                        </p>

                                    </div>


                                    <!-- Actions -->

                                    <div
                                        class="flex
                                               flex-col-reverse
                                               sm:flex-row
                                               sm:items-center
                                               sm:justify-between
                                               gap-3
                                               mt-7"
                                    >

                                        <button
                                            type="button"
                                            @click="step = 1"
                                            class="inline-flex
                                                   items-center
                                                   justify-center
                                                   px-5 py-3
                                                   border
                                                   border-gray-200
                                                   bg-white
                                                   text-gray-700
                                                   text-sm
                                                   font-medium
                                                   rounded-lg
                                                   hover:bg-gray-50"
                                        >

                                            <i
                                                data-lucide="arrow-left"
                                                class="h-4 w-4 mr-2"
                                            ></i>

                                            Edit Transfer

                                        </button>


                                        <button
                                            type="submit"
                                            :disabled="
                                                !transactionPin ||
                                                transactionPin.length < 4 ||
                                                <%= hasPin
                                                    ? 'false'
                                                    : 'true'
                                                %>
                                            "
                                            class="inline-flex
                                                   items-center
                                                   justify-center
                                                   px-6 py-3
                                                   bg-primary-600
                                                   hover:bg-primary-700
                                                   text-white
                                                   text-sm
                                                   font-medium
                                                   rounded-lg
                                                   disabled:opacity-50
                                                   disabled:cursor-not-allowed"
                                        >

                                            Submit Transfer

                                            <i
                                                data-lucide="send"
                                                class="h-4 w-4 ml-2"
                                            ></i>

                                        </button>

                                    </div>

                                </div>

                            </form>

                        </section>

                    </div>

                </div>

            </main>

            <%- include("partials/footer") %>

        </div>

    </div>

    <%- include("partials/scripts") %>

</body>

</html>