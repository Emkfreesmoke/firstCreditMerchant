<div class="bg-white rounded-xl p-6 shadow-sm border border-gray-100">
  <div class="mb-6">
    <h2 class="text-xl font-bold mb-1">What would you like to do today?</h2>

    <p class="text-gray-600">Choose from our popular actions below</p>
  </div>

  <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
    <button class="dashboard-action">
      <div class="dashboard-action-icon bg-gray-200">
        <i data-lucide="building-2" class="h-6 w-6"></i>
      </div>

      <span>Account Info</span>
    </button>

    <a href="/">
      <div class="dashboard-action-icon bg-primary-100">
        <i data-lucide="send" class="h-6 w-6"></i>
      </div>

      <span>Send Money</span>
    </a>

    <a href="/dashboard/deposits" class="dashboard-action">
      <div class="dashboard-action-icon bg-green-100">
        <i data-lucide="plus" class="h-6 w-6 text-green-600"></i>
      </div>

      <span>Deposit</span>
    </a>

    <a href="/">
      <div class="dashboard-action-icon bg-purple-100">
        <i data-lucide="history" class="h-6 w-6 text-purple-600"></i>
      </div>

      <span>History</span>
    </a>
  </div>
</div>
