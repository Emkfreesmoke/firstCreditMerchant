<%
    const investmentRecord =
        typeof investment !== "undefined"
            ? investment
            : null;
%>


<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
</head>


<body class="bg-gray-50">

    <%- include("partials/loader") %>


    <div
        x-data="{ mobileMenuOpen: false }"
        class="dashboard-app-shell
               flex h-screen
               overflow-hidden"
    >

        <%- include("partials/sidebar") %>


        <div
            class="dashboard-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("partials/topbar") %>

            <%- include("partials/mobile-menu") %>


            <main class="dashboard-main-content">

                <div class="py-6">

                    <div
                        class="max-w-6xl
                               mx-auto
                               px-4
                               sm:px-6
                               md:px-8"
                    >

                        <a
                            href="/dashboard/investments"
                            class="inline-flex
                                   items-center
                                   text-sm
                                   text-gray-500
                                   hover:text-gray-700
                                   mb-6"
                        >

                            <i
                                data-lucide="arrow-left"
                                class="h-4 w-4 mr-2"
                            ></i>

                            Back to Investments

                        </a>


                        <% if (!investmentRecord) { %>

                            <section class="dashboard-card">

                                <div
                                    class="py-16
                                           px-6
                                           text-center"
                                >

                                    <i
                                        data-lucide="trending-up"
                                        class="h-10 w-10
                                               mx-auto
                                               text-gray-400
                                               mb-4"
                                    ></i>


                                    <h1
                                        class="text-xl
                                               font-semibold
                                               text-gray-900"
                                    >
                                        Investment unavailable
                                    </h1>


                                    <p
                                        class="text-sm
                                               text-gray-500
                                               mt-2"
                                    >
                                        This investment record
                                        could not be found.
                                    </p>

                                </div>

                            </section>


                        <% } else { %>

                            <!-- =================================
                                 HEADER
                            ================================== -->

                            <div
                                class="flex
                                       flex-col
                                       sm:flex-row
                                       sm:items-start
                                       sm:justify-between
                                       gap-4
                                       mb-6"
                            >

                                <div>

                                    <h1
                                        class="text-2xl
                                               font-bold
                                               text-gray-900"
                                    >
                                        Investment Details
                                    </h1>


                                    <p
                                        class="text-sm
                                               text-gray-500
                                               mt-1"
                                    >
                                        <%= investmentRecord.reference || "" %>
                                    </p>

                                </div>


                                <span
                                    class="inline-flex
                                           self-start
                                           px-3 py-1.5
                                           rounded-full
                                           text-xs
                                           font-medium
                                           <%= investmentRecord.status === "Active"
                                               ? "bg-green-100 text-green-700"
                                               : investmentRecord.status === "Approved"
                                               ? "bg-blue-100 text-blue-700"
                                               : investmentRecord.status === "Matured"
                                               ? "bg-purple-100 text-purple-700"
                                               : investmentRecord.status === "Closed"
                                               ? "bg-gray-100 text-gray-700"
                                               : investmentRecord.status === "Rejected"
                                               ? "bg-red-100 text-red-700"
                                               : investmentRecord.status === "Cancelled"
                                               ? "bg-red-100 text-red-700"
                                               : "bg-yellow-100 text-yellow-700"
                                           %>"
                                >
                                    <%= investmentRecord.status || "" %>
                                </span>

                            </div>


                            <!-- =================================
                                 SUMMARY
                            ================================== -->

                            <div
                                class="grid
                                       grid-cols-1
                                       sm:grid-cols-2
                                       xl:grid-cols-4
                                       gap-4
                                       mb-6"
                            >

                                <!-- Principal -->

                                <div class="dashboard-stat-card">

                                    <div>

                                        <p class="dashboard-stat-label">
                                            Principal
                                        </p>


                                        <p class="dashboard-stat-value">

                                            <%= investmentRecord.currency || "" %>

                                            <%= Number(
                                                investmentRecord.principal ||
                                                0
                                            ).toLocaleString(
                                                undefined,
                                                {
                                                    minimumFractionDigits: 2,
                                                    maximumFractionDigits: 2
                                                }
                                            ) %>

                                        </p>

                                    </div>

                                </div>


                                <!-- Current Value -->

                                <div class="dashboard-stat-card">

                                    <div>

                                        <p class="dashboard-stat-label">
                                            Current Value
                                        </p>


                                        <p class="dashboard-stat-value">

                                            <% if (
                                                investmentRecord.currentValue !==
                                                    undefined &&
                                                investmentRecord.currentValue !==
                                                    null
                                            ) { %>

                                                <%= investmentRecord.currency || "" %>

                                                <%= Number(
                                                    investmentRecord.currentValue
                                                ).toLocaleString(
                                                    undefined,
                                                    {
                                                        minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2
                                                    }
                                                ) %>

                                            <% } else { %>

                                                Not set

                                            <% } %>

                                        </p>

                                    </div>

                                </div>


                                <!-- Return Amount -->

                                <div class="dashboard-stat-card">

                                    <div>

                                        <p class="dashboard-stat-label">
                                            Return Amount
                                        </p>


                                        <p class="dashboard-stat-value">

                                            <% if (
                                                investmentRecord.returnAmount !==
                                                    undefined &&
                                                investmentRecord.returnAmount !==
                                                    null
                                            ) { %>

                                                <%= investmentRecord.currency || "" %>

                                                <%= Number(
                                                    investmentRecord.returnAmount
                                                ).toLocaleString(
                                                    undefined,
                                                    {
                                                        minimumFractionDigits: 2,
                                                        maximumFractionDigits: 2
                                                    }
                                                ) %>

                                            <% } else { %>

                                                Not set

                                            <% } %>

                                        </p>

                                    </div>

                                </div>


                                <!-- Return Rate -->

                                <div class="dashboard-stat-card">

                                    <div>

                                        <p class="dashboard-stat-label">
                                            Return Rate
                                        </p>


                                        <p class="dashboard-stat-value">

                                            <% if (
                                                investmentRecord.returnPercentage !==
                                                    undefined &&
                                                investmentRecord.returnPercentage !==
                                                    null
                                            ) { %>

                                                <%= Number(
                                                    investmentRecord.returnPercentage
                                                ).toFixed(2) %>%

                                            <% } else { %>

                                                Not set

                                            <% } %>

                                        </p>

                                    </div>

                                </div>

                            </div>


                            <!-- =================================
                                 INFORMATION
                            ================================== -->

                            <section class="dashboard-card">

                                <div class="dashboard-card-header">

                                    <h2
                                        class="text-lg
                                               font-semibold
                                               text-gray-900"
                                    >
                                        Investment Information
                                    </h2>

                                </div>


                                <div
                                    class="p-6
                                           grid
                                           grid-cols-1
                                           sm:grid-cols-2
                                           lg:grid-cols-3
                                           gap-6"
                                >

                                    <div>

                                        <p class="text-xs text-gray-400">
                                            Name
                                        </p>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-800
                                                   mt-1"
                                        >
                                            <%= investmentRecord.name ||
                                                investmentRecord.type ||
                                                ""
                                            %>
                                        </p>

                                    </div>


                                    <div>

                                        <p class="text-xs text-gray-400">
                                            Type
                                        </p>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-800
                                                   mt-1"
                                        >
                                            <%= investmentRecord.type || "" %>
                                        </p>

                                    </div>


                                    <div>

                                        <p class="text-xs text-gray-400">
                                            Currency
                                        </p>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-800
                                                   mt-1"
                                        >
                                            <%= investmentRecord.currency || "" %>
                                        </p>

                                    </div>


                                    <div>

                                        <p class="text-xs text-gray-400">
                                            Duration
                                        </p>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-800
                                                   mt-1"
                                        >
                                            <%= investmentRecord.duration || "" %>
                                        </p>

                                    </div>


                                    <% if (
                                        investmentRecord.startDate
                                    ) { %>

                                        <div>

                                            <p class="text-xs text-gray-400">
                                                Start Date
                                            </p>

                                            <p
                                                class="text-sm
                                                       font-medium
                                                       text-gray-800
                                                       mt-1"
                                            >
                                                <%= new Date(
                                                    investmentRecord.startDate
                                                ).toLocaleDateString() %>
                                            </p>

                                        </div>

                                    <% } %>


                                    <% if (
                                        investmentRecord.maturityDate
                                    ) { %>

                                        <div>

                                            <p class="text-xs text-gray-400">
                                                Maturity Date
                                            </p>

                                            <p
                                                class="text-sm
                                                       font-medium
                                                       text-gray-800
                                                       mt-1"
                                            >
                                                <%= new Date(
                                                    investmentRecord.maturityDate
                                                ).toLocaleDateString() %>
                                            </p>

                                        </div>

                                    <% } %>


                                    <div>

                                        <p class="text-xs text-gray-400">
                                            Status
                                        </p>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-800
                                                   mt-1"
                                        >
                                            <%= investmentRecord.status || "" %>
                                        </p>

                                    </div>

                                </div>

                            </section>


                            <!-- =================================
                                 DESCRIPTION
                            ================================== -->

                            <% if (
                                investmentRecord.description
                            ) { %>

                                <section
                                    class="dashboard-card
                                           mt-6"
                                >

                                    <div class="dashboard-card-header">

                                        <h2
                                            class="text-lg
                                                   font-semibold
                                                   text-gray-900"
                                        >
                                            Investment Goal
                                        </h2>

                                    </div>


                                    <div class="p-6">

                                        <p
                                            class="text-sm
                                                   text-gray-600
                                                   whitespace-pre-line"
                                        >
                                            <%= investmentRecord.description %>
                                        </p>

                                    </div>

                                </section>

                            <% } %>


                            <!-- =================================
                                 ADMIN NOTE
                            ================================== -->

                            <% if (
                                investmentRecord.adminNote
                            ) { %>

                                <section
                                    class="dashboard-card
                                           mt-6"
                                >

                                    <div class="dashboard-card-header">

                                        <h2
                                            class="text-lg
                                                   font-semibold
                                                   text-gray-900"
                                        >
                                            Review Note
                                        </h2>

                                    </div>


                                    <div class="p-6">

                                        <p
                                            class="text-sm
                                                   text-gray-600
                                                   whitespace-pre-line"
                                        >
                                            <%= investmentRecord.adminNote %>
                                        </p>

                                    </div>

                                </section>

                            <% } %>


                            <!-- =================================
                                 STATUS INFORMATION
                            ================================== -->

                            <% if (
                                investmentRecord.status ===
                                "Approved"
                            ) { %>

                                <div
                                    class="mt-6
                                           p-4
                                           bg-blue-50
                                           border
                                           border-blue-200
                                           rounded-xl"
                                >

                                    <div class="flex items-start">

                                        <i
                                            data-lucide="circle-check"
                                            class="h-5 w-5
                                                   text-blue-600
                                                   mr-3
                                                   mt-0.5"
                                        ></i>


                                        <div>

                                            <p
                                                class="text-sm
                                                       font-semibold
                                                       text-blue-900"
                                            >
                                                Investment Approved
                                            </p>


                                            <p
                                                class="text-sm
                                                       text-blue-700
                                                       mt-1"
                                            >
                                                The investment has been
                                                approved and is awaiting
                                                activation.
                                            </p>

                                        </div>

                                    </div>

                                </div>

                            <% } %>


                            <% if (
                                investmentRecord.status ===
                                "Active"
                            ) { %>

                                <div
                                    class="mt-6
                                           p-4
                                           bg-green-50
                                           border
                                           border-green-200
                                           rounded-xl"
                                >

                                    <div class="flex items-start">

                                        <i
                                            data-lucide="trending-up"
                                            class="h-5 w-5
                                                   text-green-600
                                                   mr-3
                                                   mt-0.5"
                                        ></i>


                                        <div>

                                            <p
                                                class="text-sm
                                                       font-semibold
                                                       text-green-900"
                                            >
                                                Investment Active
                                            </p>


                                            <p
                                                class="text-sm
                                                       text-green-700
                                                       mt-1"
                                            >
                                                The investment principal
                                                has been funded from your
                                                account.
                                            </p>

                                        </div>

                                    </div>

                                </div>

                            <% } %>


                            <% if (
                                investmentRecord.status ===
                                "Matured"
                            ) { %>

                                <div
                                    class="mt-6
                                           p-4
                                           bg-purple-50
                                           border
                                           border-purple-200
                                           rounded-xl"
                                >

                                    <div class="flex items-start">

                                        <i
                                            data-lucide="badge-check"
                                            class="h-5 w-5
                                                   text-purple-600
                                                   mr-3
                                                   mt-0.5"
                                        ></i>


                                        <div>

                                            <p
                                                class="text-sm
                                                       font-semibold
                                                       text-purple-900"
                                            >
                                                Investment Matured
                                            </p>


                                            <p
                                                class="text-sm
                                                       text-purple-700
                                                       mt-1"
                                            >
                                                The investment payout has
                                                been processed.
                                            </p>

                                        </div>

                                    </div>

                                </div>

                            <% } %>


                            <% if (
                                investmentRecord.status ===
                                "Rejected"
                            ) { %>

                                <div
                                    class="mt-6
                                           p-4
                                           bg-red-50
                                           border
                                           border-red-200
                                           rounded-xl"
                                >

                                    <div class="flex items-start">

                                        <i
                                            data-lucide="circle-x"
                                            class="h-5 w-5
                                                   text-red-600
                                                   mr-3
                                                   mt-0.5"
                                        ></i>


                                        <div>

                                            <p
                                                class="text-sm
                                                       font-semibold
                                                       text-red-900"
                                            >
                                                Investment Rejected
                                            </p>


                                            <% if (
                                                investmentRecord.adminNote
                                            ) { %>

                                                <p
                                                    class="text-sm
                                                           text-red-700
                                                           mt-1"
                                                >
                                                    <%= investmentRecord.adminNote %>
                                                </p>

                                            <% } %>

                                        </div>

                                    </div>

                                </div>

                            <% } %>

                        <% } %>

                    </div>

                </div>

            </main>


            <%- include("partials/footer") %>

        </div>

    </div>


    <%- include("partials/scripts") %>

</body>

</html>