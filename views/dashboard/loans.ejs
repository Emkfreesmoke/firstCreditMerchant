<%
    const loanRecords =
        typeof loans !== "undefined" &&
        Array.isArray(loans)
            ? loans
            : [];

    const activeLoans =
        loanRecords.filter(
            loan =>
                loan &&
                (
                    loan.status === "Active" ||
                    loan.status === "Approved"
                )
        );

    const pendingLoans =
        loanRecords.filter(
            loan =>
                loan &&
                (
                    loan.status === "Pending" ||
                    loan.status === "Under Review"
                )
        );
%>


<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
</head>

<body class="bg-gray-50">

    <%- include("partials/loader") %>

    <div
        x-data="{
            mobileMenuOpen: false
        }"
        class="dashboard-app-shell
               flex h-screen
               overflow-hidden"
    >

        <%- include("partials/sidebar") %>

        <div
            class="dashboard-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("partials/topbar") %>

            <%- include("partials/mobile-menu") %>


            <main class="dashboard-main-content">

                <div class="py-6">

                    <div
                        class="max-w-7xl
                               mx-auto
                               px-4
                               sm:px-6
                               md:px-8"
                    >

                        <!-- =================================
                             HEADER
                        ================================== -->

                        <div
                            class="flex
                                   flex-col
                                   sm:flex-row
                                   sm:items-center
                                   sm:justify-between
                                   gap-4
                                   mb-6"
                        >

                            <div>

                                <h1
                                    class="text-2xl
                                           font-bold
                                           text-gray-900"
                                >
                                    My Loans
                                </h1>

                                <p
                                    class="text-sm
                                           text-gray-500
                                           mt-1"
                                >
                                    Review your loan applications
                                    and active loans.
                                </p>

                            </div>


                            <a
                                href="/dashboard/loans/request"
                                class="inline-flex
                                       items-center
                                       px-4 py-2.5
                                       bg-primary-600
                                       hover:bg-primary-700
                                       text-white
                                       text-sm
                                       font-medium
                                       rounded-lg"
                            >

                                <i
                                    data-lucide="plus"
                                    class="h-4 w-4 mr-2"
                                ></i>

                                Request a Loan

                            </a>

                        </div>


                        <!-- =================================
                             SUMMARY
                        ================================== -->

                        <div
                            class="grid
                                   grid-cols-1
                                   sm:grid-cols-3
                                   gap-4
                                   mb-6"
                        >

                            <div class="dashboard-stat-card">

                                <div>

                                    <p class="dashboard-stat-label">
                                        Loan Records
                                    </p>

                                    <p class="dashboard-stat-value">
                                        <%= loanRecords.length %>
                                    </p>

                                </div>

                                <div
                                    class="h-11 w-11
                                           rounded-full
                                           bg-blue-50
                                           flex
                                           items-center
                                           justify-center"
                                >

                                    <i
                                        data-lucide="landmark"
                                        class="h-5 w-5
                                               text-blue-700"
                                    ></i>

                                </div>

                            </div>


                            <div class="dashboard-stat-card">

                                <div>

                                    <p class="dashboard-stat-label">
                                        Active Loans
                                    </p>

                                    <p
                                        class="dashboard-stat-value
                                               text-green-700"
                                    >
                                        <%= activeLoans.length %>
                                    </p>

                                </div>

                                <div
                                    class="h-11 w-11
                                           rounded-full
                                           bg-green-50
                                           flex
                                           items-center
                                           justify-center"
                                >

                                    <i
                                        data-lucide="circle-check"
                                        class="h-5 w-5
                                               text-green-700"
                                    ></i>

                                </div>

                            </div>


                            <div class="dashboard-stat-card">

                                <div>

                                    <p class="dashboard-stat-label">
                                        Pending Applications
                                    </p>

                                    <p
                                        class="dashboard-stat-value
                                               text-yellow-700"
                                    >
                                        <%= pendingLoans.length %>
                                    </p>

                                </div>

                                <div
                                    class="h-11 w-11
                                           rounded-full
                                           bg-yellow-50
                                           flex
                                           items-center
                                           justify-center"
                                >

                                    <i
                                        data-lucide="clock"
                                        class="h-5 w-5
                                               text-yellow-700"
                                    ></i>

                                </div>

                            </div>

                        </div>


                        <!-- =================================
                             EMPTY STATE
                        ================================== -->

                        <% if (
                            loanRecords.length === 0
                        ) { %>

                            <section class="dashboard-card">

                                <div
                                    class="py-14
                                           px-6
                                           text-center"
                                >

                                    <div
                                        class="h-16 w-16
                                               mx-auto
                                               rounded-full
                                               bg-gray-100
                                               flex
                                               items-center
                                               justify-center
                                               mb-4"
                                    >

                                        <i
                                            data-lucide="landmark"
                                            class="h-8 w-8
                                                   text-gray-400"
                                        ></i>

                                    </div>


                                    <h2
                                        class="text-lg
                                               font-semibold
                                               text-gray-900"
                                    >
                                        No loans yet
                                    </h2>


                                    <p
                                        class="text-sm
                                               text-gray-500
                                               mt-2"
                                    >
                                        Loan applications and approved
                                        loans will appear here.
                                    </p>


                                    <div
                                        class="flex
                                               flex-wrap
                                               justify-center
                                               gap-3 mt-5"
                                    >

                                        <a
                                            href="/dashboard/loans/request"
                                            class="inline-flex
                                                   items-center
                                                   px-4 py-2.5
                                                   bg-primary-600
                                                   text-white
                                                   text-sm
                                                   font-medium
                                                   rounded-lg"
                                        >
                                            Request a Loan
                                        </a>


                                        <a
                                            href="/dashboard/loans/history"
                                            class="inline-flex
                                                   items-center
                                                   px-4 py-2.5
                                                   border
                                                   border-gray-200
                                                   bg-white
                                                   text-gray-700
                                                   text-sm
                                                   font-medium
                                                   rounded-lg"
                                        >
                                            Loan History
                                        </a>

                                    </div>

                                </div>

                            </section>


                        <% } else { %>

                            <!-- =================================
                                 LOAN CARDS
                            ================================== -->

                            <div
                                class="grid
                                       grid-cols-1
                                       xl:grid-cols-2
                                       gap-6"
                            >

                                <% loanRecords.forEach(
                                    function(loan) {

                                        const loanId =
                                            loan.id ||
                                            loan._id;
                                %>

                                    <article class="dashboard-card">

                                        <div class="dashboard-card-header">

                                            <div>

                                                <h2
                                                    class="text-lg
                                                           font-semibold
                                                           text-gray-900"
                                                >
                                                    <%= loan.type || "Loan" %>
                                                </h2>


                                                <p
                                                    class="text-xs
                                                           text-gray-500
                                                           mt-1"
                                                >
                                                    <%= loan.reference || "" %>
                                                </p>

                                            </div>


                                            <span
                                                class="inline-flex
                                                       px-2.5 py-1
                                                       rounded-full
                                                       text-xs
                                                       font-medium
                                                       <%= loan.status === "Active"
                                                           ? "bg-green-100 text-green-700"
                                                           : loan.status === "Approved"
                                                           ? "bg-blue-100 text-blue-700"
                                                           : loan.status === "Rejected"
                                                           ? "bg-red-100 text-red-700"
                                                           : loan.status === "Completed"
                                                           ? "bg-green-100 text-green-700"
                                                           : "bg-yellow-100 text-yellow-700"
                                                       %>"
                                            >
                                                <%= loan.status || "" %>
                                            </span>

                                        </div>


                                        <div
                                            class="p-6
                                                   grid
                                                   grid-cols-2
                                                   gap-5"
                                        >

                                            <!-- Requested -->

                                            <div>

                                                <p
                                                    class="text-xs
                                                           text-gray-400"
                                                >
                                                    Requested
                                                </p>


                                                <p
                                                    class="text-sm
                                                           font-semibold
                                                           text-gray-900
                                                           mt-1"
                                                >

                                                    <%= loan.currency || "" %>

                                                    <%= Number(
                                                        loan.requestedAmount ||
                                                        0
                                                    ).toLocaleString(
                                                        undefined,
                                                        {
                                                            minimumFractionDigits: 2,
                                                            maximumFractionDigits: 2
                                                        }
                                                    ) %>

                                                </p>

                                            </div>


                                            <!-- Approved -->

                                            <div>

                                                <p
                                                    class="text-xs
                                                           text-gray-400"
                                                >
                                                    Approved
                                                </p>


                                                <p
                                                    class="text-sm
                                                           font-semibold
                                                           text-gray-900
                                                           mt-1"
                                                >

                                                    <% if (
                                                        loan.approvedAmount !==
                                                            undefined &&
                                                        loan.approvedAmount !==
                                                            null
                                                    ) { %>

                                                        <%= loan.currency || "" %>

                                                        <%= Number(
                                                            loan.approvedAmount
                                                        ).toLocaleString(
                                                            undefined,
                                                            {
                                                                minimumFractionDigits: 2,
                                                                maximumFractionDigits: 2
                                                            }
                                                        ) %>

                                                    <% } else { %>

                                                        Not approved

                                                    <% } %>

                                                </p>

                                            </div>


                                            <!-- Term -->

                                            <div>

                                                <p
                                                    class="text-xs
                                                           text-gray-400"
                                                >
                                                    Term
                                                </p>


                                                <p
                                                    class="text-sm
                                                           font-medium
                                                           text-gray-800
                                                           mt-1"
                                                >
                                                    <%= loan.term || "" %>
                                                </p>

                                            </div>


                                            <!-- Monthly Payment -->

                                            <div>

                                                <p
                                                    class="text-xs
                                                           text-gray-400"
                                                >
                                                    Monthly Payment
                                                </p>


                                                <p
                                                    class="text-sm
                                                           font-medium
                                                           text-gray-800
                                                           mt-1"
                                                >

                                                    <% if (
                                                        loan.monthlyPayment !==
                                                            undefined &&
                                                        loan.monthlyPayment !==
                                                            null
                                                    ) { %>

                                                        <%= loan.currency || "" %>

                                                        <%= Number(
                                                            loan.monthlyPayment
                                                        ).toLocaleString(
                                                            undefined,
                                                            {
                                                                minimumFractionDigits: 2,
                                                                maximumFractionDigits: 2
                                                            }
                                                        ) %>

                                                    <% } else { %>

                                                        Not set

                                                    <% } %>

                                                </p>

                                            </div>

                                        </div>


                                        <div class="px-6 pb-6">

                                            <a
                                                href="/dashboard/loans/<%= loanId %>"
                                                class="inline-flex
                                                       items-center
                                                       justify-center
                                                       w-full
                                                       px-4 py-2.5
                                                       border
                                                       border-gray-200
                                                       rounded-lg
                                                       text-sm
                                                       font-medium
                                                       text-gray-700
                                                       hover:bg-gray-50"
                                            >
                                                View Loan Details

                                                <i
                                                    data-lucide="arrow-right"
                                                    class="h-4 w-4 ml-2"
                                                ></i>

                                            </a>

                                        </div>

                                    </article>

                                <% }); %>

                            </div>

                        <% } %>


                        <!-- =================================
                             ACTIONS
                        ================================== -->

                        <div
                            class="grid
                                   grid-cols-2
                                   lg:grid-cols-4
                                   gap-4
                                   mt-6"
                        >

                            <a
                                href="/dashboard/loans/request"
                                class="dashboard-action"
                            >

                                <div
                                    class="dashboard-action-icon
                                           bg-primary-100"
                                >
                                    <i data-lucide="plus"></i>
                                </div>

                                <span>Request Loan</span>

                            </a>


                            <a
                                href="/dashboard/loans/history"
                                class="dashboard-action"
                            >

                                <div
                                    class="dashboard-action-icon
                                           bg-blue-100"
                                >
                                    <i
                                        data-lucide="history"
                                        class="text-blue-600"
                                    ></i>
                                </div>

                                <span>Loan History</span>

                            </a>


                            <a
                                href="/dashboard/transactions"
                                class="dashboard-action"
                            >

                                <div
                                    class="dashboard-action-icon
                                           bg-green-100"
                                >
                                    <i
                                        data-lucide="activity"
                                        class="text-green-600"
                                    ></i>
                                </div>

                                <span>Transactions</span>

                            </a>


                            <a
                                href="/dashboard/support"
                                class="dashboard-action"
                            >

                                <div
                                    class="dashboard-action-icon
                                           bg-purple-100"
                                >
                                    <i
                                        data-lucide="help-circle"
                                        class="text-purple-600"
                                    ></i>
                                </div>

                                <span>Support</span>

                            </a>

                        </div>

                    </div>

                </div>

            </main>


            <%- include("partials/footer") %>

        </div>

    </div>


    <%- include("partials/scripts") %>

</body>

</html>