<%
    const loanRecord =
        typeof loan !== "undefined"
            ? loan
            : null;
%>


<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
</head>


<body class="bg-gray-50">

    <%- include("partials/loader") %>


    <div
        x-data="{ mobileMenuOpen: false }"
        class="dashboard-app-shell
               flex h-screen
               overflow-hidden"
    >

        <%- include("partials/sidebar") %>


        <div
            class="dashboard-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("partials/topbar") %>

            <%- include("partials/mobile-menu") %>


            <main class="dashboard-main-content">

                <div class="py-6">

                    <div
                        class="max-w-6xl
                               mx-auto
                               px-4
                               sm:px-6
                               md:px-8"
                    >

                        <a
                            href="/dashboard/loans"
                            class="inline-flex
                                   items-center
                                   text-sm
                                   text-gray-500
                                   mb-6"
                        >

                            <i
                                data-lucide="arrow-left"
                                class="h-4 w-4 mr-2"
                            ></i>

                            Back to Loans

                        </a>


                        <% if (!loanRecord) { %>

                            <section class="dashboard-card">

                                <div
                                    class="py-16
                                           px-6
                                           text-center"
                                >

                                    <i
                                        data-lucide="landmark"
                                        class="h-10 w-10
                                               mx-auto
                                               text-gray-400
                                               mb-4"
                                    ></i>


                                    <h1
                                        class="text-xl
                                               font-semibold
                                               text-gray-900"
                                    >
                                        Loan unavailable
                                    </h1>

                                </div>

                            </section>


                        <% } else { %>

                            <!-- Header -->

                            <div
                                class="flex
                                       flex-col
                                       sm:flex-row
                                       sm:items-start
                                       sm:justify-between
                                       gap-4
                                       mb-6"
                            >

                                <div>

                                    <h1
                                        class="text-2xl
                                               font-bold
                                               text-gray-900"
                                    >
                                        Loan Details
                                    </h1>

                                    <p
                                        class="text-sm
                                               text-gray-500
                                               mt-1"
                                    >
                                        <%= loanRecord.reference || "" %>
                                    </p>

                                </div>


                                <span
                                    class="inline-flex
                                           self-start
                                           px-3 py-1.5
                                           rounded-full
                                           text-xs
                                           font-medium
                                           <%= loanRecord.status === "Active"
                                               ? "bg-green-100 text-green-700"
                                               : loanRecord.status === "Approved"
                                               ? "bg-blue-100 text-blue-700"
                                               : loanRecord.status === "Rejected"
                                               ? "bg-red-100 text-red-700"
                                               : loanRecord.status === "Completed"
                                               ? "bg-green-100 text-green-700"
                                               : "bg-yellow-100 text-yellow-700"
                                           %>"
                                >
                                    <%= loanRecord.status || "" %>
                                </span>

                            </div>


                            <!-- Summary -->

                            <div
                                class="grid
                                       grid-cols-1
                                       sm:grid-cols-2
                                       xl:grid-cols-4
                                       gap-4
                                       mb-6"
                            >

                                <%
                                    const summaryItems = [
                                        [
                                            "Requested",
                                            loanRecord.requestedAmount
                                        ],
                                        [
                                            "Approved",
                                            loanRecord.approvedAmount
                                        ],
                                        [
                                            "Outstanding",
                                            loanRecord.outstandingAmount
                                        ],
                                        [
                                            "Monthly Payment",
                                            loanRecord.monthlyPayment
                                        ]
                                    ];
                                %>


                                <% summaryItems.forEach(
                                    function(item) {
                                %>

                                    <div class="dashboard-stat-card">

                                        <div>

                                            <p class="dashboard-stat-label">
                                                <%= item[0] %>
                                            </p>


                                            <p class="dashboard-stat-value">

                                                <% if (
                                                    item[1] !== undefined &&
                                                    item[1] !== null
                                                ) { %>

                                                    <%= loanRecord.currency || "" %>

                                                    <%= Number(
                                                        item[1]
                                                    ).toLocaleString(
                                                        undefined,
                                                        {
                                                            minimumFractionDigits: 2,
                                                            maximumFractionDigits: 2
                                                        }
                                                    ) %>

                                                <% } else { %>

                                                    Not set

                                                <% } %>

                                            </p>

                                        </div>

                                    </div>

                                <% }); %>

                            </div>


                            <!-- Loan Information -->

                            <section class="dashboard-card">

                                <div class="dashboard-card-header">

                                    <h2
                                        class="text-lg
                                               font-semibold
                                               text-gray-900"
                                    >
                                        Loan Information
                                    </h2>

                                </div>


                                <div
                                    class="p-6
                                           grid
                                           grid-cols-1
                                           sm:grid-cols-2
                                           lg:grid-cols-3
                                           gap-6"
                                >

                                    <div>

                                        <p class="text-xs text-gray-400">
                                            Loan Type
                                        </p>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-800
                                                   mt-1"
                                        >
                                            <%= loanRecord.type || "" %>
                                        </p>

                                    </div>


                                    <div>

                                        <p class="text-xs text-gray-400">
                                            Term
                                        </p>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-800
                                                   mt-1"
                                        >
                                            <%= loanRecord.term || "" %>
                                        </p>

                                    </div>


                                    <div>

                                        <p class="text-xs text-gray-400">
                                            Interest Rate
                                        </p>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-800
                                                   mt-1"
                                        >
                                            <%= loanRecord.interestRate !== null &&
                                                loanRecord.interestRate !== undefined
                                                    ? loanRecord.interestRate + "%"
                                                    : "Not set"
                                            %>
                                        </p>

                                    </div>


                                    <div>

                                        <p class="text-xs text-gray-400">
                                            Currency
                                        </p>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-800
                                                   mt-1"
                                        >
                                            <%= loanRecord.currency || "" %>
                                        </p>

                                    </div>


                                    <% if (
                                        loanRecord.startDate
                                    ) { %>

                                        <div>

                                            <p class="text-xs text-gray-400">
                                                Start Date
                                            </p>

                                            <p
                                                class="text-sm
                                                       font-medium
                                                       text-gray-800
                                                       mt-1"
                                            >
                                                <%= new Date(
                                                    loanRecord.startDate
                                                ).toLocaleDateString() %>
                                            </p>

                                        </div>

                                    <% } %>


                                    <% if (
                                        loanRecord.endDate
                                    ) { %>

                                        <div>

                                            <p class="text-xs text-gray-400">
                                                End Date
                                            </p>

                                            <p
                                                class="text-sm
                                                       font-medium
                                                       text-gray-800
                                                       mt-1"
                                            >
                                                <%= new Date(
                                                    loanRecord.endDate
                                                ).toLocaleDateString() %>
                                            </p>

                                        </div>

                                    <% } %>


                                    <% if (
                                        loanRecord.nextPaymentDate
                                    ) { %>

                                        <div>

                                            <p class="text-xs text-gray-400">
                                                Next Payment
                                            </p>

                                            <p
                                                class="text-sm
                                                       font-medium
                                                       text-gray-800
                                                       mt-1"
                                            >
                                                <%= new Date(
                                                    loanRecord.nextPaymentDate
                                                ).toLocaleDateString() %>
                                            </p>

                                        </div>

                                    <% } %>


                                    <div>

                                        <p class="text-xs text-gray-400">
                                            Status
                                        </p>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-800
                                                   mt-1"
                                        >
                                            <%= loanRecord.status || "" %>
                                        </p>

                                    </div>

                                </div>

                            </section>


                            <!-- Purpose -->

                            <% if (loanRecord.purpose) { %>

                                <section
                                    class="dashboard-card
                                           mt-6"
                                >

                                    <div class="dashboard-card-header">

                                        <h2
                                            class="text-lg
                                                   font-semibold
                                                   text-gray-900"
                                        >
                                            Loan Purpose
                                        </h2>

                                    </div>


                                    <div class="p-6">

                                        <p
                                            class="text-sm
                                                   text-gray-600
                                                   whitespace-pre-line"
                                        >
                                            <%= loanRecord.purpose %>
                                        </p>

                                    </div>

                                </section>

                            <% } %>


                            <!-- Admin Note -->

                            <% if (loanRecord.adminNote) { %>

                                <section
                                    class="dashboard-card
                                           mt-6"
                                >

                                    <div class="dashboard-card-header">

                                        <h2
                                            class="text-lg
                                                   font-semibold
                                                   text-gray-900"
                                        >
                                            Review Note
                                        </h2>

                                    </div>


                                    <div class="p-6">

                                        <p
                                            class="text-sm
                                                   text-gray-600
                                                   whitespace-pre-line"
                                        >
                                            <%= loanRecord.adminNote %>
                                        </p>

                                    </div>

                                </section>

                            <% } %>


                            <!-- Active Loan Notice -->

                            <% if (
                                loanRecord.status ===
                                "Active"
                            ) { %>

                                <div
                                    class="mt-6
                                           px-4 py-4
                                           bg-green-50
                                           border
                                           border-green-200
                                           rounded-xl"
                                >

                                    <div class="flex items-start">

                                        <i
                                            data-lucide="circle-check"
                                            class="h-5 w-5
                                                   text-green-600
                                                   mr-3
                                                   mt-0.5"
                                        ></i>

                                        <div>

                                            <p
                                                class="text-sm
                                                       font-semibold
                                                       text-green-800"
                                            >
                                                Loan Active
                                            </p>

                                            <p
                                                class="text-sm
                                                       text-green-700
                                                       mt-1"
                                            >
                                                The approved loan has
                                                been activated.
                                            </p>

                                        </div>

                                    </div>

                                </div>

                            <% } %>

                        <% } %>

                    </div>

                </div>

            </main>


            <%- include("partials/footer") %>

        </div>

    </div>


    <%- include("partials/scripts") %>

</body>

</html>