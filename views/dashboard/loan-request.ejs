<%
    const oldForm =
        typeof formData !== "undefined" &&
        formData
            ? formData
            : {};

    const requestAccount =
        typeof account !== "undefined"
            ? account
            : null;
%>

<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
</head>

<body class="bg-gray-50">

    <%- include("partials/loader") %>

    <div
        x-data='{
            mobileMenuOpen: false,

            step: 1,

            loanType:
                <%- JSON.stringify(
                    oldForm.type || ""
                ) %>,

            amount:
                <%- JSON.stringify(
                    oldForm.requestedAmount || ""
                ) %>,

            term:
                <%- JSON.stringify(
                    oldForm.term || ""
                ) %>,

            purpose:
                <%- JSON.stringify(
                    oldForm.purpose || ""
                ) %>,

            nextStep() {
                if (
                    this.loanType &&
                    Number(this.amount) > 0 &&
                    this.term &&
                    this.purpose.trim()
                ) {
                    this.step = 2;
                }
            }
        }'
        class="dashboard-app-shell
               flex h-screen
               overflow-hidden"
    >

        <%- include("partials/sidebar") %>

        <div
            class="dashboard-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("partials/topbar") %>

            <%- include("partials/mobile-menu") %>

            <main class="dashboard-main-content">

                <div class="py-6">

                    <div
                        class="max-w-4xl
                               mx-auto
                               px-4
                               sm:px-6
                               md:px-8"
                    >

                        <!-- =================================
                             BACK
                        ================================== -->

                        <a
                            href="/dashboard/loans"
                            class="inline-flex
                                   items-center
                                   text-sm
                                   text-gray-500
                                   hover:text-gray-700
                                   mb-6"
                        >

                            <i
                                data-lucide="arrow-left"
                                class="h-4 w-4 mr-2"
                            ></i>

                            Back to Loans

                        </a>


                        <!-- =================================
                             HEADER
                        ================================== -->

                        <div class="mb-6">

                            <h1
                                class="text-2xl
                                       font-bold
                                       text-gray-900"
                            >
                                Request a Loan
                            </h1>

                            <p
                                class="text-sm
                                       text-gray-500
                                       mt-1"
                            >
                                Complete the information for
                                your loan request.
                            </p>

                        </div>


                        <!-- =================================
                             SUCCESS
                        ================================== -->

                        <% if (
                            typeof submitted !== "undefined" &&
                            submitted
                        ) { %>

                            <div
                                class="mb-6
                                       px-4 py-4
                                       bg-green-50
                                       border
                                       border-green-200
                                       rounded-xl"
                            >

                                <div class="flex items-start">

                                    <i
                                        data-lucide="circle-check"
                                        class="h-5 w-5
                                               text-green-600
                                               mr-3
                                               mt-0.5"
                                    ></i>

                                    <div>

                                        <p
                                            class="text-sm
                                                   font-semibold
                                                   text-green-800"
                                        >
                                            Loan request submitted
                                        </p>

                                        <p
                                            class="text-sm
                                                   text-green-700
                                                   mt-1"
                                        >
                                            Reference:
                                            <%= loanReference || "" %>
                                        </p>

                                    </div>

                                </div>

                            </div>

                        <% } %>


                        <!-- =================================
                             ERROR
                        ================================== -->

                        <% if (
                            typeof error !== "undefined" &&
                            error
                        ) { %>

                            <div
                                class="mb-6
                                       px-4 py-4
                                       bg-red-50
                                       border
                                       border-red-200
                                       rounded-xl"
                            >

                                <div class="flex items-start">

                                    <i
                                        data-lucide="circle-alert"
                                        class="h-5 w-5
                                               text-red-600
                                               mr-3
                                               mt-0.5"
                                    ></i>

                                    <p
                                        class="text-sm
                                               text-red-800"
                                    >
                                        <%= error %>
                                    </p>

                                </div>

                            </div>

                        <% } %>


                        <!-- =================================
                             ACCOUNT
                        ================================== -->

                        <% if (requestAccount) { %>

                            <div
                                class="dashboard-card
                                       p-5
                                       mb-6"
                            >

                                <p
                                    class="text-xs
                                           text-gray-500"
                                >
                                    Requesting Account
                                </p>

                                <div
                                    class="flex
                                           flex-wrap
                                           items-center
                                           justify-between
                                           gap-4
                                           mt-2"
                                >

                                    <div>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-900"
                                        >
                                            <%= requestAccount.accountType || "" %>
                                        </p>

                                        <p
                                            class="text-xs
                                                   text-gray-500
                                                   mt-1"
                                        >
                                            <%= requestAccount.accountNumber || "" %>
                                        </p>

                                    </div>

                                    <span
                                        class="inline-flex
                                               px-3 py-1.5
                                               rounded-full
                                               bg-gray-100
                                               text-xs
                                               font-medium
                                               text-gray-700"
                                    >
                                        <%= requestAccount.currency || "" %>
                                    </span>

                                </div>

                            </div>

                        <% } %>


                        <!-- =================================
                             LOAN FORM
                        ================================== -->

                        <section class="dashboard-card">

                            <form
                                action="/dashboard/loans/request"
                                method="POST"
                            >

                                <!-- =============================
                                     STEP 1
                                ============================== -->

                                <div
                                    x-show="step === 1"
                                    class="p-6"
                                >

                                    <div
                                        class="grid
                                               grid-cols-1
                                               md:grid-cols-2
                                               gap-5"
                                    >

                                        <!-- Loan Type -->

                                        <div>

                                            <label
                                                for="loanType"
                                                class="dashboard-form-label"
                                            >
                                                Loan Type
                                            </label>

                                            <select
                                                id="loanType"
                                                name="type"
                                                x-model="loanType"
                                                class="dashboard-form-input"
                                                required
                                            >

                                                <option value="">
                                                    Select loan type
                                                </option>

                                                <option value="Personal Loan">
                                                    Personal Loan
                                                </option>

                                                <option value="Business Loan">
                                                    Business Loan
                                                </option>

                                                <option value="Education Loan">
                                                    Education Loan
                                                </option>

                                                <option value="Auto Loan">
                                                    Auto Loan
                                                </option>

                                                <option value="Emergency Loan">
                                                    Emergency Loan
                                                </option>

                                                <option value="Other Loan">
                                                    Other Loan
                                                </option>

                                            </select>

                                        </div>


                                        <!-- Amount -->

                                        <div>

                                            <label
                                                for="requestedAmount"
                                                class="dashboard-form-label"
                                            >
                                                Requested Amount
                                            </label>

                                            <input
                                                id="requestedAmount"
                                                type="number"
                                                name="requestedAmount"
                                                min="0.01"
                                                step="0.01"
                                                x-model="amount"
                                                class="dashboard-form-input"
                                                required
                                            >

                                        </div>


                                        <!-- Term -->

                                        <div>

                                            <label
                                                for="loanTerm"
                                                class="dashboard-form-label"
                                            >
                                                Preferred Term
                                            </label>

                                            <select
                                                id="loanTerm"
                                                name="term"
                                                x-model="term"
                                                class="dashboard-form-input"
                                                required
                                            >

                                                <option value="">
                                                    Select term
                                                </option>

                                                <option value="3 Months">
                                                    3 Months
                                                </option>

                                                <option value="6 Months">
                                                    6 Months
                                                </option>

                                                <option value="12 Months">
                                                    12 Months
                                                </option>

                                                <option value="24 Months">
                                                    24 Months
                                                </option>

                                                <option value="36 Months">
                                                    36 Months
                                                </option>

                                                <option value="60 Months">
                                                    60 Months
                                                </option>

                                            </select>

                                        </div>


                                        <!-- Currency -->

                                        <div>

                                            <label
                                                class="dashboard-form-label"
                                            >
                                                Currency
                                            </label>

                                            <input
                                                type="text"
                                                value="<%= requestAccount
                                                    ? requestAccount.currency
                                                    : ""
                                                %>"
                                                class="dashboard-form-input
                                                       bg-gray-50"
                                                readonly
                                            >

                                        </div>


                                        <!-- Purpose -->

                                        <div class="md:col-span-2">

                                            <label
                                                for="loanPurpose"
                                                class="dashboard-form-label"
                                            >
                                                Loan Purpose
                                            </label>

                                            <textarea
                                                id="loanPurpose"
                                                name="purpose"
                                                rows="5"
                                                x-model="purpose"
                                                class="dashboard-form-input
                                                       resize-none"
                                                placeholder="Describe what the loan will be used for"
                                                required
                                            ></textarea>

                                        </div>

                                    </div>


                                    <div
                                        class="flex
                                               justify-end
                                               mt-7"
                                    >

                                        <button
                                            type="button"
                                            @click="nextStep()"
                                            class="inline-flex
                                                   items-center
                                                   px-6 py-3
                                                   bg-primary-600
                                                   hover:bg-primary-700
                                                   text-white
                                                   font-medium
                                                   rounded-lg"
                                        >

                                            Review Request

                                            <i
                                                data-lucide="arrow-right"
                                                class="h-4 w-4 ml-2"
                                            ></i>

                                        </button>

                                    </div>

                                </div>


                                <!-- =============================
                                     STEP 2
                                ============================== -->

                                <div
                                    x-show="step === 2"
                                    x-cloak
                                    class="p-6"
                                >

                                    <h2
                                        class="text-lg
                                               font-semibold
                                               text-gray-900
                                               mb-2"
                                    >
                                        Review Loan Request
                                    </h2>

                                    <p
                                        class="text-sm
                                               text-gray-500
                                               mb-6"
                                    >
                                        Confirm the information before
                                        submitting your application.
                                    </p>


                                    <div
                                        class="divide-y
                                               divide-gray-100
                                               border
                                               border-gray-100
                                               rounded-xl"
                                    >

                                        <!-- Loan Type -->

                                        <div class="transfer-review-row">

                                            <span>
                                                Loan Type
                                            </span>

                                            <strong
                                                x-text="loanType"
                                            ></strong>

                                        </div>


                                        <!-- Amount -->

                                        <div class="transfer-review-row">

                                            <span>
                                                Amount
                                            </span>

                                            <strong>

                                                <%= requestAccount
                                                    ? requestAccount.currency
                                                    : ""
                                                %>

                                                <span
                                                    x-text="amount"
                                                ></span>

                                            </strong>

                                        </div>


                                        <!-- Term -->

                                        <div class="transfer-review-row">

                                            <span>
                                                Term
                                            </span>

                                            <strong
                                                x-text="term"
                                            ></strong>

                                        </div>


                                        <!-- Purpose -->

                                        <div class="transfer-review-row">

                                            <span>
                                                Purpose
                                            </span>

                                            <strong
                                                x-text="purpose"
                                                class="text-right
                                                       max-w-sm"
                                            ></strong>

                                        </div>

                                    </div>


                                    <!-- =================================
                                         ACTIONS
                                    ================================== -->

                                    <div
                                        class="flex
                                               justify-between
                                               gap-3
                                               mt-7"
                                    >

                                        <button
                                            type="button"
                                            @click="step = 1"
                                            class="inline-flex
                                                   items-center
                                                   px-5 py-3
                                                   border
                                                   border-gray-200
                                                   rounded-lg
                                                   bg-white
                                                   text-gray-700"
                                        >

                                            <i
                                                data-lucide="arrow-left"
                                                class="h-4 w-4 mr-2"
                                            ></i>

                                            Edit

                                        </button>


                                        <button
                                            type="submit"
                                            class="inline-flex
                                                   items-center
                                                   px-6 py-3
                                                   bg-primary-600
                                                   hover:bg-primary-700
                                                   text-white
                                                   font-medium
                                                   rounded-lg"
                                        >

                                            Submit Request

                                            <i
                                                data-lucide="send"
                                                class="h-4 w-4 ml-2"
                                            ></i>

                                        </button>

                                    </div>

                                </div>

                            </form>

                        </section>

                    </div>

                </div>

            </main>

            <%- include("partials/footer") %>

        </div>

    </div>

    <%- include("partials/scripts") %>

</body>

</html>