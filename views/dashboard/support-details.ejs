<%
    const ticketRecord =
        typeof ticket !== "undefined"
            ? ticket
            : null;

    const messages =
        ticketRecord &&
        Array.isArray(ticketRecord.messages)
            ? ticketRecord.messages
            : [];

    function ticketStatusClasses(status) {
        if (status === "Open") {
            return "bg-blue-100 text-blue-700";
        }

        if (status === "In Progress") {
            return "bg-yellow-100 text-yellow-700";
        }

        if (status === "Resolved") {
            return "bg-green-100 text-green-700";
        }

        return "bg-gray-100 text-gray-700";
    }
%>

<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
</head>

<body class="bg-gray-50">

    <%- include("partials/loader") %>

    <div
        x-data="{ mobileMenuOpen: false }"
        class="dashboard-app-shell flex h-screen overflow-hidden"
    >

        <%- include("partials/sidebar") %>

        <div class="dashboard-main-column flex flex-col flex-1 overflow-hidden">

            <%- include("partials/topbar") %>
            <%- include("partials/mobile-menu") %>

            <main class="dashboard-main-content">

                <div class="py-6">

                    <div class="max-w-6xl mx-auto px-4 sm:px-6 md:px-8">

                        <a
                            href="/dashboard/support"
                            class="inline-flex items-center
                                   text-sm text-gray-500 mb-6"
                        >
                            <i data-lucide="arrow-left" class="h-4 w-4 mr-2"></i>
                            Back to Support
                        </a>

                        <% if (
                            typeof created !== "undefined" &&
                            created
                        ) { %>

                            <div
                                class="mb-6 p-4
                                       bg-green-50 border
                                       border-green-200 rounded-xl"
                            >
                                <p class="text-sm text-green-800">
                                    Support ticket created successfully.
                                </p>
                            </div>

                        <% } %>

                        <% if (
                            typeof replied !== "undefined" &&
                            replied
                        ) { %>

                            <div
                                class="mb-6 p-4
                                       bg-green-50 border
                                       border-green-200 rounded-xl"
                            >
                                <p class="text-sm text-green-800">
                                    Your reply was sent successfully.
                                </p>
                            </div>

                        <% } %>

                        <% if (!ticketRecord) { %>

                            <section class="dashboard-card">

                                <div class="py-16 px-6 text-center">

                                    <i
                                        data-lucide="messages-square"
                                        class="h-10 w-10 mx-auto
                                               text-gray-400 mb-4"
                                    ></i>

                                    <h1 class="text-xl font-semibold text-gray-900">
                                        Support ticket unavailable
                                    </h1>

                                </div>

                            </section>

                        <% } else { %>

                            <div
                                class="flex flex-col sm:flex-row
                                       sm:items-start sm:justify-between
                                       gap-4 mb-6"
                            >

                                <div>

                                    <h1 class="text-2xl font-bold text-gray-900">
                                        <%= ticketRecord.subject || "Support Ticket" %>
                                    </h1>

                                    <p class="text-sm text-gray-500 mt-1">
                                        <%= ticketRecord.reference || "" %>
                                    </p>

                                </div>

                                <span
                                    class="inline-flex self-start
                                           px-3 py-1 rounded-full
                                           text-xs font-medium
                                           <%= ticketStatusClasses(
                                               ticketRecord.status
                                           ) %>"
                                >
                                    <%= ticketRecord.status || "" %>
                                </span>

                            </div>

                            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                                <section class="dashboard-card lg:col-span-2">

                                    <div class="dashboard-card-header">

                                        <div>
                                            <h2 class="text-lg font-semibold text-gray-900">
                                                Conversation
                                            </h2>

                                            <p class="text-xs text-gray-500 mt-1">
                                                Messages between you and the support team.
                                            </p>
                                        </div>

                                    </div>

                                    <div class="p-6">

                                        <% if (!messages.length) { %>

                                            <div
                                                class="min-h-[240px]
                                                       flex items-center
                                                       justify-center text-center"
                                            >
                                                <p class="text-sm text-gray-500">
                                                    No messages yet
                                                </p>
                                            </div>

                                        <% } else { %>

                                            <div class="space-y-4 mb-6">

                                                <% messages.forEach(function(message) {
                                                    const fromCustomer =
                                                        message.senderType ===
                                                        "Customer";
                                                %>

                                                    <div
                                                        class="flex
                                                               <%= fromCustomer
                                                                   ? "justify-end"
                                                                   : "justify-start"
                                                               %>"
                                                    >

                                                        <div
                                                            class="max-w-[88%]
                                                                   rounded-xl p-4
                                                                   <%= fromCustomer
                                                                       ? "bg-primary-50 border border-primary-100"
                                                                       : "bg-gray-50 border border-gray-100"
                                                                   %>"
                                                        >

                                                            <p
                                                                class="text-xs font-semibold
                                                                       <%= fromCustomer
                                                                           ? "text-primary-700"
                                                                           : "text-gray-700"
                                                                       %>"
                                                            >
                                                                <%= message.authorLabel ||
                                                                    (
                                                                        fromCustomer
                                                                            ? "Customer"
                                                                            : "Support Team"
                                                                    )
                                                                %>
                                                            </p>

                                                            <p
                                                                class="text-sm text-gray-700
                                                                       mt-2 whitespace-pre-line"
                                                            >
                                                                <%= message.body || "" %>
                                                            </p>

                                                            <% if (message.createdAt) { %>
                                                                <p class="text-xs text-gray-400 mt-2">
                                                                    <%= new Date(
                                                                        message.createdAt
                                                                    ).toLocaleString() %>
                                                                </p>
                                                            <% } %>

                                                        </div>

                                                    </div>

                                                <% }); %>

                                            </div>

                                        <% } %>

                                        <% if (
                                            ticketRecord.status !== "Closed"
                                        ) { %>

                                            <form
                                                action="/dashboard/support/<%= ticketRecord._id || ticketRecord.id %>/reply"
                                                method="POST"
                                                class="border-t border-gray-100 pt-5"
                                            >

                                                <label
                                                    for="supportReply"
                                                    class="dashboard-form-label"
                                                >
                                                    Reply
                                                </label>

                                                <textarea
                                                    id="supportReply"
                                                    name="body"
                                                    rows="5"
                                                    maxlength="5000"
                                                    class="dashboard-form-input resize-none"
                                                    placeholder="Write your reply"
                                                    required
                                                ></textarea>

                                                <div class="flex justify-end mt-4">

                                                    <button
                                                        type="submit"
                                                        class="inline-flex items-center
                                                               px-5 py-2.5
                                                               bg-primary-600
                                                               hover:bg-primary-700
                                                               text-white rounded-lg"
                                                    >
                                                        <i
                                                            data-lucide="send"
                                                            class="h-4 w-4 mr-2"
                                                        ></i>

                                                        Send Reply
                                                    </button>

                                                </div>

                                            </form>

                                        <% } else { %>

                                            <div
                                                class="border-t border-gray-100
                                                       pt-5"
                                            >
                                                <div
                                                    class="p-4 bg-gray-50
                                                           border border-gray-200
                                                           rounded-lg"
                                                >
                                                    <p class="text-sm text-gray-600">
                                                        This support ticket is closed
                                                        and cannot receive new replies.
                                                    </p>
                                                </div>
                                            </div>

                                        <% } %>

                                    </div>

                                </section>

                                <aside class="space-y-6">

                                    <section class="dashboard-card">

                                        <div class="dashboard-card-header">
                                            <h2 class="text-lg font-semibold text-gray-900">
                                                Ticket Information
                                            </h2>
                                        </div>

                                        <div class="p-6 space-y-5">

                                            <div class="dashboard-detail">
                                                <span>Reference</span>
                                                <strong>
                                                    <%= ticketRecord.reference || "" %>
                                                </strong>
                                            </div>

                                            <div class="dashboard-detail">
                                                <span>Category</span>
                                                <strong>
                                                    <%= ticketRecord.category || "" %>
                                                </strong>
                                            </div>

                                            <div class="dashboard-detail">
                                                <span>Priority</span>
                                                <strong>
                                                    <%= ticketRecord.priority || "" %>
                                                </strong>
                                            </div>

                                            <div class="dashboard-detail">
                                                <span>Status</span>
                                                <strong>
                                                    <%= ticketRecord.status || "" %>
                                                </strong>
                                            </div>

                                            <% if (ticketRecord.createdAt) { %>
                                                <div class="dashboard-detail">
                                                    <span>Created</span>
                                                    <strong>
                                                        <%= new Date(
                                                            ticketRecord.createdAt
                                                        ).toLocaleString() %>
                                                    </strong>
                                                </div>
                                            <% } %>

                                            <% if (ticketRecord.updatedAt) { %>
                                                <div class="dashboard-detail">
                                                    <span>Updated</span>
                                                    <strong>
                                                        <%= new Date(
                                                            ticketRecord.updatedAt
                                                        ).toLocaleString() %>
                                                    </strong>
                                                </div>
                                            <% } %>

                                        </div>

                                    </section>

                                    <% if (
                                        ticketRecord.resolutionNote
                                    ) { %>

                                        <section class="dashboard-card">

                                            <div class="dashboard-card-header">
                                                <h2 class="text-lg font-semibold text-gray-900">
                                                    Resolution
                                                </h2>
                                            </div>

                                            <div class="p-6">
                                                <p
                                                    class="text-sm text-gray-600
                                                           whitespace-pre-line"
                                                >
                                                    <%= ticketRecord.resolutionNote %>
                                                </p>
                                            </div>

                                        </section>

                                    <% } %>

                                </aside>

                            </div>

                        <% } %>

                    </div>

                </div>

            </main>

            <%- include("partials/footer") %>

        </div>

    </div>

    <%- include("partials/scripts") %>

</body>

</html>