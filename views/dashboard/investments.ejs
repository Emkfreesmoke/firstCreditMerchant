<%
    const investmentRecords =
        typeof investments !== "undefined" &&
        Array.isArray(investments)
            ? investments
            : [];

    const activeInvestments =
        investmentRecords.filter(
            investment =>
                investment &&
                investment.status === "Active"
        );

    const pendingInvestments =
        investmentRecords.filter(
            investment =>
                investment &&
                (
                    investment.status === "Pending" ||
                    investment.status === "Under Review"
                )
        );

    const approvedInvestments =
        investmentRecords.filter(
            investment =>
                investment &&
                investment.status === "Approved"
        );

    const maturedInvestments =
        investmentRecords.filter(
            investment =>
                investment &&
                (
                    investment.status === "Matured" ||
                    investment.status === "Closed"
                )
        );
%>


<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
</head>


<body class="bg-gray-50">

    <%- include("partials/loader") %>


    <div
        x-data="{
            mobileMenuOpen: false
        }"
        class="dashboard-app-shell
               flex h-screen
               overflow-hidden"
    >

        <%- include("partials/sidebar") %>


        <div
            class="dashboard-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("partials/topbar") %>

            <%- include("partials/mobile-menu") %>


            <main class="dashboard-main-content">

                <div class="py-6">

                    <div
                        class="max-w-7xl
                               mx-auto
                               px-4
                               sm:px-6
                               md:px-8"
                    >

                        <!-- =================================
                             HEADER
                        ================================== -->

                        <div
                            class="flex
                                   flex-col
                                   sm:flex-row
                                   sm:items-center
                                   sm:justify-between
                                   gap-4
                                   mb-6"
                        >

                            <div>

                                <h1
                                    class="text-2xl
                                           font-bold
                                           text-gray-900"
                                >
                                    Save & Invest
                                </h1>


                                <p
                                    class="text-sm
                                           text-gray-500
                                           mt-1"
                                >
                                    Review your investment requests
                                    and active investments.
                                </p>

                            </div>


                            <a
                                href="/dashboard/investments/request"
                                class="inline-flex
                                       items-center
                                       px-4 py-2.5
                                       bg-primary-600
                                       hover:bg-primary-700
                                       text-white
                                       text-sm
                                       font-medium
                                       rounded-lg"
                            >

                                <i
                                    data-lucide="plus"
                                    class="h-4 w-4 mr-2"
                                ></i>

                                Start Investment

                            </a>

                        </div>


                        <!-- =================================
                             SUMMARY
                        ================================== -->

                        <div
                            class="grid
                                   grid-cols-1
                                   sm:grid-cols-2
                                   xl:grid-cols-4
                                   gap-4
                                   mb-6"
                        >

                            <!-- Total -->

                            <div class="dashboard-stat-card">

                                <div>

                                    <p class="dashboard-stat-label">
                                        Investment Records
                                    </p>

                                    <p class="dashboard-stat-value">
                                        <%= investmentRecords.length %>
                                    </p>

                                </div>


                                <div
                                    class="h-11 w-11
                                           rounded-full
                                           bg-blue-50
                                           flex
                                           items-center
                                           justify-center"
                                >

                                    <i
                                        data-lucide="trending-up"
                                        class="h-5 w-5
                                               text-blue-700"
                                    ></i>

                                </div>

                            </div>


                            <!-- Pending -->

                            <div class="dashboard-stat-card">

                                <div>

                                    <p class="dashboard-stat-label">
                                        Pending
                                    </p>

                                    <p
                                        class="dashboard-stat-value
                                               text-yellow-700"
                                    >
                                        <%= pendingInvestments.length %>
                                    </p>

                                </div>


                                <div
                                    class="h-11 w-11
                                           rounded-full
                                           bg-yellow-50
                                           flex
                                           items-center
                                           justify-center"
                                >

                                    <i
                                        data-lucide="clock"
                                        class="h-5 w-5
                                               text-yellow-700"
                                    ></i>

                                </div>

                            </div>


                            <!-- Active / Approved -->

                            <div class="dashboard-stat-card">

                                <div>

                                    <p class="dashboard-stat-label">
                                        Active Investments
                                    </p>

                                    <p
                                        class="dashboard-stat-value
                                               text-green-700"
                                    >
                                        <%= activeInvestments.length %>
                                    </p>

                                    <% if (
                                        approvedInvestments.length > 0
                                    ) { %>

                                        <p
                                            class="text-xs
                                                   text-blue-600
                                                   mt-1"
                                        >
                                            <%= approvedInvestments.length %>
                                            approved for activation
                                        </p>

                                    <% } %>

                                </div>


                                <div
                                    class="h-11 w-11
                                           rounded-full
                                           bg-green-50
                                           flex
                                           items-center
                                           justify-center"
                                >

                                    <i
                                        data-lucide="circle-check"
                                        class="h-5 w-5
                                               text-green-700"
                                    ></i>

                                </div>

                            </div>


                            <!-- Matured -->

                            <div class="dashboard-stat-card">

                                <div>

                                    <p class="dashboard-stat-label">
                                        Matured / Closed
                                    </p>

                                    <p
                                        class="dashboard-stat-value
                                               text-purple-700"
                                    >
                                        <%= maturedInvestments.length %>
                                    </p>

                                </div>


                                <div
                                    class="h-11 w-11
                                           rounded-full
                                           bg-purple-50
                                           flex
                                           items-center
                                           justify-center"
                                >

                                    <i
                                        data-lucide="badge-check"
                                        class="h-5 w-5
                                               text-purple-700"
                                    ></i>

                                </div>

                            </div>

                        </div>


                        <!-- =================================
                             EMPTY STATE
                        ================================== -->

                        <% if (
                            investmentRecords.length === 0
                        ) { %>

                            <section class="dashboard-card">

                                <div
                                    class="py-14
                                           px-6
                                           text-center"
                                >

                                    <div
                                        class="h-16 w-16
                                               mx-auto
                                               rounded-full
                                               bg-gray-100
                                               flex
                                               items-center
                                               justify-center
                                               mb-4"
                                    >

                                        <i
                                            data-lucide="trending-up"
                                            class="h-8 w-8
                                                   text-gray-400"
                                        ></i>

                                    </div>


                                    <h2
                                        class="text-lg
                                               font-semibold
                                               text-gray-900"
                                    >
                                        No investments yet
                                    </h2>


                                    <p
                                        class="text-sm
                                               text-gray-500
                                               mt-2
                                               max-w-md
                                               mx-auto"
                                    >
                                        Investment requests and
                                        active investments associated
                                        with your account will appear here.
                                    </p>


                                    <div
                                        class="flex
                                               flex-wrap
                                               justify-center
                                               gap-3
                                               mt-5"
                                    >

                                        <a
                                            href="/dashboard/investments/request"
                                            class="inline-flex
                                                   items-center
                                                   px-4 py-2.5
                                                   bg-primary-600
                                                   text-white
                                                   text-sm
                                                   font-medium
                                                   rounded-lg"
                                        >

                                            <i
                                                data-lucide="plus"
                                                class="h-4 w-4 mr-2"
                                            ></i>

                                            Start Investment

                                        </a>


                                        <a
                                            href="/dashboard/investments/history"
                                            class="inline-flex
                                                   items-center
                                                   px-4 py-2.5
                                                   border
                                                   border-gray-200
                                                   bg-white
                                                   text-gray-700
                                                   text-sm
                                                   font-medium
                                                   rounded-lg"
                                        >

                                            <i
                                                data-lucide="history"
                                                class="h-4 w-4 mr-2"
                                            ></i>

                                            Investment History

                                        </a>

                                    </div>

                                </div>

                            </section>


                        <% } else { %>

                            <!-- =================================
                                 INVESTMENT CARDS
                            ================================== -->

                            <div
                                class="grid
                                       grid-cols-1
                                       xl:grid-cols-2
                                       gap-6"
                            >

                                <% investmentRecords.forEach(
                                    function(investment) {

                                        const investmentId =
                                            investment.id ||
                                            investment._id;
                                %>

                                    <article class="dashboard-card">

                                        <div class="dashboard-card-header">

                                            <div>

                                                <h2
                                                    class="text-lg
                                                           font-semibold
                                                           text-gray-900"
                                                >
                                                    <%= investment.name ||
                                                        investment.type ||
                                                        "Investment"
                                                    %>
                                                </h2>


                                                <p
                                                    class="text-xs
                                                           text-gray-500
                                                           mt-1"
                                                >
                                                    <%= investment.reference || "" %>
                                                </p>

                                            </div>


                                            <span
                                                class="inline-flex
                                                       px-2.5 py-1
                                                       rounded-full
                                                       text-xs
                                                       font-medium
                                                       <%= investment.status === "Active"
                                                           ? "bg-green-100 text-green-700"
                                                           : investment.status === "Approved"
                                                           ? "bg-blue-100 text-blue-700"
                                                           : investment.status === "Matured"
                                                           ? "bg-purple-100 text-purple-700"
                                                           : investment.status === "Closed"
                                                           ? "bg-gray-100 text-gray-700"
                                                           : investment.status === "Rejected"
                                                           ? "bg-red-100 text-red-700"
                                                           : investment.status === "Cancelled"
                                                           ? "bg-red-100 text-red-700"
                                                           : "bg-yellow-100 text-yellow-700"
                                                       %>"
                                            >
                                                <%= investment.status || "" %>
                                            </span>

                                        </div>


                                        <div
                                            class="p-6
                                                   grid
                                                   grid-cols-2
                                                   gap-5"
                                        >

                                            <!-- Principal -->

                                            <div>

                                                <p
                                                    class="text-xs
                                                           text-gray-400"
                                                >
                                                    Principal
                                                </p>


                                                <p
                                                    class="text-sm
                                                           font-semibold
                                                           text-gray-900
                                                           mt-1"
                                                >

                                                    <%= investment.currency || "" %>

                                                    <%= Number(
                                                        investment.principal ||
                                                        0
                                                    ).toLocaleString(
                                                        undefined,
                                                        {
                                                            minimumFractionDigits: 2,
                                                            maximumFractionDigits: 2
                                                        }
                                                    ) %>

                                                </p>

                                            </div>


                                            <!-- Current Value -->

                                            <div>

                                                <p
                                                    class="text-xs
                                                           text-gray-400"
                                                >
                                                    Current Value
                                                </p>


                                                <p
                                                    class="text-sm
                                                           font-semibold
                                                           text-gray-900
                                                           mt-1"
                                                >

                                                    <% if (
                                                        investment.currentValue !==
                                                            undefined &&
                                                        investment.currentValue !==
                                                            null
                                                    ) { %>

                                                        <%= investment.currency || "" %>

                                                        <%= Number(
                                                            investment.currentValue
                                                        ).toLocaleString(
                                                            undefined,
                                                            {
                                                                minimumFractionDigits: 2,
                                                                maximumFractionDigits: 2
                                                            }
                                                        ) %>

                                                    <% } else { %>

                                                        Not set

                                                    <% } %>

                                                </p>

                                            </div>


                                            <!-- Return -->

                                            <div>

                                                <p
                                                    class="text-xs
                                                           text-gray-400"
                                                >
                                                    Return
                                                </p>


                                                <p
                                                    class="text-sm
                                                           font-medium
                                                           text-gray-800
                                                           mt-1"
                                                >

                                                    <% if (
                                                        investment.returnPercentage !==
                                                            undefined &&
                                                        investment.returnPercentage !==
                                                            null
                                                    ) { %>

                                                        <%= Number(
                                                            investment.returnPercentage
                                                        ).toFixed(2) %>%

                                                    <% } else { %>

                                                        Not set

                                                    <% } %>

                                                </p>

                                            </div>


                                            <!-- Duration -->

                                            <div>

                                                <p
                                                    class="text-xs
                                                           text-gray-400"
                                                >
                                                    Duration
                                                </p>


                                                <p
                                                    class="text-sm
                                                           font-medium
                                                           text-gray-800
                                                           mt-1"
                                                >
                                                    <%= investment.duration || "" %>
                                                </p>

                                            </div>


                                            <!-- Maturity -->

                                            <% if (
                                                investment.maturityDate
                                            ) { %>

                                                <div>

                                                    <p
                                                        class="text-xs
                                                               text-gray-400"
                                                    >
                                                        Maturity
                                                    </p>


                                                    <p
                                                        class="text-sm
                                                               font-medium
                                                               text-gray-800
                                                               mt-1"
                                                    >
                                                        <%= new Date(
                                                            investment.maturityDate
                                                        ).toLocaleDateString() %>
                                                    </p>

                                                </div>

                                            <% } %>


                                            <!-- Type -->

                                            <div>

                                                <p
                                                    class="text-xs
                                                           text-gray-400"
                                                >
                                                    Type
                                                </p>


                                                <p
                                                    class="text-sm
                                                           font-medium
                                                           text-gray-800
                                                           mt-1"
                                                >
                                                    <%= investment.type || "" %>
                                                </p>

                                            </div>

                                        </div>


                                        <div class="px-6 pb-6">

                                            <a
                                                href="/dashboard/investments/<%= investmentId %>"
                                                class="inline-flex
                                                       items-center
                                                       justify-center
                                                       w-full
                                                       px-4 py-2.5
                                                       border
                                                       border-gray-200
                                                       rounded-lg
                                                       text-sm
                                                       font-medium
                                                       text-gray-700
                                                       hover:bg-gray-50"
                                            >

                                                View Investment Details

                                                <i
                                                    data-lucide="arrow-right"
                                                    class="h-4 w-4 ml-2"
                                                ></i>

                                            </a>

                                        </div>

                                    </article>

                                <% }); %>

                            </div>

                        <% } %>


                        <!-- =================================
                             QUICK ACTIONS
                        ================================== -->

                        <div
                            class="grid
                                   grid-cols-2
                                   lg:grid-cols-4
                                   gap-4
                                   mt-6"
                        >

                            <a
                                href="/dashboard/investments/request"
                                class="dashboard-action"
                            >

                                <div
                                    class="dashboard-action-icon
                                           bg-primary-100"
                                >
                                    <i data-lucide="plus"></i>
                                </div>

                                <span>
                                    Start Investment
                                </span>

                            </a>


                            <a
                                href="/dashboard/investments/history"
                                class="dashboard-action"
                            >

                                <div
                                    class="dashboard-action-icon
                                           bg-blue-100"
                                >
                                    <i
                                        data-lucide="history"
                                        class="text-blue-600"
                                    ></i>
                                </div>

                                <span>
                                    History
                                </span>

                            </a>


                            <a
                                href="/dashboard/transactions"
                                class="dashboard-action"
                            >

                                <div
                                    class="dashboard-action-icon
                                           bg-green-100"
                                >
                                    <i
                                        data-lucide="activity"
                                        class="text-green-600"
                                    ></i>
                                </div>

                                <span>
                                    Transactions
                                </span>

                            </a>


                            <a
                                href="/dashboard/support"
                                class="dashboard-action"
                            >

                                <div
                                    class="dashboard-action-icon
                                           bg-purple-100"
                                >
                                    <i
                                        data-lucide="help-circle"
                                        class="text-purple-600"
                                    ></i>
                                </div>

                                <span>
                                    Support
                                </span>

                            </a>

                        </div>

                    </div>

                </div>

            </main>


            <%- include("partials/footer") %>

        </div>

    </div>


    <%- include("partials/scripts") %>

</body>

</html>