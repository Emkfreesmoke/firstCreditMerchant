<%
    const kycRecord =
        typeof kyc !== "undefined"
            ? kyc
            : null;

    const kycStatus =
        kycRecord &&
        kycRecord.status
            ? kycRecord.status
            : null;

    function statusClasses(status) {
        if (status === "Verified") {
            return "bg-green-100 text-green-700";
        }

        if (status === "Rejected") {
            return "bg-red-100 text-red-700";
        }

        if (status === "Needs Update") {
            return "bg-orange-100 text-orange-700";
        }

        if (status === "Under Review") {
            return "bg-blue-100 text-blue-700";
        }

        if (status === "Pending") {
            return "bg-yellow-100 text-yellow-700";
        }

        return "bg-gray-100 text-gray-700";
    }

    function statusIcon(status) {
        if (status === "Verified") {
            return "badge-check";
        }

        if (status === "Rejected") {
            return "circle-x";
        }

        if (status === "Needs Update") {
            return "refresh-cw";
        }

        if (status === "Under Review") {
            return "search-check";
        }

        if (status === "Pending") {
            return "clock";
        }

        return "circle-alert";
    }
%>


<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
</head>


<body class="bg-gray-50">

    <%- include("partials/loader") %>


    <div
        x-data="{ mobileMenuOpen: false }"
        class="dashboard-app-shell
               flex h-screen
               overflow-hidden"
    >

        <%- include("partials/sidebar") %>


        <div
            class="dashboard-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("partials/topbar") %>

            <%- include("partials/mobile-menu") %>


            <main class="dashboard-main-content">

                <div class="py-6">

                    <div
                        class="max-w-6xl
                               mx-auto
                               px-4
                               sm:px-6
                               md:px-8"
                    >

                        <!-- =================================
                             HEADER
                        ================================== -->

                        <div
                            class="flex
                                   flex-col
                                   sm:flex-row
                                   sm:items-center
                                   sm:justify-between
                                   gap-4
                                   mb-6"
                        >

                            <div>

                                <h1
                                    class="text-2xl
                                           font-bold
                                           text-gray-900"
                                >
                                    Identity Verification
                                </h1>


                                <p
                                    class="text-sm
                                           text-gray-500
                                           mt-1"
                                >
                                    Review and manage your
                                    identity verification.
                                </p>

                            </div>


                            <% if (
                                !kycRecord ||
                                kycStatus === "Rejected" ||
                                kycStatus === "Needs Update"
                            ) { %>

                                <a
                                    href="/dashboard/kyc/submit"
                                    class="inline-flex
                                           items-center
                                           px-4 py-2.5
                                           bg-primary-600
                                           hover:bg-primary-700
                                           text-white
                                           text-sm
                                           font-medium
                                           rounded-lg"
                                >

                                    <i
                                        data-lucide="badge-check"
                                        class="h-4 w-4 mr-2"
                                    ></i>


                                    <%= !kycRecord
                                        ? "Start Verification"
                                        : "Update Verification"
                                    %>

                                </a>

                            <% } %>

                        </div>


                        <!-- =================================
                             VERIFICATION STATUS
                        ================================== -->

                        <section
                            class="dashboard-card
                                   mb-6"
                        >

                            <div class="dashboard-card-header">

                                <h2
                                    class="text-lg
                                           font-semibold
                                           text-gray-900"
                                >
                                    Verification Status
                                </h2>

                            </div>


                            <div class="p-6">

                                <% if (!kycRecord) { %>

                                    <div
                                        class="flex
                                               flex-col
                                               md:flex-row
                                               md:items-center
                                               md:justify-between
                                               gap-5"
                                    >

                                        <div class="flex items-start">

                                            <div
                                                class="h-14 w-14
                                                       rounded-full
                                                       bg-gray-100
                                                       flex
                                                       items-center
                                                       justify-center
                                                       mr-4
                                                       flex-shrink-0"
                                            >

                                                <i
                                                    data-lucide="circle-alert"
                                                    class="h-7 w-7
                                                           text-gray-500"
                                                ></i>

                                            </div>


                                            <div>

                                                <span
                                                    class="inline-flex
                                                           px-3 py-1
                                                           rounded-full
                                                           bg-gray-100
                                                           text-gray-700
                                                           text-xs
                                                           font-medium"
                                                >
                                                    Not Submitted
                                                </span>


                                                <h3
                                                    class="text-lg
                                                           font-semibold
                                                           text-gray-900
                                                           mt-3"
                                                >
                                                    Verification is required
                                                </h3>


                                                <p
                                                    class="text-sm
                                                           text-gray-500
                                                           mt-1
                                                           max-w-xl"
                                                >
                                                    Submit your identity
                                                    information and documents
                                                    to begin verification.
                                                </p>

                                            </div>

                                        </div>


                                        <a
                                            href="/dashboard/kyc/submit"
                                            class="inline-flex
                                                   items-center
                                                   justify-center
                                                   px-5 py-2.5
                                                   bg-primary-600
                                                   text-white
                                                   text-sm
                                                   font-medium
                                                   rounded-lg"
                                        >
                                            Verify Account
                                        </a>

                                    </div>


                                <% } else { %>

                                    <div class="flex items-start">

                                        <div
                                            class="h-14 w-14
                                                   rounded-full
                                                   <%= statusClasses(
                                                       kycStatus
                                                   ) %>
                                                   flex
                                                   items-center
                                                   justify-center
                                                   mr-4
                                                   flex-shrink-0"
                                        >

                                            <i
                                                data-lucide="<%= statusIcon(
                                                    kycStatus
                                                ) %>"
                                                class="h-7 w-7"
                                            ></i>

                                        </div>


                                        <div>

                                            <span
                                                class="inline-flex
                                                       px-3 py-1
                                                       rounded-full
                                                       text-xs
                                                       font-medium
                                                       <%= statusClasses(
                                                           kycStatus
                                                       ) %>"
                                            >
                                                <%= kycStatus %>
                                            </span>


                                            <% if (
                                                kycStatus === "Pending"
                                            ) { %>

                                                <h3
                                                    class="text-lg
                                                           font-semibold
                                                           text-gray-900
                                                           mt-3"
                                                >
                                                    Verification submitted
                                                </h3>


                                                <p
                                                    class="text-sm
                                                           text-gray-500
                                                           mt-1"
                                                >
                                                    Your submission is
                                                    waiting for administrator
                                                    review.
                                                </p>

                                            <% } %>


                                            <% if (
                                                kycStatus ===
                                                "Under Review"
                                            ) { %>

                                                <h3
                                                    class="text-lg
                                                           font-semibold
                                                           text-gray-900
                                                           mt-3"
                                                >
                                                    Verification under review
                                                </h3>

                                            <% } %>


                                            <% if (
                                                kycStatus === "Verified"
                                            ) { %>

                                                <h3
                                                    class="text-lg
                                                           font-semibold
                                                           text-gray-900
                                                           mt-3"
                                                >
                                                    Identity verified
                                                </h3>

                                            <% } %>


                                            <% if (
                                                kycStatus ===
                                                "Needs Update"
                                            ) { %>

                                                <h3
                                                    class="text-lg
                                                           font-semibold
                                                           text-gray-900
                                                           mt-3"
                                                >
                                                    Verification update required
                                                </h3>

                                            <% } %>


                                            <% if (
                                                kycStatus ===
                                                "Rejected"
                                            ) { %>

                                                <h3
                                                    class="text-lg
                                                           font-semibold
                                                           text-gray-900
                                                           mt-3"
                                                >
                                                    Verification requires
                                                    resubmission
                                                </h3>

                                            <% } %>


                                            <% if (
                                                kycRecord.reviewMessage
                                            ) { %>

                                                <p
                                                    class="text-sm
                                                           text-gray-600
                                                           mt-3
                                                           whitespace-pre-line"
                                                >
                                                    <%= kycRecord.reviewMessage %>
                                                </p>

                                            <% } %>

                                        </div>

                                    </div>

                                <% } %>

                            </div>

                        </section>


                        <!-- =================================
                             PROCESS
                        ================================== -->

                        <div
                            class="grid
                                   grid-cols-1
                                   md:grid-cols-3
                                   gap-5
                                   mb-6"
                        >

                            <% [
                                [
                                    "1",
                                    "Personal Information",
                                    "Provide your identity and address information."
                                ],
                                [
                                    "2",
                                    "Identity Documents",
                                    "Upload your required identity documents."
                                ],
                                [
                                    "3",
                                    "Review",
                                    "Track the review status of your submission."
                                ]
                            ].forEach(
                                function(step) {
                            %>

                                <div class="dashboard-card p-5">

                                    <div
                                        class="h-10 w-10
                                               rounded-full
                                               bg-primary-100
                                               flex
                                               items-center
                                               justify-center
                                               mb-4"
                                    >

                                        <span
                                            class="font-semibold
                                                   text-gray-700"
                                        >
                                            <%= step[0] %>
                                        </span>

                                    </div>


                                    <h3
                                        class="text-sm
                                               font-semibold
                                               text-gray-900"
                                    >
                                        <%= step[1] %>
                                    </h3>


                                    <p
                                        class="text-xs
                                               text-gray-500
                                               mt-2"
                                    >
                                        <%= step[2] %>
                                    </p>

                                </div>

                            <% }); %>

                        </div>


                        <!-- =================================
                             SUBMISSION INFORMATION
                        ================================== -->

                        <% if (kycRecord) { %>

                            <section class="dashboard-card">

                                <div class="dashboard-card-header">

                                    <div>

                                        <h2
                                            class="text-lg
                                                   font-semibold
                                                   text-gray-900"
                                        >
                                            Submission
                                        </h2>


                                        <p
                                            class="text-xs
                                                   text-gray-500
                                                   mt-1"
                                        >
                                            Verification submission
                                            information.
                                        </p>

                                    </div>


                                    <a
                                        href="/dashboard/kyc/documents"
                                        class="text-sm
                                               font-medium
                                               text-primary-700"
                                    >
                                        View Documents
                                    </a>

                                </div>


                                <div
                                    class="p-6
                                           grid
                                           grid-cols-1
                                           sm:grid-cols-2
                                           lg:grid-cols-3
                                           gap-6"
                                >

                                    <div>

                                        <p class="text-xs text-gray-400">
                                            Submission ID
                                        </p>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-800
                                                   mt-1
                                                   break-all"
                                        >
                                            <%= kycRecord._id ||
                                                kycRecord.id ||
                                                ""
                                            %>
                                        </p>

                                    </div>


                                    <div>

                                        <p class="text-xs text-gray-400">
                                            Document Type
                                        </p>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-800
                                                   mt-1"
                                        >
                                            <%= kycRecord.documentType || "" %>
                                        </p>

                                    </div>


                                    <% if (
                                        kycRecord.submittedAt
                                    ) { %>

                                        <div>

                                            <p class="text-xs text-gray-400">
                                                Submitted
                                            </p>

                                            <p
                                                class="text-sm
                                                       font-medium
                                                       text-gray-800
                                                       mt-1"
                                            >
                                                <%= new Date(
                                                    kycRecord.submittedAt
                                                ).toLocaleString() %>
                                            </p>

                                        </div>

                                    <% } %>


                                    <% if (
                                        kycRecord.reviewedAt
                                    ) { %>

                                        <div>

                                            <p class="text-xs text-gray-400">
                                                Last Reviewed
                                            </p>

                                            <p
                                                class="text-sm
                                                       font-medium
                                                       text-gray-800
                                                       mt-1"
                                            >
                                                <%= new Date(
                                                    kycRecord.reviewedAt
                                                ).toLocaleString() %>
                                            </p>

                                        </div>

                                    <% } %>

                                </div>

                            </section>

                        <% } %>

                    </div>

                </div>

            </main>


            <%- include("partials/footer") %>

        </div>

    </div>


    <%- include("partials/scripts") %>

</body>

</html>