<%
    const cardRecords =
        typeof cards !== "undefined" &&
        Array.isArray(cards)
            ? cards
            : [];

    const activeCards =
        cardRecords.filter(
            card =>
                card &&
                card.status === "Active"
        );

    const frozenCards =
        cardRecords.filter(
            card =>
                card &&
                card.status === "Frozen"
        );

    const pendingCards =
        cardRecords.filter(
            card =>
                card &&
                card.status === "Pending"
        );
%>


<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
</head>


<body class="bg-gray-50">

    <%- include("partials/loader") %>


    <div
        x-data="{
            mobileMenuOpen: false
        }"
        class="dashboard-app-shell
               flex h-screen
               overflow-hidden"
    >

        <!-- =====================================
             SIDEBAR
        ====================================== -->

        <%- include("partials/sidebar") %>


        <!-- =====================================
             MAIN COLUMN
        ====================================== -->

        <div
            class="dashboard-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("partials/topbar") %>

            <%- include("partials/mobile-menu") %>


            <main class="dashboard-main-content">

                <div class="py-6">

                    <div
                        class="max-w-7xl
                               mx-auto
                               px-4
                               sm:px-6
                               md:px-8"
                    >

                        <!-- =================================
                             HEADER
                        ================================== -->

                        <div
                            class="flex
                                   flex-col
                                   sm:flex-row
                                   sm:items-center
                                   sm:justify-between
                                   gap-4
                                   mb-6"
                        >

                            <div>

                                <h1
                                    class="text-2xl
                                           font-bold
                                           text-gray-900"
                                >
                                    My Cards
                                </h1>


                                <p
                                    class="text-sm
                                           text-gray-500
                                           mt-1"
                                >
                                    View cards linked to your account.
                                </p>

                            </div>


                            <div
                                class="inline-flex
                                       items-center
                                       self-start
                                       px-4 py-2
                                       rounded-lg
                                       bg-primary-50
                                       border
                                       border-primary-100
                                       text-primary-700
                                       text-sm
                                       font-medium"
                            >

                                <i
                                    data-lucide="credit-card"
                                    class="h-4 w-4 mr-2"
                                ></i>

                                <%= cardRecords.length %>

                                <span class="ml-1">
                                    Card<%= cardRecords.length === 1 ? "" : "s" %>
                                </span>

                            </div>

                        </div>


                        <!-- =================================
                             SUMMARY
                        ================================== -->

                        <div
                            class="grid
                                   grid-cols-1
                                   sm:grid-cols-3
                                   gap-4
                                   mb-6"
                        >

                            <!-- Active -->

                            <div class="dashboard-stat-card">

                                <div>

                                    <p class="dashboard-stat-label">
                                        Active Cards
                                    </p>

                                    <p
                                        class="dashboard-stat-value
                                               text-green-700"
                                    >
                                        <%= activeCards.length %>
                                    </p>

                                </div>


                                <div
                                    class="h-11 w-11
                                           rounded-full
                                           bg-green-50
                                           flex
                                           items-center
                                           justify-center
                                           flex-shrink-0"
                                >

                                    <i
                                        data-lucide="circle-check"
                                        class="h-5 w-5
                                               text-green-700"
                                    ></i>

                                </div>

                            </div>


                            <!-- Frozen -->

                            <div class="dashboard-stat-card">

                                <div>

                                    <p class="dashboard-stat-label">
                                        Frozen Cards
                                    </p>

                                    <p
                                        class="dashboard-stat-value
                                               text-blue-700"
                                    >
                                        <%= frozenCards.length %>
                                    </p>

                                </div>


                                <div
                                    class="h-11 w-11
                                           rounded-full
                                           bg-blue-50
                                           flex
                                           items-center
                                           justify-center
                                           flex-shrink-0"
                                >

                                    <i
                                        data-lucide="snowflake"
                                        class="h-5 w-5
                                               text-blue-700"
                                    ></i>

                                </div>

                            </div>


                            <!-- Pending -->

                            <div class="dashboard-stat-card">

                                <div>

                                    <p class="dashboard-stat-label">
                                        Pending Cards
                                    </p>

                                    <p
                                        class="dashboard-stat-value
                                               text-yellow-700"
                                    >
                                        <%= pendingCards.length %>
                                    </p>

                                </div>


                                <div
                                    class="h-11 w-11
                                           rounded-full
                                           bg-yellow-50
                                           flex
                                           items-center
                                           justify-center
                                           flex-shrink-0"
                                >

                                    <i
                                        data-lucide="clock"
                                        class="h-5 w-5
                                               text-yellow-700"
                                    ></i>

                                </div>

                            </div>

                        </div>


                        <!-- =================================
                             NO CARDS
                        ================================== -->

                        <% if (
                            cardRecords.length === 0
                        ) { %>

                            <section class="dashboard-card">

                                <div class="dashboard-card-header">

                                    <div
                                        class="flex
                                               items-center"
                                    >

                                        <i
                                            data-lucide="credit-card"
                                            class="h-5 w-5
                                                   text-gray-500
                                                   mr-2"
                                        ></i>


                                        <h2
                                            class="text-lg
                                                   font-semibold
                                                   text-gray-900"
                                        >
                                            Your Cards
                                        </h2>

                                    </div>

                                </div>


                                <div
                                    class="py-14
                                           px-6
                                           flex
                                           flex-col
                                           items-center
                                           text-center"
                                >

                                    <div
                                        class="h-16 w-16
                                               rounded-full
                                               bg-gray-100
                                               flex
                                               items-center
                                               justify-center
                                               mb-4"
                                    >

                                        <i
                                            data-lucide="credit-card"
                                            class="h-8 w-8
                                                   text-gray-400"
                                        ></i>

                                    </div>


                                    <h3
                                        class="text-lg
                                               font-semibold
                                               text-gray-900"
                                    >
                                        No cards yet
                                    </h3>


                                    <p
                                        class="text-sm
                                               text-gray-500
                                               mt-2
                                               max-w-md"
                                    >
                                        Cards assigned to your account
                                        will appear here.
                                    </p>


                                    <a
                                        href="/dashboard/support"
                                        class="inline-flex
                                               items-center
                                               px-4 py-2.5
                                               mt-5
                                               border
                                               border-gray-200
                                               rounded-lg
                                               bg-white
                                               text-sm
                                               font-medium
                                               text-gray-700
                                               hover:bg-gray-50"
                                    >

                                        <i
                                            data-lucide="message-circle"
                                            class="h-4 w-4 mr-2"
                                        ></i>

                                        Contact Support

                                    </a>

                                </div>

                            </section>


                        <% } else { %>


                            <!-- =================================
                                 CARD GRID
                            ================================== -->

                            <div
                                class="grid
                                       grid-cols-1
                                       xl:grid-cols-2
                                       gap-6"
                            >

                                <% cardRecords.forEach(
                                    function(card) {

                                        const cardId =
                                            card.id ||
                                            card._id;
                                %>

                                    <article class="dashboard-card">

                                        <!-- =====================
                                             CARD VISUAL
                                        ====================== -->

                                        <div class="p-5">

                                            <a
                                                href="/dashboard/cards/<%= cardId %>"
                                                class="block"
                                            >

                                                <div
                                                    class="relative
                                                           overflow-hidden
                                                           rounded-2xl
                                                           bg-gradient-to-br
                                                           from-primary-600
                                                           via-primary-700
                                                           to-primary-900
                                                           text-white
                                                           shadow-lg
                                                           p-6
                                                           min-h-[245px]"
                                                >

                                                    <!-- Decoration -->

                                                    <div
                                                        class="absolute
                                                               -right-16
                                                               -top-16
                                                               h-48 w-48
                                                               rounded-full
                                                               bg-white/5"
                                                    ></div>


                                                    <div
                                                        class="absolute
                                                               -left-16
                                                               -bottom-24
                                                               h-56 w-56
                                                               rounded-full
                                                               bg-white/5"
                                                    ></div>


                                                    <div
                                                        class="relative
                                                               z-10
                                                               flex
                                                               flex-col
                                                               justify-between
                                                               min-h-[197px]"
                                                    >

                                                        <!-- Top -->

                                                        <div
                                                            class="flex
                                                                   items-start
                                                                   justify-between
                                                                   gap-4"
                                                        >

                                                            <div>

                                                                <p
                                                                    class="text-xs
                                                                           uppercase
                                                                           tracking-wider
                                                                           text-white/60"
                                                                >
                                                                    <%= card.issuerName || "First Credit Merchant" %>
                                                                </p>


                                                                <h3
                                                                    class="text-lg
                                                                           font-semibold
                                                                           mt-1"
                                                                >
                                                                    <%= card.displayName || card.type || "Customer Card" %>
                                                                </h3>

                                                            </div>


                                                            <div
                                                                class="flex
                                                                       items-center
                                                                       gap-3"
                                                            >

                                                                <i
                                                                    data-lucide="wifi"
                                                                    class="h-6 w-6"
                                                                ></i>

                                                                <i
                                                                    data-lucide="credit-card"
                                                                    class="h-7 w-7"
                                                                ></i>

                                                            </div>

                                                        </div>


                                                        <!-- Number -->

                                                        <div>

                                                            <p
                                                                class="text-xl
                                                                       sm:text-2xl
                                                                       tracking-[0.18em]
                                                                       font-medium"
                                                            >
                                                                •••• •••• ••••
                                                                <%= card.lastFour || "" %>
                                                            </p>

                                                        </div>


                                                        <!-- Bottom -->

                                                        <div
                                                            class="grid
                                                                   grid-cols-3
                                                                   gap-4
                                                                   items-end"
                                                        >

                                                            <div class="col-span-2">

                                                                <p
                                                                    class="text-[10px]
                                                                           uppercase
                                                                           tracking-wide
                                                                           text-white/50"
                                                                >
                                                                    Card Holder
                                                                </p>


                                                                <p
                                                                    class="text-sm
                                                                           font-medium
                                                                           mt-1
                                                                           truncate"
                                                                >
                                                                    <%= card.holderName || "" %>
                                                                </p>

                                                            </div>


                                                            <div class="text-right">

                                                                <p
                                                                    class="text-[10px]
                                                                           uppercase
                                                                           tracking-wide
                                                                           text-white/50"
                                                                >
                                                                    Expires
                                                                </p>


                                                                <p
                                                                    class="text-sm
                                                                           font-medium
                                                                           mt-1"
                                                                >
                                                                    <%= card.expiry || "" %>
                                                                </p>

                                                            </div>

                                                        </div>

                                                    </div>

                                                </div>

                                            </a>

                                        </div>


                                        <!-- =====================
                                             INFORMATION
                                        ====================== -->

                                        <div class="px-5 pb-5">

                                            <div
                                                class="grid
                                                       grid-cols-1
                                                       sm:grid-cols-2
                                                       gap-4
                                                       p-4
                                                       rounded-lg
                                                       bg-gray-50"
                                            >

                                                <!-- Type -->

                                                <div>

                                                    <p
                                                        class="text-xs
                                                               text-gray-400"
                                                    >
                                                        Card Type
                                                    </p>


                                                    <p
                                                        class="text-sm
                                                               font-medium
                                                               text-gray-800
                                                               mt-1"
                                                    >
                                                        <%= card.type || "" %>
                                                    </p>

                                                </div>


                                                <!-- Currency -->

                                                <div>

                                                    <p
                                                        class="text-xs
                                                               text-gray-400"
                                                    >
                                                        Currency
                                                    </p>


                                                    <p
                                                        class="text-sm
                                                               font-medium
                                                               text-gray-800
                                                               mt-1"
                                                    >
                                                        <%= card.currency || "" %>
                                                    </p>

                                                </div>


                                                <!-- Limit -->

                                                <div>

                                                    <p
                                                        class="text-xs
                                                               text-gray-400"
                                                    >
                                                        Spending Limit
                                                    </p>


                                                    <p
                                                        class="text-sm
                                                               font-medium
                                                               text-gray-800
                                                               mt-1"
                                                    >

                                                        <%= card.currency || "" %>

                                                        <%= Number(
                                                            card.spendingLimit ||
                                                            0
                                                        ).toLocaleString(
                                                            undefined,
                                                            {
                                                                minimumFractionDigits: 2,
                                                                maximumFractionDigits: 2
                                                            }
                                                        ) %>

                                                    </p>

                                                </div>


                                                <!-- Status -->

                                                <div>

                                                    <p
                                                        class="text-xs
                                                               text-gray-400"
                                                    >
                                                        Status
                                                    </p>


                                                    <span
                                                        class="inline-flex
                                                               items-center
                                                               px-2.5 py-1
                                                               mt-1
                                                               rounded-full
                                                               text-xs
                                                               font-medium
                                                               <%= card.status === "Active"
                                                                   ? "bg-green-100 text-green-700"
                                                                   : card.status === "Frozen"
                                                                   ? "bg-blue-100 text-blue-700"
                                                                   : card.status === "Pending"
                                                                   ? "bg-yellow-100 text-yellow-700"
                                                                   : card.status === "Expired"
                                                                   ? "bg-red-100 text-red-700"
                                                                   : "bg-gray-100 text-gray-700"
                                                               %>"
                                                    >

                                                        <%= card.status || "" %>

                                                    </span>

                                                </div>

                                            </div>


                                            <a
                                                href="/dashboard/cards/<%= cardId %>"
                                                class="inline-flex
                                                       items-center
                                                       justify-center
                                                       w-full
                                                       px-4 py-2.5
                                                       mt-4
                                                       border
                                                       border-gray-200
                                                       rounded-lg
                                                       bg-white
                                                       text-sm
                                                       font-medium
                                                       text-gray-700
                                                       hover:bg-gray-50"
                                            >

                                                View Card Details

                                                <i
                                                    data-lucide="arrow-right"
                                                    class="h-4 w-4 ml-2"
                                                ></i>

                                            </a>

                                        </div>

                                    </article>

                                <% }); %>

                            </div>


                            <!-- =================================
                                 QUICK ACTIONS
                            ================================== -->

                            <div
                                class="grid
                                       grid-cols-2
                                       lg:grid-cols-4
                                       gap-4
                                       mt-6"
                            >

                                <a
                                    href="/dashboard/transactions"
                                    class="dashboard-action"
                                >

                                    <div
                                        class="dashboard-action-icon
                                               bg-blue-100"
                                    >
                                        <i
                                            data-lucide="activity"
                                            class="h-6 w-6
                                                   text-blue-600"
                                        ></i>
                                    </div>

                                    <span>
                                        Transactions
                                    </span>

                                </a>


                                <a
                                    href="/dashboard/settings"
                                    class="dashboard-action"
                                >

                                    <div
                                        class="dashboard-action-icon
                                               bg-green-100"
                                    >
                                        <i
                                            data-lucide="shield-check"
                                            class="h-6 w-6
                                                   text-green-600"
                                        ></i>
                                    </div>

                                    <span>
                                        Security
                                    </span>

                                </a>


                                <a
                                    href="/dashboard/profile"
                                    class="dashboard-action"
                                >

                                    <div
                                        class="dashboard-action-icon
                                               bg-primary-100"
                                    >
                                        <i
                                            data-lucide="user"
                                            class="h-6 w-6"
                                        ></i>
                                    </div>

                                    <span>
                                        Profile
                                    </span>

                                </a>


                                <a
                                    href="/dashboard/support"
                                    class="dashboard-action"
                                >

                                    <div
                                        class="dashboard-action-icon
                                               bg-purple-100"
                                    >
                                        <i
                                            data-lucide="help-circle"
                                            class="h-6 w-6
                                                   text-purple-600"
                                        ></i>
                                    </div>

                                    <span>
                                        Card Support
                                    </span>

                                </a>

                            </div>

                        <% } %>


                        <!-- =================================
                             SECURITY
                        ================================== -->

                        <div
                            class="mt-6
                                   bg-primary-50
                                   border
                                   border-primary-100
                                   rounded-xl
                                   p-5"
                        >

                            <div class="flex items-start">

                                <i
                                    data-lucide="shield-check"
                                    class="h-5 w-5
                                           text-primary-600
                                           mr-3
                                           flex-shrink-0"
                                ></i>


                                <div>

                                    <h2
                                        class="text-sm
                                               font-semibold
                                               text-gray-900"
                                    >
                                        Card Security
                                    </h2>


                                    <p
                                        class="text-sm
                                               text-gray-600
                                               mt-1"
                                    >
                                        Only masked card information
                                        is displayed in the dashboard.
                                        Sensitive credentials are not
                                        shown here.
                                    </p>

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            </main>


            <%- include("partials/footer") %>

        </div>

    </div>


    <%- include("partials/scripts") %>

</body>

</html>