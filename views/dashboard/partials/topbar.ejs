<%
    const topbarCustomer =
        typeof customer !== "undefined"
            ? customer
            : null;

    const topbarAccount =
        typeof account !== "undefined"
            ? account
            : null;

    const topbarDashboardValues =
        typeof dashboardValues !== "undefined"
            ? dashboardValues
            : null;

    const topbarNotifications =
        typeof notifications !== "undefined" &&
        Array.isArray(notifications)
            ? notifications
            : [];

    const unreadNotifications =
        topbarNotifications.filter(
            notification =>
                notification &&
                notification.read !== true
        );
%>


<header class="dashboard-topbar">

    <div
        class="min-h-16
               flex items-center
               justify-between
               gap-3
               px-4
               sm:px-6"
    >

        <!-- =====================================
             LEFT
        ====================================== -->

        <div
            class="flex items-center
                   min-w-0"
        >

            <!-- Mobile Menu Button -->

            <button
                type="button"
                @click="mobileMenuOpen = true"
                class="md:hidden
                       inline-flex
                       items-center
                       justify-center
                       h-10 w-10
                       flex-shrink-0
                       rounded-lg
                       text-gray-500
                       hover:text-gray-700
                       hover:bg-gray-100"
                aria-label="Open dashboard menu"
            >

                <i
                    data-lucide="menu"
                    class="h-6 w-6"
                ></i>

            </button>


            <!-- Mobile Logo -->

            <a
                href="/dashboard"
                class="md:hidden
                       ml-2
                       flex-shrink-0"
                aria-label="Dashboard"
            >

                <img
                    src="/images/logo.png"
                    alt="First Credit Merchant"
                    class="h-9 w-auto"
                >

            </a>


            <!-- Desktop Date -->

            <div
                class="hidden
                       md:flex
                       items-center"
            >

                <div
                    class="h-9 w-9
                           rounded-lg
                           bg-gray-50
                           flex items-center
                           justify-center
                           mr-3"
                >

                    <i
                        data-lucide="calendar"
                        class="h-4 w-4
                               text-gray-500"
                    ></i>

                </div>


                <div>

                    <p
                        class="text-xs
                               text-gray-400"
                    >
                        Today
                    </p>

                    <p
                        class="text-sm
                               font-medium
                               text-gray-700"
                        data-dashboard-date
                    ></p>

                </div>

            </div>

        </div>


        <!-- =====================================
             RIGHT
        ====================================== -->

        <div
            class="flex
                   items-center
                   gap-1
                   sm:gap-3
                   flex-shrink-0"
        >

            <!-- Balance -->

            <% if (
                topbarDashboardValues &&
                topbarDashboardValues.displayedBalance !==
                    undefined &&
                topbarDashboardValues.displayedBalance !==
                    null
            ) { %>

                <div
                    class="hidden
                           sm:flex
                           items-center
                           px-3 py-2
                           rounded-lg
                           bg-primary-50
                           border
                           border-primary-100"
                >

                    <div
                        class="h-7 w-7
                               rounded-full
                               bg-white
                               flex
                               items-center
                               justify-center
                               mr-2"
                    >

                        <i
                            data-lucide="wallet"
                            class="h-4 w-4
                                   text-gray-700"
                        ></i>

                    </div>


                    <div>

                        <p
                            class="text-[10px]
                                   text-gray-500
                                   leading-none"
                        >
                            Balance
                        </p>


                        <p
                            class="text-sm
                                   font-semibold
                                   text-gray-900
                                   mt-1"
                        >
                            <%= topbarDashboardValues.currency || "" %>
                            <%= Number(
                                topbarDashboardValues.displayedBalance
                            ).toLocaleString(
                                undefined,
                                {
                                    minimumFractionDigits: 2,
                                    maximumFractionDigits: 2
                                }
                            ) %>
                        </p>

                    </div>

                </div>

            <% } %>


            <!-- =================================
                 NOTIFICATIONS
            ================================== -->

            <div
                class="relative"
                x-data="{ open: false }"
            >

                <button
                    type="button"
                    @click="open = !open"
                    class="relative
                           inline-flex
                           items-center
                           justify-center
                           h-10 w-10
                           rounded-lg
                           text-gray-500
                           hover:text-gray-700
                           hover:bg-gray-100"
                    aria-label="Notifications"
                >

                    <i
                        data-lucide="bell"
                        class="h-5 w-5"
                    ></i>


                    <% if (
                        unreadNotifications.length > 0
                    ) { %>

                        <span
                            class="absolute
                                   top-2 right-2
                                   h-2 w-2
                                   bg-red-500
                                   rounded-full
                                   border-2
                                   border-white"
                        ></span>

                    <% } %>

                </button>


                <!-- Notification Dropdown -->

                <div
                    x-show="open"
                    x-cloak
                    @click.outside="open = false"
                    @keydown.escape.window="open = false"
                    x-transition
                    class="origin-top-right
                           absolute
                           right-0
                           mt-2
                           w-[calc(100vw-2rem)]
                           sm:w-80
                           rounded-xl
                           shadow-xl
                           bg-white
                           border
                           border-gray-100
                           overflow-hidden
                           z-50"
                >

                    <!-- Header -->

                    <div
                        class="px-4 py-3
                               border-b
                               border-gray-100
                               flex
                               items-center
                               justify-between
                               gap-3"
                    >

                        <div>

                            <h3
                                class="text-sm
                                       font-semibold
                                       text-gray-900"
                            >
                                Notifications
                            </h3>


                            <% if (
                                unreadNotifications.length > 0
                            ) { %>

                                <p
                                    class="text-xs
                                           text-gray-500
                                           mt-0.5"
                                >
                                    <%= unreadNotifications.length %>
                                    unread
                                </p>

                            <% } %>

                        </div>


                        <a
                            href="/dashboard/notifications"
                            class="text-xs
                                   font-medium
                                   text-primary-700"
                        >
                            View All
                        </a>

                    </div>


                    <% if (
                        topbarNotifications.length === 0
                    ) { %>

                        <!-- Empty -->

                        <div
                            class="py-8 px-4
                                   text-center"
                        >

                            <div
                                class="h-11 w-11
                                       rounded-full
                                       bg-gray-100
                                       flex
                                       items-center
                                       justify-center
                                       mx-auto mb-3"
                            >

                                <i
                                    data-lucide="inbox"
                                    class="h-5 w-5
                                           text-gray-400"
                                ></i>

                            </div>


                            <p
                                class="text-sm
                                       text-gray-500"
                            >
                                No notifications
                            </p>

                        </div>

                    <% } else { %>

                        <!-- Notification List -->

                        <div
                            class="max-h-80
                                   overflow-y-auto"
                        >

                            <% topbarNotifications
                                .slice(0, 5)
                                .forEach(
                                    function(notification) {
                            %>

                                <a
                                    href="/dashboard/notifications/<%= notification.id %>"
                                    class="block
                                           px-4 py-4
                                           border-b
                                           border-gray-100
                                           hover:bg-gray-50"
                                >

                                    <div
                                        class="flex
                                               items-start"
                                    >

                                        <div
                                            class="h-9 w-9
                                                   rounded-full
                                                   bg-gray-100
                                                   flex
                                                   items-center
                                                   justify-center
                                                   mr-3
                                                   flex-shrink-0"
                                        >

                                            <i
                                                data-lucide="bell"
                                                class="h-4 w-4
                                                       text-gray-500"
                                            ></i>

                                        </div>


                                        <div
                                            class="flex-1
                                                   min-w-0"
                                        >

                                            <% if (
                                                notification.title
                                            ) { %>

                                                <p
                                                    class="text-sm
                                                           font-medium
                                                           text-gray-900
                                                           truncate"
                                                >
                                                    <%= notification.title %>
                                                </p>

                                            <% } %>


                                            <% if (
                                                notification.message
                                            ) { %>

                                                <p
                                                    class="text-xs
                                                           text-gray-500
                                                           mt-1
                                                           line-clamp-2"
                                                >
                                                    <%= notification.message %>
                                                </p>

                                            <% } %>


                                            <% if (
                                                notification.createdAt
                                            ) { %>

                                                <p
                                                    class="text-[11px]
                                                           text-gray-400
                                                           mt-2"
                                                >
                                                    <%= notification.createdAt %>
                                                </p>

                                            <% } %>

                                        </div>


                                        <% if (
                                            notification.read !== true
                                        ) { %>

                                            <span
                                                class="h-2 w-2
                                                       rounded-full
                                                       bg-blue-500
                                                       mt-1.5 ml-2
                                                       flex-shrink-0"
                                            ></span>

                                        <% } %>

                                    </div>

                                </a>

                            <% }); %>

                        </div>

                    <% } %>


                    <div
                        class="px-4 py-3
                               bg-gray-50
                               border-t
                               border-gray-100"
                    >

                        <a
                            href="/dashboard/notifications"
                            class="flex
                                   items-center
                                   justify-center
                                   text-xs
                                   font-medium
                                   text-primary-700"
                        >

                            Notification Center

                            <i
                                data-lucide="arrow-right"
                                class="h-3.5 w-3.5
                                       ml-1"
                            ></i>

                        </a>

                    </div>

                </div>

            </div>


            <!-- =================================
                 PROFILE
            ================================== -->

            <div
                class="relative"
                x-data="{ open: false }"
            >

                <button
                    type="button"
                    @click="open = !open"
                    class="flex
                           items-center
                           rounded-lg
                           hover:bg-gray-100
                           px-1.5
                           sm:px-2
                           py-1.5"
                    aria-label="Customer menu"
                >

                    <div
                        class="h-9 w-9
                               rounded-full
                               bg-gray-100
                               border
                               border-gray-200
                               flex
                               items-center
                               justify-center"
                    >

                        <i
                            data-lucide="user"
                            class="h-4 w-4
                                   text-gray-500"
                        ></i>

                    </div>


                    <% if (
                        topbarCustomer &&
                        topbarCustomer.fullName
                    ) { %>

                        <div
                            class="hidden
                                   lg:block
                                   text-left
                                   ml-2 mr-2
                                   max-w-44"
                        >

                            <p
                                class="text-sm
                                       font-medium
                                       text-gray-900
                                       leading-tight
                                       truncate"
                            >
                                <%= topbarCustomer.fullName %>
                            </p>


                            <% if (
                                topbarAccount &&
                                topbarAccount.accountType
                            ) { %>

                                <p
                                    class="text-[11px]
                                           text-gray-500
                                           mt-0.5
                                           truncate"
                                >
                                    <%= topbarAccount.accountType %>
                                </p>

                            <% } %>

                        </div>

                    <% } %>


                    <i
                        data-lucide="chevron-down"
                        class="hidden
                               sm:block
                               h-4 w-4
                               text-gray-400"
                    ></i>

                </button>


                <!-- Profile Dropdown -->

                <div
                    x-show="open"
                    x-cloak
                    @click.outside="open = false"
                    @keydown.escape.window="open = false"
                    x-transition
                    class="origin-top-right
                           absolute
                           right-0
                           mt-2
                           w-56
                           rounded-xl
                           shadow-xl
                           bg-white
                           border
                           border-gray-100
                           overflow-hidden
                           z-50"
                >

                    <% if (topbarCustomer) { %>

                        <div
                            class="px-4 py-4
                                   border-b
                                   border-gray-100"
                        >

                            <% if (
                                topbarCustomer.fullName
                            ) { %>

                                <p
                                    class="text-sm
                                           font-medium
                                           text-gray-900"
                                >
                                    <%= topbarCustomer.fullName %>
                                </p>

                            <% } %>


                            <% if (
                                topbarCustomer.customerId
                            ) { %>

                                <p
                                    class="text-xs
                                           text-gray-500
                                           mt-1"
                                >
                                    <%= topbarCustomer.customerId %>
                                </p>

                            <% } %>

                        </div>

                    <% } %>


                    <a
                        href="/dashboard/profile"
                        class="flex
                               items-center
                               px-4 py-3
                               text-sm
                               text-gray-700
                               hover:bg-gray-50"
                    >

                        <i
                            data-lucide="user-circle"
                            class="h-4 w-4
                                   mr-3
                                   text-gray-500"
                        ></i>

                        My Profile

                    </a>


                    <a
                        href="/dashboard/settings"
                        class="flex
                               items-center
                               px-4 py-3
                               text-sm
                               text-gray-700
                               hover:bg-gray-50"
                    >

                        <i
                            data-lucide="settings"
                            class="h-4 w-4
                                   mr-3
                                   text-gray-500"
                        ></i>

                        Settings

                    </a>


                    <a
                        href="/dashboard/kyc"
                        class="flex
                               items-center
                               px-4 py-3
                               text-sm
                               text-gray-700
                               hover:bg-gray-50"
                    >

                        <i
                            data-lucide="badge-check"
                            class="h-4 w-4
                                   mr-3
                                   text-gray-500"
                        ></i>

                        Verification

                    </a>


                    <a
                        href="/dashboard/support"
                        class="flex
                               items-center
                               px-4 py-3
                               text-sm
                               text-gray-700
                               hover:bg-gray-50"
                    >

                        <i
                            data-lucide="help-circle"
                            class="h-4 w-4
                                   mr-3
                                   text-gray-500"
                        ></i>

                        Support

                    </a>


                    <div
                        class="border-t
                               border-gray-100"
                    ></div>


                    <!-- Real Logout -->

                    <form
                        action="/logout"
                        method="POST"
                    >

                        <button
                            type="submit"
                            class="w-full
                                   flex
                                   items-center
                                   px-4 py-3
                                   text-sm
                                   text-red-600
                                   hover:bg-red-50"
                        >

                            <i
                                data-lucide="log-out"
                                class="h-4 w-4 mr-3"
                            ></i>

                            Sign Out

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</header>