<%
    const sidebarCustomer =
        typeof customer !== "undefined"
            ? customer
            : null;

    const sidebarAccount =
        typeof account !== "undefined"
            ? account
            : null;

    const sidebarKyc =
        typeof kyc !== "undefined"
            ? kyc
            : null;

    const currentPath =
        typeof activePath !== "undefined"
            ? activePath
            : "";
%>


<!-- =====================================================
     CUSTOMER DESKTOP SIDEBAR
====================================================== -->

<aside
    class="dashboard-sidebar"
    aria-label="Customer dashboard navigation"
>

    <!-- Logo -->

    <div class="dashboard-sidebar-logo">

        <a
            href="/dashboard"
            aria-label="Customer dashboard"
        >
            <img
                src="/images/logo.png"
                alt="First Credit Merchant"
            >
        </a>

    </div>


    <div class="dashboard-sidebar-scroll">

        <!-- =========================================
             CUSTOMER ACCOUNT
        ========================================== -->

        <div class="dashboard-account-card">

            <div class="flex items-center">

                <div
                    class="h-10 w-10
                           mr-3
                           rounded-full
                           bg-gray-200
                           flex items-center
                           justify-center
                           flex-shrink-0"
                >

                    <i
                        data-lucide="user"
                        class="h-5 w-5
                               text-gray-500"
                    ></i>

                </div>


                <div class="flex-1 min-w-0">

                    <% if (sidebarCustomer) { %>

                        <% if (
                            sidebarCustomer.fullName
                        ) { %>

                            <p
                                class="text-sm
                                       font-medium
                                       text-gray-900
                                       truncate"
                            >
                                <%= sidebarCustomer.fullName %>
                            </p>

                        <% } %>


                        <% if (
                            sidebarCustomer.customerId
                        ) { %>

                            <p
                                class="text-xs
                                       text-gray-500
                                       truncate"
                            >
                                ID:
                                <%= sidebarCustomer.customerId %>
                            </p>

                        <% } %>

                    <% } else { %>

                        <p
                            class="text-sm
                                   font-medium
                                   text-gray-500"
                        >
                            Customer account
                        </p>

                    <% } %>

                </div>

            </div>


            <!-- Account Number -->

            <% if (
                sidebarAccount &&
                sidebarAccount.accountNumber
            ) { %>

                <div
                    class="mt-3
                           pt-3
                           border-t
                           border-gray-200"
                >

                    <p
                        class="text-[10px]
                               uppercase
                               tracking-wide
                               text-gray-400"
                    >
                        Account Number
                    </p>

                    <p
                        class="text-xs
                               font-semibold
                               text-gray-700
                               mt-1"
                    >
                        <%= sidebarAccount.accountNumber %>
                    </p>

                </div>

            <% } %>


            <!-- KYC Status -->

            <div class="mt-3">

                <% if (
                    sidebarKyc &&
                    sidebarKyc.status
                ) { %>

                    <a
                        href="/dashboard/kyc"
                        class="flex
                               items-center
                               justify-center
                               py-1.5
                               rounded-md
                               border
                               text-xs
                               font-medium
                               <%= sidebarKyc.status === "Verified"
                                   ? "bg-green-50 border-green-100 text-green-700"
                                   : sidebarKyc.status === "Rejected"
                                   ? "bg-red-50 border-red-100 text-red-700"
                                   : sidebarKyc.status === "Needs Update"
                                   ? "bg-orange-50 border-orange-100 text-orange-700"
                                   : "bg-yellow-50 border-yellow-100 text-yellow-700"
                               %>"
                    >

                        <i
                            data-lucide="badge-check"
                            class="h-3.5 w-3.5 mr-1.5"
                        ></i>

                        <%= sidebarKyc.status %>

                    </a>

                <% } else { %>

                    <a
                        href="/dashboard/kyc"
                        class="flex
                               items-center
                               justify-center
                               py-1.5
                               rounded-md
                               bg-gray-100
                               border
                               border-gray-200
                               text-xs
                               text-gray-600
                               font-medium"
                    >

                        <i
                            data-lucide="badge-check"
                            class="h-3.5 w-3.5 mr-1.5"
                        ></i>

                        Verification

                    </a>

                <% } %>

            </div>


            <!-- Profile and Logout -->

            <div class="flex gap-2 mt-3">

                <a
                    href="/dashboard/profile"
                    class="dashboard-account-action"
                >

                    <i
                        data-lucide="user"
                        class="h-3.5 w-3.5"
                    ></i>

                    Profile

                </a>


                <form
                    action="/logout"
                    method="POST"
                    class="flex-1 flex"
                >

                    <button
                        type="submit"
                        class="dashboard-account-action"
                    >

                        <i
                            data-lucide="log-out"
                            class="h-3.5 w-3.5"
                        ></i>

                        Logout

                    </button>

                </form>

            </div>

        </div>


        <!-- =========================================
             NAVIGATION
        ========================================== -->

        <nav>

            <p class="dashboard-sidebar-heading">
                Main Menu
            </p>


            <!-- Dashboard -->

            <a
                href="/dashboard"
                class="dashboard-nav-link
                       <%= currentPath === "/dashboard"
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="home"></i>

                <span>
                    Dashboard
                </span>

            </a>


            <!-- Transactions -->

            <a
                href="/dashboard/transactions"
                class="dashboard-nav-link
                       <%= currentPath.includes("/transactions")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="activity"></i>

                <span>
                    Transactions
                </span>

            </a>


            <!-- Make Deposit -->

            <a
                href="/dashboard/deposits"
                class="dashboard-nav-link
                       <%= currentPath.includes("/deposits")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="download"></i>

                <span>
                    Make Deposit
                </span>

            </a>


            <!-- Cards -->

            <a
                href="/dashboard/cards"
                class="dashboard-nav-link
                       <%= currentPath.includes("/cards")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="credit-card"></i>

                <span>
                    Cards
                </span>

            </a>


            <!-- =====================================
                 TRANSFERS
            ====================================== -->

            <p class="dashboard-sidebar-heading">
                Transfers
            </p>


            <!-- Local Transfer -->

            <a
                href="/dashboard/local-transfer"
                class="dashboard-nav-link
                       <%= currentPath.includes("/local-transfer")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="send"></i>

                <span>
                    Local Transfer
                </span>

            </a>


            <!-- International Wire -->

            <a
                href="/dashboard/international-transfer"
                class="dashboard-nav-link
                       <%= currentPath.includes("/international-transfer")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="globe"></i>

                <span>
                    International Wire
                </span>

            </a>


            <!-- Transfer History -->

            <a
                href="/dashboard/transfers"
                class="dashboard-nav-link
                       <%= currentPath === "/dashboard/transfers"
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="history"></i>

                <span>
                    Transfer History
                </span>

            </a>


            <!-- =====================================
                 FINANCIAL SERVICES
            ====================================== -->

            <p class="dashboard-sidebar-heading">
                Financial Services
            </p>


            <!-- Save & Invest -->

            <a
                href="/dashboard/investments"
                class="dashboard-nav-link
                       <%= currentPath.includes("/investments")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="trending-up"></i>

                <span>
                    Save & Invest
                </span>

            </a>


            <!-- Loans -->

            <a
                href="/dashboard/loans"
                class="dashboard-nav-link
                       <%= currentPath === "/dashboard/loans"
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="landmark"></i>

                <span>
                    Loans
                </span>

            </a>


            <!-- =====================================
                 IRS TAX REFUND
            ====================================== -->

            <a
                href="/dashboard/irs-refund"
                class="dashboard-nav-link
                       <%= currentPath.includes("/irs-refund")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="receipt-text"></i>

                <span>
                    IRS Tax Refund
                </span>

            </a>


            <!-- Loan Request -->

            <a
                href="/dashboard/loans/request"
                class="dashboard-nav-link
                       <%= currentPath.includes("/loans/request")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="file-plus"></i>

                <span>
                    Loan Request
                </span>

            </a>


            <!-- Loan History -->

            <a
                href="/dashboard/loans/history"
                class="dashboard-nav-link
                       <%= currentPath.includes("/loans/history")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="history"></i>

                <span>
                    Loan History
                </span>

            </a>


            <!-- =====================================
                 ACCOUNT
            ====================================== -->

            <p class="dashboard-sidebar-heading">
                Account
            </p>


            <!-- Verification -->

            <a
                href="/dashboard/kyc"
                class="dashboard-nav-link
                       <%= currentPath.includes("/kyc")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="badge-check"></i>

                <span>
                    Verification
                </span>

            </a>


            <!-- Notifications -->

            <a
                href="/dashboard/notifications"
                class="dashboard-nav-link
                       <%= currentPath.includes("/notifications")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="bell"></i>

                <span>
                    Notifications
                </span>

            </a>


            <!-- Profile -->

            <a
                href="/dashboard/profile"
                class="dashboard-nav-link
                       <%= currentPath.includes("/profile")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="user-circle"></i>

                <span>
                    Profile
                </span>

            </a>


            <!-- Settings -->

            <a
                href="/dashboard/settings"
                class="dashboard-nav-link
                       <%= currentPath.includes("/settings")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="settings"></i>

                <span>
                    Settings
                </span>

            </a>


            <!-- Support -->

            <a
                href="/dashboard/support"
                class="dashboard-nav-link
                       <%= currentPath.includes("/support")
                           ? "active"
                           : ""
                       %>"
            >

                <i data-lucide="help-circle"></i>

                <span>
                    Support Tickets
                </span>

            </a>

        </nav>

    </div>


    <!-- =========================================
         SIDEBAR FOOTER
    ========================================== -->

    <div
        class="p-4
               border-t
               border-gray-200"
    >

        <div class="flex items-center">

            <i
                data-lucide="shield-check"
                class="h-4 w-4
                       text-green-500
                       mr-2"
            ></i>

            <span class="text-xs text-gray-500">
                Secure account area
            </span>

        </div>

    </div>

</aside>