<%
    const investmentRecords =
        typeof investments !== "undefined" &&
        Array.isArray(investments)
            ? investments
            : [];
%>


<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
</head>


<body class="bg-gray-50">

    <%- include("partials/loader") %>


    <div
        x-data="{
            mobileMenuOpen: false,
            investmentFilter: 'all'
        }"
        class="dashboard-app-shell
               flex h-screen
               overflow-hidden"
    >

        <%- include("partials/sidebar") %>


        <div
            class="dashboard-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("partials/topbar") %>

            <%- include("partials/mobile-menu") %>


            <main class="dashboard-main-content">

                <div class="py-6">

                    <div
                        class="max-w-7xl
                               mx-auto
                               px-4
                               sm:px-6
                               md:px-8"
                    >

                        <!-- =================================
                             HEADER
                        ================================== -->

                        <div
                            class="flex
                                   flex-col
                                   sm:flex-row
                                   sm:items-center
                                   sm:justify-between
                                   gap-4
                                   mb-6"
                        >

                            <div>

                                <h1
                                    class="text-2xl
                                           font-bold
                                           text-gray-900"
                                >
                                    Investment History
                                </h1>


                                <p
                                    class="text-sm
                                           text-gray-500
                                           mt-1"
                                >
                                    Review your investment records.
                                </p>

                            </div>


                            <a
                                href="/dashboard/investments/request"
                                class="inline-flex
                                       items-center
                                       px-4 py-2.5
                                       bg-primary-600
                                       hover:bg-primary-700
                                       text-white
                                       text-sm
                                       font-medium
                                       rounded-lg"
                            >

                                <i
                                    data-lucide="plus"
                                    class="h-4 w-4 mr-2"
                                ></i>

                                Start Investment

                            </a>

                        </div>


                        <!-- =================================
                             FILTERS
                        ================================== -->

                        <div
                            class="dashboard-card
                                   p-4
                                   mb-6"
                        >

                            <div class="flex flex-wrap gap-2">

                                <button
                                    type="button"
                                    @click="
                                        investmentFilter =
                                            'all'
                                    "
                                    :class="
                                        investmentFilter ===
                                            'all'
                                            ? 'bg-primary-600 text-white'
                                            : 'bg-gray-100 text-gray-600'
                                    "
                                    class="px-4 py-2
                                           rounded-lg
                                           text-sm
                                           font-medium"
                                >
                                    All
                                </button>


                                <button
                                    type="button"
                                    @click="
                                        investmentFilter =
                                            'pending'
                                    "
                                    :class="
                                        investmentFilter ===
                                            'pending'
                                            ? 'bg-primary-600 text-white'
                                            : 'bg-gray-100 text-gray-600'
                                    "
                                    class="px-4 py-2
                                           rounded-lg
                                           text-sm
                                           font-medium"
                                >
                                    Pending
                                </button>


                                <button
                                    type="button"
                                    @click="
                                        investmentFilter =
                                            'approved'
                                    "
                                    :class="
                                        investmentFilter ===
                                            'approved'
                                            ? 'bg-primary-600 text-white'
                                            : 'bg-gray-100 text-gray-600'
                                    "
                                    class="px-4 py-2
                                           rounded-lg
                                           text-sm
                                           font-medium"
                                >
                                    Approved
                                </button>


                                <button
                                    type="button"
                                    @click="
                                        investmentFilter =
                                            'active'
                                    "
                                    :class="
                                        investmentFilter ===
                                            'active'
                                            ? 'bg-primary-600 text-white'
                                            : 'bg-gray-100 text-gray-600'
                                    "
                                    class="px-4 py-2
                                           rounded-lg
                                           text-sm
                                           font-medium"
                                >
                                    Active
                                </button>


                                <button
                                    type="button"
                                    @click="
                                        investmentFilter =
                                            'matured'
                                    "
                                    :class="
                                        investmentFilter ===
                                            'matured'
                                            ? 'bg-primary-600 text-white'
                                            : 'bg-gray-100 text-gray-600'
                                    "
                                    class="px-4 py-2
                                           rounded-lg
                                           text-sm
                                           font-medium"
                                >
                                    Matured
                                </button>


                                <button
                                    type="button"
                                    @click="
                                        investmentFilter =
                                            'closed'
                                    "
                                    :class="
                                        investmentFilter ===
                                            'closed'
                                            ? 'bg-primary-600 text-white'
                                            : 'bg-gray-100 text-gray-600'
                                    "
                                    class="px-4 py-2
                                           rounded-lg
                                           text-sm
                                           font-medium"
                                >
                                    Closed
                                </button>

                            </div>

                        </div>


                        <section class="dashboard-card">

                            <% if (
                                investmentRecords.length ===
                                0
                            ) { %>

                                <div
                                    class="py-14
                                           px-6
                                           text-center"
                                >

                                    <i
                                        data-lucide="trending-up"
                                        class="h-9 w-9
                                               mx-auto
                                               text-gray-400
                                               mb-3"
                                    ></i>


                                    <p
                                        class="text-sm
                                               font-medium
                                               text-gray-700"
                                    >
                                        No investment history yet
                                    </p>

                                </div>


                            <% } else { %>

                                <div class="overflow-x-auto">

                                    <table
                                        class="min-w-full
                                               divide-y
                                               divide-gray-200"
                                    >

                                        <thead class="bg-gray-50">

                                            <tr>

                                                <th class="dashboard-table-heading">
                                                    Reference
                                                </th>

                                                <th class="dashboard-table-heading">
                                                    Investment
                                                </th>

                                                <th class="dashboard-table-heading">
                                                    Principal
                                                </th>

                                                <th class="dashboard-table-heading">
                                                    Current Value
                                                </th>

                                                <th class="dashboard-table-heading">
                                                    Return
                                                </th>

                                                <th class="dashboard-table-heading">
                                                    Status
                                                </th>

                                                <th class="dashboard-table-heading">
                                                    Action
                                                </th>

                                            </tr>

                                        </thead>


                                        <tbody
                                            class="divide-y
                                                   divide-gray-100"
                                        >

                                            <% investmentRecords.forEach(
                                                function(investment) {

                                                    const investmentId =
                                                        investment.id ||
                                                        investment._id;
                                            %>

                                                <tr
                                                    x-show="
                                                        investmentFilter ===
                                                            'all' ||

                                                        (
                                                            investmentFilter ===
                                                                'pending' &&
                                                            (
                                                                '<%= investment.status || "" %>' === 'Pending' ||
                                                                '<%= investment.status || "" %>' === 'Under Review'
                                                            )
                                                        ) ||

                                                        (
                                                            investmentFilter ===
                                                                'approved' &&
                                                            '<%= investment.status || "" %>' === 'Approved'
                                                        ) ||

                                                        (
                                                            investmentFilter ===
                                                                'active' &&
                                                            '<%= investment.status || "" %>' === 'Active'
                                                        ) ||

                                                        (
                                                            investmentFilter ===
                                                                'matured' &&
                                                            '<%= investment.status || "" %>' === 'Matured'
                                                        ) ||

                                                        (
                                                            investmentFilter ===
                                                                'closed' &&
                                                            '<%= investment.status || "" %>' === 'Closed'
                                                        )
                                                    "
                                                >

                                                    <!-- Reference -->

                                                    <td class="dashboard-table-cell">

                                                        <%= investment.reference || "" %>

                                                    </td>


                                                    <!-- Investment -->

                                                    <td class="dashboard-table-cell">

                                                        <p
                                                            class="font-medium
                                                                   text-gray-800"
                                                        >
                                                            <%= investment.name ||
                                                                investment.type ||
                                                                ""
                                                            %>
                                                        </p>


                                                        <% if (
                                                            investment.type
                                                        ) { %>

                                                            <p
                                                                class="text-xs
                                                                       text-gray-400
                                                                       mt-1"
                                                            >
                                                                <%= investment.type %>
                                                            </p>

                                                        <% } %>

                                                    </td>


                                                    <!-- Principal -->

                                                    <td class="dashboard-table-cell">

                                                        <%= investment.currency || "" %>

                                                        <%= Number(
                                                            investment.principal ||
                                                            0
                                                        ).toLocaleString(
                                                            undefined,
                                                            {
                                                                minimumFractionDigits: 2,
                                                                maximumFractionDigits: 2
                                                            }
                                                        ) %>

                                                    </td>


                                                    <!-- Current -->

                                                    <td class="dashboard-table-cell">

                                                        <% if (
                                                            investment.currentValue !==
                                                                undefined &&
                                                            investment.currentValue !==
                                                                null
                                                        ) { %>

                                                            <%= investment.currency || "" %>

                                                            <%= Number(
                                                                investment.currentValue
                                                            ).toLocaleString(
                                                                undefined,
                                                                {
                                                                    minimumFractionDigits: 2,
                                                                    maximumFractionDigits: 2
                                                                }
                                                            ) %>

                                                        <% } %>

                                                    </td>


                                                    <!-- Return -->

                                                    <td class="dashboard-table-cell">

                                                        <% if (
                                                            investment.returnPercentage !==
                                                                undefined &&
                                                            investment.returnPercentage !==
                                                                null
                                                        ) { %>

                                                            <%= Number(
                                                                investment.returnPercentage
                                                            ).toFixed(2) %>%

                                                        <% } %>

                                                    </td>


                                                    <!-- Status -->

                                                    <td class="px-6 py-4">

                                                        <span
                                                            class="inline-flex
                                                                   px-2.5 py-1
                                                                   rounded-full
                                                                   text-xs
                                                                   font-medium
                                                                   <%= investment.status === "Active"
                                                                       ? "bg-green-100 text-green-700"
                                                                       : investment.status === "Approved"
                                                                       ? "bg-blue-100 text-blue-700"
                                                                       : investment.status === "Matured"
                                                                       ? "bg-purple-100 text-purple-700"
                                                                       : investment.status === "Rejected"
                                                                       ? "bg-red-100 text-red-700"
                                                                       : investment.status === "Cancelled"
                                                                       ? "bg-red-100 text-red-700"
                                                                       : "bg-yellow-100 text-yellow-700"
                                                                   %>"
                                                        >
                                                            <%= investment.status || "" %>
                                                        </span>

                                                    </td>


                                                    <!-- Action -->

                                                    <td class="dashboard-table-cell">

                                                        <a
                                                            href="/dashboard/investments/<%= investmentId %>"
                                                            class="text-primary-700
                                                                   font-medium"
                                                        >
                                                            Details
                                                        </a>

                                                    </td>

                                                </tr>

                                            <% }); %>

                                        </tbody>

                                    </table>

                                </div>

                            <% } %>

                        </section>

                    </div>

                </div>

            </main>


            <%- include("partials/footer") %>

        </div>

    </div>


    <%- include("partials/scripts") %>

</body>

</html>