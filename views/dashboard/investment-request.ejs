<%
    const oldForm =
        typeof formData !== "undefined" &&
        formData
            ? formData
            : {};

    const requestAccount =
        typeof account !== "undefined"
            ? account
            : null;
%>

<!DOCTYPE html>
<html lang="en">

<head>
    <%- include("partials/head") %>
</head>

<body class="bg-gray-50">

    <%- include("partials/loader") %>

    <div
        x-data='{
            mobileMenuOpen: false,

            step: 1,

            investmentType:
                <%- JSON.stringify(
                    oldForm.type || ""
                ) %>,

            principal:
                <%- JSON.stringify(
                    oldForm.principal || ""
                ) %>,

            duration:
                <%- JSON.stringify(
                    oldForm.duration || ""
                ) %>,

            description:
                <%- JSON.stringify(
                    oldForm.description || ""
                ) %>,

            nextStep() {
                if (
                    this.investmentType &&
                    Number(this.principal) > 0 &&
                    this.duration &&
                    this.description.trim()
                ) {
                    this.step = 2;
                }
            }
        }'
        class="dashboard-app-shell
               flex h-screen
               overflow-hidden"
    >

        <%- include("partials/sidebar") %>

        <div
            class="dashboard-main-column
                   flex flex-col
                   flex-1
                   overflow-hidden"
        >

            <%- include("partials/topbar") %>

            <%- include("partials/mobile-menu") %>

            <main class="dashboard-main-content">

                <div class="py-6">

                    <div
                        class="max-w-4xl
                               mx-auto
                               px-4
                               sm:px-6
                               md:px-8"
                    >

                        <!-- =================================
                             BACK
                        ================================== -->

                        <a
                            href="/dashboard/investments"
                            class="inline-flex
                                   items-center
                                   text-sm
                                   text-gray-500
                                   hover:text-gray-700
                                   mb-6"
                        >

                            <i
                                data-lucide="arrow-left"
                                class="h-4 w-4 mr-2"
                            ></i>

                            Back to Investments

                        </a>


                        <!-- =================================
                             HEADER
                        ================================== -->

                        <div class="mb-6">

                            <h1
                                class="text-2xl
                                       font-bold
                                       text-gray-900"
                            >
                                Start an Investment
                            </h1>

                            <p
                                class="text-sm
                                       text-gray-500
                                       mt-1"
                            >
                                Submit an investment request
                                for administrator review.
                            </p>

                        </div>


                        <!-- =================================
                             SUCCESS
                        ================================== -->

                        <% if (
                            typeof submitted !== "undefined" &&
                            submitted
                        ) { %>

                            <div
                                class="mb-6
                                       px-4 py-4
                                       bg-green-50
                                       border
                                       border-green-200
                                       rounded-xl"
                            >

                                <div class="flex items-start">

                                    <i
                                        data-lucide="circle-check"
                                        class="h-5 w-5
                                               text-green-600
                                               mr-3
                                               mt-0.5"
                                    ></i>

                                    <div>

                                        <p
                                            class="text-sm
                                                   font-semibold
                                                   text-green-800"
                                        >
                                            Investment request submitted
                                        </p>

                                        <p
                                            class="text-sm
                                                   text-green-700
                                                   mt-1"
                                        >
                                            Reference:
                                            <%= investmentReference || "" %>
                                        </p>

                                    </div>

                                </div>

                            </div>

                        <% } %>


                        <!-- =================================
                             ERROR
                        ================================== -->

                        <% if (
                            typeof error !== "undefined" &&
                            error
                        ) { %>

                            <div
                                class="mb-6
                                       px-4 py-4
                                       bg-red-50
                                       border
                                       border-red-200
                                       rounded-xl"
                            >

                                <div class="flex items-start">

                                    <i
                                        data-lucide="circle-alert"
                                        class="h-5 w-5
                                               text-red-600
                                               mr-3
                                               mt-0.5"
                                    ></i>

                                    <p
                                        class="text-sm
                                               text-red-800"
                                    >
                                        <%= error %>
                                    </p>

                                </div>

                            </div>

                        <% } %>


                        <!-- =================================
                             ACCOUNT
                        ================================== -->

                        <% if (requestAccount) { %>

                            <div
                                class="dashboard-card
                                       p-5
                                       mb-6"
                            >

                                <p
                                    class="text-xs
                                           text-gray-500"
                                >
                                    Investment Account
                                </p>

                                <div
                                    class="flex
                                           flex-wrap
                                           items-center
                                           justify-between
                                           gap-4
                                           mt-2"
                                >

                                    <div>

                                        <p
                                            class="text-sm
                                                   font-medium
                                                   text-gray-900"
                                        >
                                            <%= requestAccount.accountType || "" %>
                                        </p>

                                        <p
                                            class="text-xs
                                                   text-gray-500
                                                   mt-1"
                                        >
                                            <%= requestAccount.accountNumber || "" %>
                                        </p>

                                    </div>

                                    <span
                                        class="inline-flex
                                               px-3 py-1.5
                                               rounded-full
                                               bg-gray-100
                                               text-xs
                                               font-medium
                                               text-gray-700"
                                    >
                                        <%= requestAccount.currency || "" %>
                                    </span>

                                </div>

                            </div>

                        <% } %>


                        <!-- =================================
                             INVESTMENT FORM
                        ================================== -->

                        <section class="dashboard-card">

                            <form
                                action="/dashboard/investments/request"
                                method="POST"
                            >

                                <!-- =================================
                                     STEP 1
                                ================================== -->

                                <div
                                    x-show="step === 1"
                                    class="p-6"
                                >

                                    <div
                                        class="grid
                                               grid-cols-1
                                               md:grid-cols-2
                                               gap-5"
                                    >

                                        <!-- Investment Type -->

                                        <div>

                                            <label
                                                for="investmentType"
                                                class="dashboard-form-label"
                                            >
                                                Investment Type
                                            </label>

                                            <select
                                                id="investmentType"
                                                name="type"
                                                x-model="investmentType"
                                                class="dashboard-form-input"
                                                required
                                            >

                                                <option value="">
                                                    Select investment type
                                                </option>

                                                <option value="Fixed Investment">
                                                    Fixed Investment
                                                </option>

                                                <option value="Savings Investment">
                                                    Savings Investment
                                                </option>

                                                <option value="Growth Fund">
                                                    Growth Fund
                                                </option>

                                                <option value="Business Investment">
                                                    Business Investment
                                                </option>

                                                <option value="Retirement Investment">
                                                    Retirement Investment
                                                </option>

                                                <option value="Custom Investment">
                                                    Custom Investment
                                                </option>

                                            </select>

                                        </div>


                                        <!-- Principal -->

                                        <div>

                                            <label
                                                for="principal"
                                                class="dashboard-form-label"
                                            >
                                                Investment Amount
                                            </label>

                                            <input
                                                id="principal"
                                                type="number"
                                                name="principal"
                                                min="0.01"
                                                step="0.01"
                                                x-model="principal"
                                                class="dashboard-form-input"
                                                required
                                            >

                                        </div>


                                        <!-- Duration -->

                                        <div>

                                            <label
                                                for="investmentDuration"
                                                class="dashboard-form-label"
                                            >
                                                Duration
                                            </label>

                                            <select
                                                id="investmentDuration"
                                                name="duration"
                                                x-model="duration"
                                                class="dashboard-form-input"
                                                required
                                            >

                                                <option value="">
                                                    Select duration
                                                </option>

                                                <option value="3 Months">
                                                    3 Months
                                                </option>

                                                <option value="6 Months">
                                                    6 Months
                                                </option>

                                                <option value="12 Months">
                                                    12 Months
                                                </option>

                                                <option value="24 Months">
                                                    24 Months
                                                </option>

                                                <option value="36 Months">
                                                    36 Months
                                                </option>

                                                <option value="60 Months">
                                                    60 Months
                                                </option>

                                            </select>

                                        </div>


                                        <!-- Currency -->

                                        <div>

                                            <label
                                                class="dashboard-form-label"
                                            >
                                                Currency
                                            </label>

                                            <input
                                                type="text"
                                                value="<%= requestAccount
                                                    ? requestAccount.currency
                                                    : ""
                                                %>"
                                                class="dashboard-form-input
                                                       bg-gray-50"
                                                readonly
                                            >

                                        </div>


                                        <!-- Goal -->

                                        <div class="md:col-span-2">

                                            <label
                                                for="investmentDescription"
                                                class="dashboard-form-label"
                                            >
                                                Investment Goal
                                            </label>

                                            <textarea
                                                id="investmentDescription"
                                                name="description"
                                                rows="5"
                                                x-model="description"
                                                class="dashboard-form-input
                                                       resize-none"
                                                placeholder="Describe your investment goal"
                                                required
                                            ></textarea>

                                        </div>

                                    </div>


                                    <!-- Step 1 Action -->

                                    <div
                                        class="flex
                                               justify-end
                                               mt-7"
                                    >

                                        <button
                                            type="button"
                                            @click="nextStep()"
                                            class="inline-flex
                                                   items-center
                                                   px-6 py-3
                                                   bg-primary-600
                                                   hover:bg-primary-700
                                                   text-white
                                                   font-medium
                                                   rounded-lg"
                                        >

                                            Review Request

                                            <i
                                                data-lucide="arrow-right"
                                                class="h-4 w-4 ml-2"
                                            ></i>

                                        </button>

                                    </div>

                                </div>


                                <!-- =================================
                                     STEP 2
                                ================================== -->

                                <div
                                    x-show="step === 2"
                                    x-cloak
                                    class="p-6"
                                >

                                    <h2
                                        class="text-lg
                                               font-semibold
                                               text-gray-900"
                                    >
                                        Review Investment Request
                                    </h2>

                                    <p
                                        class="text-sm
                                               text-gray-500
                                               mt-1
                                               mb-6"
                                    >
                                        Confirm the details before
                                        submitting your request.
                                    </p>


                                    <!-- Review -->

                                    <div
                                        class="divide-y
                                               divide-gray-100
                                               border
                                               border-gray-100
                                               rounded-xl"
                                    >

                                        <div class="transfer-review-row">

                                            <span>
                                                Investment Type
                                            </span>

                                            <strong
                                                x-text="investmentType"
                                            ></strong>

                                        </div>


                                        <div class="transfer-review-row">

                                            <span>
                                                Amount
                                            </span>

                                            <strong>

                                                <%= requestAccount
                                                    ? requestAccount.currency
                                                    : ""
                                                %>

                                                <span
                                                    x-text="principal"
                                                ></span>

                                            </strong>

                                        </div>


                                        <div class="transfer-review-row">

                                            <span>
                                                Duration
                                            </span>

                                            <strong
                                                x-text="duration"
                                            ></strong>

                                        </div>


                                        <div class="transfer-review-row">

                                            <span>
                                                Goal
                                            </span>

                                            <strong
                                                x-text="description"
                                                class="text-right
                                                       max-w-sm"
                                            ></strong>

                                        </div>

                                    </div>


                                    <!-- Funding Notice -->

                                    <div
                                        class="mt-6
                                               p-4
                                               bg-blue-50
                                               border
                                               border-blue-100
                                               rounded-lg"
                                    >

                                        <div class="flex items-start">

                                            <i
                                                data-lucide="info"
                                                class="h-5 w-5
                                                       text-blue-600
                                                       mr-3
                                                       mt-0.5"
                                            ></i>

                                            <p
                                                class="text-sm
                                                       text-blue-800"
                                            >
                                                Your balance is not deducted
                                                when the request is submitted.
                                                Funds are deducted only after
                                                administrator approval and
                                                activation.
                                            </p>

                                        </div>

                                    </div>


                                    <!-- Actions -->

                                    <div
                                        class="flex
                                               justify-between
                                               gap-3
                                               mt-7"
                                    >

                                        <button
                                            type="button"
                                            @click="step = 1"
                                            class="inline-flex
                                                   items-center
                                                   px-5 py-3
                                                   border
                                                   border-gray-200
                                                   bg-white
                                                   text-gray-700
                                                   rounded-lg"
                                        >

                                            <i
                                                data-lucide="arrow-left"
                                                class="h-4 w-4 mr-2"
                                            ></i>

                                            Edit

                                        </button>


                                        <button
                                            type="submit"
                                            class="inline-flex
                                                   items-center
                                                   px-6 py-3
                                                   bg-primary-600
                                                   hover:bg-primary-700
                                                   text-white
                                                   font-medium
                                                   rounded-lg"
                                        >

                                            Submit Request

                                            <i
                                                data-lucide="send"
                                                class="h-4 w-4 ml-2"
                                            ></i>

                                        </button>

                                    </div>

                                </div>

                            </form>

                        </section>

                    </div>

                </div>

            </main>

            <%- include("partials/footer") %>

        </div>

    </div>

    <%- include("partials/scripts") %>

</body>

</html>